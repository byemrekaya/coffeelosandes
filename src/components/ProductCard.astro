---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<a
  href={`/products/${product.slug}`}
  class="group flex h-full flex-col overflow-hidden rounded-3xl border border-cream/5 bg-espresso/40 shadow-soft-gold/40 transition hover:-translate-y-1 hover:border-cream/20 hover:shadow-soft-gold"
>
  <div class="relative aspect-[4/3] overflow-hidden">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_10%_0,rgba(245,233,216,0.18),transparent_55%),radial-gradient(circle_at_90%_100%,rgba(192,138,77,0.5),transparent_60%)] transition duration-700 group-hover:scale-105"
    />
    <div class="absolute inset-0 grain-overlay" />
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black via-black/40 to-transparent" />
    <div class="absolute inset-5 flex flex-col justify-between">
      <div>
        <p class="stage-eyebrow">Venezüella · {product.roast.toUpperCase()}</p>
        <h3 class="font-display text-lg text-cream">{product.name}</h3>
      </div>
      <p class="text-[11px] text-cream/65">
        {product.origin}
      </p>
    </div>
  </div>

  <div class="flex flex-1 flex-col justify-between gap-4 px-5 py-4 text-[12px] text-cream/70">
    <p>{product.shortDescription}</p>
    <div class="flex flex-wrap gap-2">
      {product.tastingNotes.slice(0, 3).map((note) => (
        <span class="rounded-full border border-cream/10 bg-black/40 px-3 py-1 text-[10px] uppercase tracking-[0.16em]">
          {note}
        </span>
      ))}
    </div>
  </div>
</a>

