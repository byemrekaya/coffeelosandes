---
/**
 * Emoji bayrakları Windows’ta sık sık harf olarak görünür; SVG her yerde tutarlıdır.
 */
import type { Locale } from '../i18n/types';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = '' } = Astro.props;
---

<svg
  class:list={['shrink-0 overflow-hidden rounded-[2px] border border-black/12 shadow-sm', className]}
  viewBox="0 0 36 24"
  width="18"
  height="12"
  aria-hidden="true"
>
  {locale === 'tr' && (
    <>
      <rect width="36" height="24" fill="#E30A17" />
      <circle cx="14" cy="12" r="5.5" fill="#fff" />
      <circle cx="15.2" cy="12" r="4.4" fill="#E30A17" />
    </>
  )}
  {locale === 'de' && (
    <>
      <rect width="36" height="8" y="0" fill="#000" />
      <rect width="36" height="8" y="8" fill="#DD0000" />
      <rect width="36" height="8" y="16" fill="#FFCE00" />
    </>
  )}
  {locale === 'en' && (
    <>
      <rect width="36" height="24" fill="#012169" />
      <path d="M0 0 L36 24 M36 0 L0 24" stroke="#fff" stroke-width="5" />
      <path d="M0 0 L36 24 M36 0 L0 24" stroke="#C8102E" stroke-width="2.5" />
      <path d="M18 0 V24 M0 12 H36" stroke="#fff" stroke-width="8" />
      <path d="M18 0 V24 M0 12 H36" stroke="#C8102E" stroke-width="4" />
    </>
  )}
  {locale === 'fr' && (
    <>
      <rect width="12" height="24" x="0" fill="#002395" />
      <rect width="12" height="24" x="12" fill="#fff" />
      <rect width="12" height="24" x="24" fill="#ED2939" />
    </>
  )}
  {locale === 'es' && (
    <>
      <rect width="36" height="6" y="0" fill="#AA151B" />
      <rect width="36" height="12" y="6" fill="#F1BF00" />
      <rect width="36" height="6" y="18" fill="#AA151B" />
    </>
  )}
  {locale === 'nl' && (
    <>
      <rect width="36" height="8" y="0" fill="#AE1C28" />
      <rect width="36" height="8" y="8" fill="#fff" />
      <rect width="36" height="8" y="16" fill="#21468B" />
    </>
  )}
  {locale === 'pl' && (
    <>
      <rect width="36" height="12" y="0" fill="#fff" />
      <rect width="36" height="12" y="12" fill="#DC143C" />
    </>
  )}
  {locale === 'cs' && (
    <>
      <path d="M0 0 L14 12 L0 24 Z" fill="#11457E" />
      <rect width="22" height="12" x="14" y="0" fill="#fff" />
      <rect width="22" height="12" x="14" y="12" fill="#D7141A" />
    </>
  )}
  {locale === 'it' && (
    <>
      <rect width="12" height="24" x="0" fill="#009246" />
      <rect width="12" height="24" x="12" fill="#fff" />
      <rect width="12" height="24" x="24" fill="#CE2B37" />
    </>
  )}
  {locale === 'ru' && (
    <>
      <rect width="36" height="8" y="0" fill="#fff" />
      <rect width="36" height="8" y="8" fill="#0039A6" />
      <rect width="36" height="8" y="16" fill="#D52B1E" />
    </>
  )}
  {locale === 'ar' && (
    <>
      {/* Saudi Arabia: green field, white shahada text lines + sword */}
      <rect width="36" height="24" fill="#006C35" />
      {/* Stylised shahada text (two abstract white lines) */}
      <rect x="5" y="5.5" width="26" height="1.8" rx="0.8" fill="#fff" />
      <rect x="7" y="8.2" width="9"  height="1.1" rx="0.5" fill="#fff" />
      <rect x="20" y="8.2" width="9" height="1.1" rx="0.5" fill="#fff" />
      {/* Sword blade pointing left */}
      <path d="M31 11.2 L10 11.2 L10 12.8 L31 12.8 L33.5 12 Z" fill="#fff" />
      {/* Guard */}
      <rect x="8.5" y="9.8" width="1.8" height="4.4" rx="0.6" fill="#fff" />
      {/* Grip */}
      <rect x="4"   y="11.2" width="4.5" height="1.6" rx="0.5" fill="#fff" />
    </>
  )}
</svg>
