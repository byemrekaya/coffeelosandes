---
import { site, mailtoB2B } from '../config/site';
import type { Locale } from '../i18n/types';
import { t } from '../i18n/t';
import { withLang, homeSection } from '../i18n/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const footerNav: { hash: string; key: string }[] = [
  { hash: 'hero', key: 'nav.home' },
  { hash: 'hikayemiz', key: 'nav.story' },
  { hash: 'kahvelerimiz', key: 'nav.coffees' },
  { hash: 'kalite', key: 'nav.qualityDocs' },
  { hash: 'toptan', key: 'nav.wholesale' },
  { hash: 'iletisim', key: 'nav.contact' },
];

const linkClass = 'text-ink/75 transition hover:text-ink';
---

<footer class="mt-24 border-t border-line bg-paper-deep py-16 text-sm text-ink">
  <div class="section-shell flex flex-col gap-12 md:flex-row md:items-start md:justify-between">
    <div class="max-w-xs space-y-4">
      <div class="flex items-center gap-3">
        <div class="h-9 w-9 shrink-0 bg-ink" aria-hidden="true" />
        <span class="text-xs font-bold uppercase tracking-brand text-ink">{site.name}</span>
      </div>
      <p class="text-[14px] leading-relaxed text-ink-muted">
        {t(locale, 'footer.tagline')}
      </p>
    </div>

    <div class="grid grid-cols-2 gap-10 md:grid-cols-3 md:gap-16">
      <div class="space-y-4">
        <h3 class="text-[11px] font-semibold uppercase tracking-[0.22em] text-gold">{t(locale, 'footer.links')}</h3>
        <ul class="space-y-2.5">
          {footerNav.map((item) => (
            <li>
              <a href={homeSection(locale, item.hash)} class={linkClass}>
                {t(locale, item.key)}
              </a>
            </li>
          ))}
          <li>
            <a href={withLang('/products', locale)} class={linkClass}>
              {t(locale, 'footer.linkFullCatalog')}
            </a>
          </li>
          <li>
            <a href={withLang('/quality', locale)} class={linkClass}>
              {t(locale, 'footer.linkQualityDetail')}
            </a>
          </li>
          <li>
            <a href={withLang('/about', locale)} class={linkClass}>
              {t(locale, 'footer.linkAbout')}
            </a>
          </li>
        </ul>
      </div>

      <div class="space-y-4">
        <h3 class="text-[11px] font-semibold uppercase tracking-[0.22em] text-gold">{t(locale, 'footer.partnerships')}</h3>
        <ul class="space-y-2.5 text-ink/75">
          <li>{t(locale, 'footer.fp1')}</li>
          <li>{t(locale, 'footer.fp2')}</li>
          <li>{t(locale, 'footer.fp3')}</li>
        </ul>
      </div>

      <div class="space-y-4">
        <h3 class="text-[11px] font-semibold uppercase tracking-[0.22em] text-gold">{t(locale, 'footer.contact')}</h3>
        <ul class="space-y-2.5 text-ink/75">
          <li>
            <a href={mailtoB2B} class="transition hover:text-ink">{site.contactEmail}</a>
          </li>
          <li>{t(locale, 'footer.office')}</li>
          <li class="text-[12px] text-ink/55">{t(locale, 'footer.formHint')}</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="mt-12 border-t border-line bg-ink py-6">
    <div class="section-shell flex flex-col justify-between gap-3 text-[12px] text-white/60 md:flex-row md:items-center">
      <p>© {new Date().getFullYear()} {site.name}. {t(locale, 'footer.copyright')}</p>
      <p>{t(locale, 'footer.line2')}</p>
    </div>
  </div>
</footer>
