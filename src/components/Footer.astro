---
import { Image } from 'astro:assets';
import { site, mailtoB2B } from '../config/site';
import type { Locale } from '../i18n/types';
import { t } from '../i18n/t';
import { withLang, homeSection } from '../i18n/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

type FooterNavItem =
  | { kind: 'section'; hash: string; key: string }
  | { kind: 'page'; path: string; key: string };

const footerNav: FooterNavItem[] = [
  { kind: 'section', hash: 'hero', key: 'nav.home' },
  { kind: 'page', path: '/about', key: 'nav.about' },
  { kind: 'section', hash: 'kahvelerimiz', key: 'nav.coffees' },
  { kind: 'section', hash: 'kalite', key: 'nav.qualityDocs' },
  { kind: 'page', path: '/contact', key: 'nav.contact' },
];

const linkClass =
  'relative inline-block text-ink/78 transition-colors duration-200 hover:text-ink after:absolute after:-bottom-0.5 after:left-0 after:h-px after:w-0 after:bg-heading after:transition-all after:duration-200 hover:after:w-full';

/** Sütun: grid hücresinde dikey ortalama + mobilde merkez; md+ hizalı okuma */
const footerColClass =
  'flex min-h-0 w-full flex-col items-center justify-center gap-6 self-stretch text-center md:items-start md:justify-start md:text-left';
---

<footer class="relative border-t border-line bg-paper-deep py-16 text-[15px] text-ink">
  <div class="section-shell relative">
    <div class="grid grid-cols-1 items-stretch gap-10 md:grid-cols-3 md:gap-14">
      <div
        class:list={[footerColClass, 'transition-all duration-700 ease-out will-change-transform']}
        data-footer-reveal
      >
        <div class="flex flex-wrap items-center justify-center gap-3 md:justify-start">
          <Image src="/coffeelosandes-logo-green.svg" alt="" width={216} height={56} class="h-14 w-auto shrink-0 object-contain" loading="lazy" />
          <span class="min-w-0 text-[12px] font-semibold uppercase leading-snug tracking-[0.14em] text-heading">
            {site.legalEntityName}
          </span>
        </div>
        <p class="max-w-sm text-balance text-[16px] leading-relaxed text-ink/88">{t(locale, 'footer.brandHeadline')}</p>
        <p class="max-w-sm text-balance text-[15px] leading-relaxed text-ink/70">{t(locale, 'footer.brandBody')}</p>
      </div>

      <div
        class:list={[footerColClass, 'transition-all duration-700 ease-out will-change-transform']}
        data-footer-reveal
      >
        <h3 class="w-full text-[11px] font-semibold uppercase tracking-[0.22em] text-heading">{t(locale, 'footer.links')}</h3>
        <ul class="flex w-full flex-col items-center gap-2.5 text-[15px] md:items-start">
          {footerNav.map((item) => (
            <li>
              <a
                href={item.kind === 'section' ? homeSection(locale, item.hash) : withLang(item.path, locale)}
                class={linkClass}
              >
                {t(locale, item.key)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div
        class:list={[footerColClass, 'gap-8', 'transition-all duration-700 ease-out will-change-transform']}
        data-footer-reveal
      >
        <div class="flex w-full flex-col items-center md:items-start">
          <h3 class="text-[11px] font-semibold uppercase tracking-[0.22em] text-heading">{t(locale, 'footer.contact')}</h3>
          <ul class="mt-3 flex w-full flex-col items-center gap-2.5 text-[15px] text-ink/78 md:items-start">
            <li>
              <a href={mailtoB2B} class={linkClass}>{site.contactEmail}</a>
            </li>
            <li>{t(locale, 'footer.office')}</li>
          </ul>
        </div>
        <div class="flex w-full flex-col items-center md:items-start">
          <h3 class="text-[11px] font-semibold uppercase tracking-[0.22em] text-heading">{t(locale, 'footer.legal')}</h3>
          <ul class="mt-3 flex w-full flex-col items-center gap-2.5 text-[15px] text-ink/78 md:items-start">
            <li>
              <a href={withLang('/impressum', locale)} class={linkClass}>
                {t(locale, 'footer.linkImpressum')}
              </a>
            </li>
            <li>
              <a href={withLang('/privacy', locale)} class={linkClass}>
                {t(locale, 'footer.linkPrivacy')}
              </a>
            </li>
            <li>
              <button type="button" class={linkClass} data-cookie-open>
                {t(locale, 'footer.cookieSettings')}
              </button>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-line pt-6 transition-all duration-700 ease-out will-change-transform" data-footer-reveal>
      <div class="flex flex-col justify-between gap-2 text-[13px] text-ink/62 md:flex-row md:items-center">
        <p>© {new Date().getFullYear()} {site.name} — {t(locale, 'footer.bottomLeft')}</p>
        <p>{t(locale, 'footer.bottomRight')}</p>
      </div>
    </div>
  </div>
</footer>

<script>
  function initFooterReveal() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-footer-reveal]'));
    if (!items.length) return;

    items.forEach((el) => {
      el.classList.add('opacity-0', 'translate-y-6');
    });

    const obs = new IntersectionObserver(
      (entries) => {
        const visible = entries.some((entry) => entry.isIntersecting);
        if (!visible) return;

        items.forEach((el, index) => {
          window.setTimeout(() => {
            el.classList.remove('opacity-0', 'translate-y-6');
          }, index * 85);
        });
        obs.disconnect();
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );

    obs.observe(items[0]);
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initFooterReveal)
    : initFooterReveal();
</script>
