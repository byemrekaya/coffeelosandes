---
import HeroMotionIsland from './HeroMotionIsland.astro';
import PlantationScene from './PlantationScene.astro';
---

<HeroMotionIsland>
  <section class="hero-plantation relative min-h-screen overflow-hidden">
    <!-- Fullscreen tarla sahnesi -->
    <div class="plantation-bg absolute inset-0" data-hero-scene>
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-black" />
      <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-transparent to-black/40" />
      <PlantationScene />
    </div>

    <!-- İçerik overlay -->
    <div class="section-shell relative z-10 flex min-h-screen flex-col justify-center pt-24 pb-16">
      <div class="max-w-3xl xl:max-w-4xl">
        <p class="stage-eyebrow" data-hero-eyebrow>Venezüella · B2B Kahve</p>
        <h1 data-hero-headline class="font-display text-4xl md:text-5xl lg:text-6xl xl:text-7xl tracking-tight text-cream">
          And Dağlarından
          <span class="block text-terracotta">kurumsal kahve sahnenize.</span>
        </h1>
        <p data-hero-subtitle class="mt-6 max-w-2xl text-base md:text-lg xl:text-xl text-cream/80 leading-relaxed">
          Coffee Los Andes, Venezüella menşeini; plantasyondan kavurma mimarisine, lojistikten paketlemeye kadar uçtan uca
          kurgulanmış bir B2B kahve yolculuğuna dönüştürür.
        </p>

        <div class="mt-8 flex flex-wrap gap-4" data-hero-ctas>
          <a href="#journey" class="btn-primary" data-hero-cta>
            Yolculuğu Keşfet
          </a>
          <a href="/products" class="btn-secondary" data-hero-cta>
            Kahve Portföyü
          </a>
          <a href="/contact" class="btn-secondary" data-hero-cta>
            Ortağınız Olun
          </a>
        </div>

        <div class="mt-10 flex flex-wrap gap-8 text-xs text-cream/60">
          <div>
            <span class="block font-semibold text-cream/80">Plantasyondan fincana</span>
            <span>İzlenebilir tedarik zinciri</span>
          </div>
          <div>
            <span class="block font-semibold text-cream/80">B2B odaklı kavurma</span>
            <span>Hacim için tasarlanmış profiller</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll ipucu -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2" data-hero-scroll-hint>
      <a href="#coffee-journey-animation" class="flex flex-col items-center gap-2 text-cream/50 transition hover:text-cream/80">
        <span class="text-[10px] uppercase tracking-[0.3em]">Keşfet</span>
        <span class="scroll-chevron block h-6 w-6 rounded-full border border-current" aria-hidden="true" />
      </a>
    </div>
  </section>
</HeroMotionIsland>
