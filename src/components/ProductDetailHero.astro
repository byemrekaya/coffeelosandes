---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<section class="pt-28">
  <div class="section-shell grid gap-12 md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] md:items-center">
    <div class="space-y-5">
      <p class="stage-eyebrow">Venezüella · {product.roast.toUpperCase()}</p>
      <h1 class="font-display text-3xl md:text-4xl lg:text-5xl tracking-tight text-cream">
        {product.name}
      </h1>
      <p class="stage-subtitle max-w-xl">
        {product.shortDescription}
      </p>

      <dl class="mt-6 grid gap-4 text-[13px] text-cream/75 md:grid-cols-2">
        <div>
          <dt class="font-semibold text-cream/80">Menşei</dt>
          <dd>{product.origin}</dd>
        </div>
        <div>
          <dt class="font-semibold text-cream/80">Rakım</dt>
          <dd>{product.elevation}</dd>
        </div>
        <div>
          <dt class="font-semibold text-cream/80">İşleme</dt>
          <dd>{product.process}</dd>
        </div>
        <div>
          <dt class="font-semibold text-cream/80">Paketleme</dt>
          <dd>{product.packaging}</dd>
        </div>
      </dl>
    </div>

    <div class="relative">
      <div class="glass-panel texture-overlay relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-espresso/80 via-transparent to-black/90" aria-hidden="true" />
        <div class="relative aspect-[4/5] w-full overflow-hidden">
          <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_15%_0,rgba(245,233,216,0.18),transparent_55%),radial-gradient(circle_at_85%_100%,rgba(192,138,77,0.55),transparent_60%)]"
          />
          <div class="absolute inset-0 grain-overlay" />
          <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black via-black/40 to-transparent" />

          <div class="absolute inset-6 flex flex-col justify-between">
            <div>
              <p class="stage-eyebrow">Tadım Notları</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {product.tastingNotes.map((note) => (
                  <span class="rounded-full border border-cream/10 bg-black/40 px-3 py-1 text-[10px] uppercase tracking-[0.18em]">
                    {note}
                  </span>
                ))}
              </div>
            </div>

            <div class="flex items-end justify-between text-[11px] text-cream/60">
              <p>{product.b2bFit}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

