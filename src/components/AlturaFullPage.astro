---
import type { Locale } from '../i18n/types';
import { t } from '../i18n/t';
import { withLang } from '../i18n/paths';
import { site } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const farmToRoasteryFlow = [
  {
    title: t(locale, 'home.flowStep1Title'),
    body: t(locale, 'home.flowStep1Body'),
    icon: 'harvest',
  },
  {
    title: t(locale, 'home.flowStep2Title'),
    body: t(locale, 'home.flowStep2Body'),
    icon: 'shipment',
  },
  {
    title: t(locale, 'home.flowStep3Title'),
    body: t(locale, 'home.flowStep3Body'),
    icon: 'storage',
  },
  {
    title: t(locale, 'home.flowStep4Title'),
    body: t(locale, 'home.flowStep4Body'),
    icon: 'roastery',
  },
] as const;
---

<section id="hero" class="relative min-h-screen overflow-hidden scroll-mt-0">
  <!-- Full-screen video background -->
  <div class="absolute inset-0" data-hero-scene>
    <video
      data-hero-video
      class="h-full w-full object-cover object-center"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-label="Coffee Los Andes banner video"
    >
      <source src="/bannervideo.mp4" type="video/mp4" />
    </video>

    <!-- Cinematic okunabilirlik overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/35 to-black/75"
      aria-hidden="true"
    ></div>
    <!-- Marka yeşili hafif aksan -->
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_30%_50%,rgba(40,96,63,0.14),transparent_65%)]"
      aria-hidden="true"
    ></div>
  </div>

  <!-- İçerik katmanı -->
  <div class="relative z-10 flex min-h-screen items-center justify-center">
    <div class="w-full px-6 pb-24 pt-32 text-center md:px-10 lg:px-16 xl:px-20">
      <div class="mx-auto max-w-4xl">
        <div data-hero-logo>
          <img
            src="/navbarlogo.svg"
            alt="Coffee Los Andes"
            width="360"
            height="92"
            class="mx-auto h-16 w-auto max-w-[min(100%,360px)] object-contain drop-shadow-[0_6px_28px_rgba(0,0,0,0.42)] md:h-[10rem]"
            loading="eager"
            decoding="async"
          />
          <p class="mt-4 text-[18px] font-semibold uppercase tracking-[0.14em] text-white/75">
            {site.legalEntityName}
          </p>
        </div>

        <h1
          data-hero-headline
          class="mt-16 font-display text-[clamp(2.05rem,5.3vw,4.2rem)] font-semibold leading-[1.1] tracking-[-0.02em] text-white drop-shadow-[0_3px_18px_rgba(0,0,0,0.62)] md:mt-20"
        >
          {t(locale, 'home.slogan')}
        </h1>

        <div class="mt-10" data-hero-cta>
          <a
            href={withLang('/products', locale)}
            class="inline-flex items-center justify-center rounded-full border border-white/55 bg-white/10 px-7 py-3 text-[12px] font-semibold uppercase tracking-[0.14em] text-white backdrop-blur-sm transition-all duration-200 hover:bg-white/20 hover:border-white/80"
          >
            {t(locale, 'home.coffeesCtaAll')}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="border-t border-white/10 bg-[#0f0f0f]">
  <div class="mx-auto max-w-6xl px-6 py-16 text-center md:py-20">
    <h2 class="font-display text-[clamp(1.8rem,3.2vw,2.5rem)] font-semibold tracking-header text-white">
      {t(locale, 'home.flowTitle')}
    </h2>

    <div class="relative mt-12 grid grid-cols-1 gap-10 md:grid-cols-4" data-flow-root>
      <div class="pointer-events-none absolute left-0 right-0 top-7 hidden h-px bg-white/10 md:block" aria-hidden="true"></div>

      {farmToRoasteryFlow.map((step, idx) => (
        <article class="relative transition-all duration-300 hover:scale-[1.02] hover:opacity-100" data-flow-step data-step-index={idx}>
          <div class="mb-4 flex justify-center">
            <span
              class="inline-flex h-14 w-14 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white transition-all duration-300"
              data-flow-icon
            >
              {step.icon === 'harvest' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                  <path d="M7 21v-7a5 5 0 0 1 10 0v7" stroke-linecap="round" />
                  <circle cx="12" cy="7" r="3" />
                </svg>
              )}
              {step.icon === 'shipment' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                  <path d="M3 7h12v9H3zM15 10h3l3 3v3h-6z" stroke-linejoin="round" />
                  <circle cx="8" cy="18" r="1.5" />
                  <circle cx="18" cy="18" r="1.5" />
                </svg>
              )}
              {step.icon === 'storage' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                  <path d="M3 10 12 4l9 6v10H3z" />
                  <path d="M9 20v-5h6v5" />
                </svg>
              )}
              {step.icon === 'roastery' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                  <path d="M7 14a5 5 0 0 0 10 0V9H7z" />
                  <path d="M17 11h1a2 2 0 1 1 0 4h-1" />
                  <path d="M12 4c2 1.2 2 2.6.6 4M9 5.4c1.6 1 1.6 2.2.5 3.3" stroke-linecap="round" />
                </svg>
              )}
            </span>
          </div>

          <h3 class="text-[1rem] font-semibold text-white transition-all duration-300" data-flow-title>{step.title}</h3>
          <p class="mx-auto mt-2 max-w-[24ch] text-sm leading-relaxed text-white/60 transition-all duration-300" data-flow-body>{step.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initHomeHero() {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const scene = document.querySelector('[data-hero-scene]');
    const video = document.querySelector('[data-hero-video]');
    const headline = document.querySelector('[data-hero-headline]');
    const logo = document.querySelector('[data-hero-logo]');
    const cta = document.querySelector('[data-hero-cta]');

    if (!scene || !headline) return;

    // Başlangıç durumları
    gsap.set(scene, { opacity: 0 });
    if (video) gsap.set(video, { scale: 1.08 });
    gsap.set(headline, { opacity: 0, y: 40, filter: 'blur(4px)' });
    if (logo) gsap.set(logo, { opacity: 0, y: 16 });
    if (cta) gsap.set(cta, { opacity: 0, y: 40, filter: 'blur(4px)' });

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    // Video arka plan açılır + yavaş zoom
    tl.to(scene, { opacity: 1, duration: 1.1 }, '+=0');
    if (video) tl.to(video, { scale: 1, duration: 2.5, ease: 'power2.out' }, '<');

    // Logo önce gelsin
    if (logo) tl.to(logo, { opacity: 1, y: 0, duration: 0.7 }, '-=1.55');

    // Ana başlık blur'dan netleşerek gelir
    tl.to(headline, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.9 }, '-=1.2');
    tl.to(cta, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.9 }, '-=1.2');
  }

  function initFlowProgress() {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const root = document.querySelector('[data-flow-root]');
    const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-flow-step]'));
    if (!(root instanceof HTMLElement) || steps.length < 2) return;

    const activateStep = (activeIndex: number) => {
      steps.forEach((step, i) => {
        const icon = step.querySelector<HTMLElement>('[data-flow-icon]');
        const title = step.querySelector<HTMLElement>('[data-flow-title]');
        const body = step.querySelector<HTMLElement>('[data-flow-body]');
        const isActive = i === activeIndex;

        if (icon) {
          icon.classList.toggle('bg-white', isActive);
          icon.classList.toggle('text-[#101010]', isActive);
          icon.classList.toggle('border-white/90', isActive);
          icon.classList.toggle('shadow-[0_0_18px_rgba(255,255,255,0.7)]', isActive);
          icon.classList.toggle('bg-white/5', !isActive);
          icon.classList.toggle('text-white', !isActive);
          icon.classList.toggle('border-white/15', !isActive);
        }

        if (title) {
          title.classList.toggle('drop-shadow-[0_0_12px_rgba(255,255,255,0.5)]', isActive);
          title.classList.toggle('text-white/85', !isActive);
        }

        if (body) {
          body.classList.toggle('text-white/85', isActive);
          body.classList.toggle('drop-shadow-[0_0_10px_rgba(255,255,255,0.32)]', isActive);
          body.classList.toggle('text-white/60', !isActive);
        }
      });
    };

    let stepIndex = -1;
    let timer: number | undefined;

    const runStep = () => {
      stepIndex = (stepIndex + 1) % steps.length;
      activateStep(stepIndex);
    };

    runStep();
    timer = window.setInterval(runStep, 1400);

    window.addEventListener('beforeunload', () => {
      if (timer) window.clearInterval(timer);
    });
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', () => {
        initHomeHero();
        initFlowProgress();
      })
    : (initHomeHero(), initFlowProgress());
</script>
