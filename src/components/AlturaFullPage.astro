---
import type { Locale } from '../i18n/types';
import { t } from '../i18n/t';
import { withLang } from '../i18n/paths';
import { site } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="relative min-h-screen flex-shrink-0 overflow-hidden">
  <section
    id="hero"
    class="relative flex min-h-screen flex-col scroll-mt-0 lg:flex lg:min-h-screen lg:flex-row"
  >
    <div
      class="relative z-10 order-2 flex w-full flex-1 flex-col justify-center bg-paper px-6 pb-20 pt-28 md:px-10 lg:order-1 lg:min-h-0 lg:min-h-screen lg:w-[45%] lg:max-w-none lg:flex-none lg:shrink-0 lg:px-10 lg:pb-24 lg:pt-32 xl:px-14"
    >
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_85%_55%_at_0%_20%,rgba(200,154,60,0.07),transparent_55%)] opacity-100"
        aria-hidden="true"
      />
      <div class="relative flex gap-6 lg:gap-8">
        <span
          class="mt-1 hidden h-[min(12rem,22vh)] w-1 shrink-0 rounded-none bg-gold/90 lg:block"
          aria-hidden="true"
        />
        <div class="min-w-0 flex-1">
          <div class="mb-6">
            <img
              src="/logo.png"
              alt=""
              width="112"
              height="112"
              class="h-14 w-auto object-contain object-left opacity-95 md:h-16"
              loading="eager"
              decoding="async"
            />
            <p class="mt-3 max-w-sm text-[11px] font-semibold uppercase leading-snug tracking-[0.12em] text-ink/70 md:text-xs">
              {site.legalEntityName}
            </p>
          </div>
          <h1
            data-hero-headline
            class="font-sans text-[clamp(1.85rem,4.2vw,3rem)] font-bold uppercase leading-[1.1] tracking-[0.05em] text-ink"
          >
            {t(locale, 'home.slogan')}
          </h1>
          <p class="mt-5 font-sans text-base font-semibold tracking-wide text-ink/85 md:text-lg">
            {t(locale, 'home.heroSubtitle')}
          </p>
          <p class="mt-6 max-w-xl text-[15px] leading-relaxed text-ink-muted md:text-[16px]">{t(locale, 'home.heroLead')}</p>
          <div class="mt-10 flex flex-wrap gap-3">
            <a href={withLang('/products', locale)} class="btn-primary inline-flex w-fit">
              {t(locale, 'home.coffeesCtaAll')}
            </a>
            <a href={withLang('/contact', locale)} class="btn-secondary inline-flex w-fit">
              {t(locale, 'nav.cta')}
            </a>
          </div>
        </div>
      </div>
    </div>

    <div
      class="relative order-1 min-h-[40vh] w-full min-w-0 flex-1 overflow-hidden lg:order-2 lg:min-h-screen lg:w-[55%] lg:flex-none lg:shrink-0"
    >
      <div class="absolute inset-0 overflow-hidden" data-hero-scene>
        <img
          data-hero-photo
          src={site.ogImage}
          alt="Coffee Los Andes banner"
          width="1920"
          height="1080"
          class="h-full w-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-gold/12 via-transparent to-ink/28" aria-hidden="true"></div>
        <div
          class="absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-paper to-transparent lg:w-40"
          aria-hidden="true"
        />
      </div>
    </div>
  </section>
</div>

<script>
  import { gsap } from 'gsap';

  function initHomeHero() {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const scene = document.querySelector('[data-hero-scene]');
    const photo = document.querySelector('[data-hero-photo]');
    const headline = document.querySelector('[data-hero-headline]');
    const navbar = document.querySelector('[data-navbar]');

    if (!scene || !headline) return;

    if (navbar) gsap.set(navbar, { opacity: 0, y: -16 });
    gsap.set(scene, { opacity: 0 });
    if (photo) gsap.set(photo, { scale: 1.06 });

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    tl.fromTo(navbar, { opacity: 0, y: -16 }, { opacity: 1, y: 0, duration: 0.55 })
      .fromTo(scene, { opacity: 0 }, { opacity: 1, duration: 1 }, '-=0.35');
    if (photo) tl.to(photo, { scale: 1, duration: 1.25, ease: 'power3.out' }, '<0.05');
    tl.fromTo(headline, { opacity: 0, y: 36 }, { opacity: 1, y: 0, duration: 0.85 }, '-=0.65');
  }

  document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', initHomeHero) : initHomeHero();
</script>
