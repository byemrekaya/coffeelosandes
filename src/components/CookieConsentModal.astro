---
import type { Locale } from '../i18n/types';
import { t } from '../i18n/t';
import { withLang } from '../i18n/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const privacyUrl = withLang('/privacy', locale);
const impressumUrl = withLang('/impressum', locale);
---

<div
  class="fixed inset-0 z-[120] hidden items-end justify-center bg-black/55 p-4 sm:items-center"
  data-cookie-consent
  role="dialog"
  aria-modal="true"
  aria-label={t(locale, 'cookieConsent.title')}
>
  <div class="w-full max-w-2xl rounded-2xl border border-line bg-white p-6 shadow-[0_26px_70px_rgba(0,0,0,0.35)] sm:p-7">
    <h2 class="font-display text-[clamp(1.25rem,2.6vw,1.8rem)] font-semibold text-ink">
      {t(locale, 'cookieConsent.title')}
    </h2>
    <p class="mt-3 text-[15px] leading-relaxed text-ink/80">
      {t(locale, 'cookieConsent.body')}
    </p>
    <p class="mt-2 text-[14px] leading-relaxed text-ink/70">
      {t(locale, 'cookieConsent.essentialInfo')}
    </p>

    <p class="mt-5 text-[13px] text-ink/65">
      {t(locale, 'cookieConsent.legalPrefix')}
      <a href={privacyUrl} class="ml-1 underline underline-offset-2 hover:text-ink">
        {t(locale, 'footer.linkPrivacy')}
      </a>
      <span class="mx-1">·</span>
      <a href={impressumUrl} class="underline underline-offset-2 hover:text-ink">
        {t(locale, 'footer.linkImpressum')}
      </a>
    </p>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-end">
      <button
        type="button"
        class="inline-flex items-center justify-center rounded-full border border-heading/35 bg-white px-6 py-3 text-[12px] font-semibold uppercase tracking-[0.12em] text-heading transition hover:border-heading hover:bg-heading/5"
        data-cookie-consent-essential
      >
        {t(locale, 'cookieConsent.acceptEssential')}
      </button>
      <button
        type="button"
        class="inline-flex items-center justify-center rounded-full bg-heading px-6 py-3 text-[12px] font-semibold uppercase tracking-[0.12em] text-white shadow-[0_10px_28px_rgba(40,96,63,0.32)] transition hover:scale-[1.01] hover:bg-[#2d704a]"
        data-cookie-consent-accept
      >
        {t(locale, 'cookieConsent.acceptAll')}
      </button>
    </div>
  </div>
</div>

<script>
  const CONSENT_KEY = 'cla_cookie_consent_v1';
  const modal = document.querySelector<HTMLElement>('[data-cookie-consent]');
  const acceptAllBtn = document.querySelector<HTMLElement>('[data-cookie-consent-accept]');
  const acceptEssentialBtn = document.querySelector<HTMLElement>('[data-cookie-consent-essential]');
  const openButtons = Array.from(document.querySelectorAll<HTMLElement>('[data-cookie-open]'));

  if (modal && acceptAllBtn && acceptEssentialBtn) {
    const hasConsent = () => {
      try {
        return !!window.localStorage.getItem(CONSENT_KEY);
      } catch {
        return false;
      }
    };

    const showModal = () => {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.classList.add('overflow-hidden');
    };

    const hideModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.classList.remove('overflow-hidden');
    };

    const persistConsent = (choice: 'all' | 'essential') => {
      try {
        window.localStorage.setItem(
          CONSENT_KEY,
          JSON.stringify({
            choice,
            acceptedAt: new Date().toISOString(),
          })
        );
      } catch {
        // localStorage erişimi yoksa sessizce devam et
      }
    };

    acceptAllBtn.addEventListener('click', () => {
      persistConsent('all');
      hideModal();
    });

    acceptEssentialBtn.addEventListener('click', () => {
      persistConsent('essential');
      hideModal();
    });

    openButtons.forEach((btn) => {
      btn.addEventListener('click', () => showModal());
    });

    if (!hasConsent()) showModal();
  }
</script>
