---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  variant?: 'default' | 'onDark';
}

const { eyebrow, title, description, align = 'left', variant = 'default' } = Astro.props;

const isDark = variant === 'onDark';
const barClass = isDark ? 'bg-white' : 'bg-heading';
const eyebrowClass = isDark
  ? 'text-[11px] font-semibold uppercase tracking-[0.22em] text-white/90'
  : 'stage-eyebrow';
const titleClass = isDark ? '!text-white' : '';
const descClass = isDark ? '!text-white/85' : '';
---

<header class:list={[align === 'center' ? 'mx-auto max-w-4xl' : '']}>
  <div
    class:list={[
      'flex items-start gap-4',
      align === 'center' ? 'mx-auto max-w-3xl justify-center' : '',
    ]}
  >
    <span class:list={['mt-1 h-14 w-1 shrink-0 rounded-none', barClass]} aria-hidden="true" />
    <div class="min-w-0 max-w-2xl space-y-3 text-left">
      {eyebrow && <p class={eyebrowClass}>{eyebrow}</p>}
      <h2 class:list={['stage-heading', titleClass]}>{title}</h2>
      {description && <p class:list={['stage-subtitle', descClass]}>{description}</p>}
    </div>
  </div>
</header>
