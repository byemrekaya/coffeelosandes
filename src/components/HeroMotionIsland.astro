---
---
<div id="hero-motion-root" class="contents">
  <slot />
</div>

<script>
  import { gsap } from 'gsap';

  function initHeroMotion() {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const root = document.getElementById('hero-motion-root');
    if (!root) return;

    const headline = root.querySelector('[data-hero-headline]');
    const subtitle = root.querySelector('[data-hero-subtitle]');
    const ctas = root.querySelectorAll('[data-hero-cta]');
    const visual = root.querySelector('[data-hero-visual]');

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.fromTo(
      headline,
      { opacity: 0, y: 24 },
      { opacity: 1, y: 0, duration: 0.9 }
    )
      .fromTo(subtitle, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 }, '-=0.5')
      .fromTo(ctas, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.5, stagger: 0.1 }, '-=0.3')
      .fromTo(visual, { opacity: 0, scale: 1.02 }, { opacity: 1, scale: 1, duration: 1 }, '-=1.2');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroMotion);
  } else {
    initHeroMotion();
  }
</script>
