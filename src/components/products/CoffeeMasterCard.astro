---
import { Image } from 'astro:assets';
import type { Locale } from '../../i18n/types';
import type { VenezuelaCoffeeMasterItem } from '../../data/venezuelaCoffeeMaster';
import { resolveMasterTastingRows } from '../../i18n/resolveMasterTastingRows';
import { tastingLabelPath } from '../../i18n/tastingLabelPaths';
import { withLang } from '../../i18n/paths';
import { t } from '../../i18n/t';
import { translateTicariSegment } from '../../i18n/translateTicariSegment';

interface Props {
  item: VenezuelaCoffeeMasterItem;
  locale: Locale;
  slug: string;
  cuppingBadge?: string | null;
}

const { item, locale, slug, cuppingBadge } = Astro.props;
const scoreBadge = cuppingBadge != null && cuppingBadge !== '' ? cuppingBadge : item.cupping_score;
const dominantTasting = resolveMasterTastingRows(slug, locale).find((r) => r.labelKey === 'dominantNotes');
const labelByLocale: Record<Locale, { producer: string; farm: string; imageAlt: string }> = {
  tr: { producer: 'Üretici', farm: 'Çiftlik', imageAlt: 'Venezuela premium kahve çekirdekleri' },
  de: { producer: 'Produzent', farm: 'Farm', imageAlt: 'Premium Kaffeebohnen aus Venezuela' },
  en: { producer: 'Producer', farm: 'Farm', imageAlt: 'premium coffee beans from Venezuela' },
  fr: { producer: 'Producteur', farm: 'Ferme', imageAlt: 'grains de cafe premium du Venezuela' },
  es: { producer: 'Productor', farm: 'Finca', imageAlt: 'granos de cafe premium de Venezuela' },
  nl: { producer: 'Producent', farm: 'Plantage', imageAlt: 'premium koffiebonen uit Venezuela' },
  pl: { producer: 'Producent', farm: 'Farma', imageAlt: 'premium ziarna kawy z Wenezueli' },
  cs: { producer: 'Pěstitel', farm: 'Farma', imageAlt: 'prémiová kávová zrna z Venezuely' },
  it: { producer: 'Produttore', farm: 'Fattoria', imageAlt: 'chicchi di caffè premium dal Venezuela' },
  ru: { producer: 'Производитель', farm: 'Ферма', imageAlt: 'премиальные кофейные зёрна из Венесуэлы' },
  ar: { producer: 'المنتج', farm: 'المزرعة', imageAlt: 'حبوب بن ممتازة من فنزويلا' },
};
---

<a
  href={withLang(`/products/${slug}`, locale)}
  class="group flex h-full flex-col overflow-hidden rounded-[20px] border border-[#ddd4c7] bg-[#fcfbf7] text-inherit no-underline shadow-[0_8px_24px_rgba(0,0,0,0.04)] transition-all duration-250 hover:-translate-y-0.5 hover:shadow-[0_14px_28px_rgba(0,0,0,0.08)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-heading focus-visible:ring-offset-2"
>
  <div class="relative h-56 overflow-hidden bg-[#e9e2d6]">
    <Image
      src="/losandeseurope.webp"
      alt={`${item.cesit} ${labelByLocale[locale].imageAlt}`}
      class="absolute inset-0 h-full w-full object-cover object-center transition duration-500 ease-out group-hover:scale-[1.03]"
      loading="lazy"
      width="1200"
      height="800"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-black/5 to-transparent" aria-hidden="true"></div>
  </div>

  <div class="flex flex-1 flex-col p-5">
  <div class="mb-4 flex items-center justify-between gap-3">
    <span class="rounded-full border border-heading/30 bg-heading/8 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.15em] text-heading">
      {item.segment}
    </span>
    <span class="rounded-full bg-[#1f1f1c] px-3 py-1 text-[11px] font-semibold text-white">{scoreBadge}</span>
  </div>

  <h3 class="font-display text-[1.15rem] font-semibold leading-snug text-heading">
    {item.cesit === 'Desconocido' ? `${item.cesit} — ${item.ciftlik}` : item.cesit}
  </h3>
  <p class="mt-1 text-[11px] font-medium uppercase tracking-[0.14em] text-ink/52">{item.bolge}</p>

  <dl class="mt-4 space-y-2 text-[13px] leading-relaxed text-ink/78">
    <div>
      <dt class="inline font-semibold text-ink/65">{labelByLocale[locale].producer}: </dt>
      <dd class="inline">{item.uretici}</dd>
    </div>
    <div>
      <dt class="inline font-semibold text-ink/65">{labelByLocale[locale].farm}: </dt>
      <dd class="inline">{item.ciftlik}</dd>
    </div>
  </dl>

  {dominantTasting && (
    <p class="mt-3 text-[12px] leading-relaxed text-ink/72">
      <span class="font-semibold text-ink/55">{t(locale, tastingLabelPath('dominantNotes'))}: </span>
      <span class="line-clamp-2">{dominantTasting.value}</span>
    </p>
  )}

  <p class="mt-4 inline-flex w-fit rounded-full bg-[#f3efe7] px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.1em] text-[#4f4a44]">
    {translateTicariSegment(item.ticari_segment, locale)}
  </p>

  <div class="mt-6 border-t border-[#e7dfd3] pt-5 text-center">
    <span class="text-[13px] font-semibold uppercase tracking-[0.16em] text-heading transition group-hover:tracking-[0.18em]">
      {t(locale, 'home.lotDetail')}
    </span>
  </div>
  </div>
</a>
