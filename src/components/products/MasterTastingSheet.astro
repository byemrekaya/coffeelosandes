---
import type { TastingStructuredRow } from '../../data/tastingStructured';
import { tastingLabelPath } from '../../i18n/tastingLabelPaths';
import type { Locale } from '../../i18n/types';
import { t } from '../../i18n/t';

interface Props {
  rows: TastingStructuredRow[];
  locale: Locale;
}

const { rows, locale } = Astro.props;

function splitToChips(value: string): string[] {
  const parts = value
    .split(/[,;/]|·/g)
    .map((part) => part.trim())
    .filter(Boolean);
  if (parts.length < 2 || parts.length > 6) return [];
  if (parts.some((part) => part.length > 28)) return [];
  return parts;
}
---

{
  rows.length > 0 && (
    <article class="overflow-hidden rounded-2xl border border-[#ddd4c7] bg-[#fcfbf7] p-4 shadow-[0_10px_30px_rgba(0,0,0,0.04)] sm:rounded-[24px] sm:p-6 md:p-8">
      <div class="mb-5 sm:mb-7">
        <span class="mb-2 block text-[11px] font-semibold uppercase tracking-[0.24em] text-[#6f7f5f]">
          {t(locale, 'coffee.tastingSheetEyebrow')}
        </span>
        <h3 class="font-display text-[clamp(1.5rem,3.5vw,2.4rem)] font-semibold leading-tight text-heading">
          {t(locale, 'coffee.tastingSheetTitle')}
        </h3>
      </div>

      <div class="space-y-3 sm:space-y-4">
        {rows.map((row) => {
          const chips = splitToChips(row.value);
          return (
            <div class="rounded-xl border border-[#e7dfd3] bg-[#f9f6f0] p-4 sm:rounded-2xl sm:p-5">
              <dt class="mb-2 text-[10px] font-semibold uppercase leading-snug tracking-[0.18em] text-[#8a847b] sm:mb-3 sm:tracking-[0.22em]">
                {t(locale, tastingLabelPath(row.labelKey))}
              </dt>
              <dd class="min-w-0">
                {chips.length > 0 ? (
                  <div class="flex flex-wrap gap-2">
                    {chips.map((chip) => (
                      <span class="max-w-full break-words rounded-full bg-white px-2.5 py-1.5 text-[13px] font-medium leading-snug text-[#1f1f1c] sm:px-3 sm:py-2 sm:text-sm">
                        {chip}
                      </span>
                    ))}
                  </div>
                ) : (
                  <p class="break-words text-[16px] font-medium leading-relaxed text-[#1f1f1c] sm:text-[17px] sm:leading-7">
                    {row.value}
                  </p>
                )}
              </dd>
            </div>
          );
        })}
      </div>
    </article>
  )
}
