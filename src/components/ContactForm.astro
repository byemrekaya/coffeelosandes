---
import type { Locale } from '../i18n/types';
import { t } from '../i18n/t';
import { withLang } from '../i18n/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const redirectPath = withLang('/contact', locale);
const base = import.meta.env.BASE_URL;
const formAction = base.endsWith('/') ? `${base}api/contact` : `${base}/api/contact`;
---

<form
  class="glass-panel space-y-6 px-8 py-10 md:px-10 md:py-12"
  aria-label={t(locale, 'form.aria')}
  action={formAction}
  method="post"
>
  <input type="hidden" name="_redirect" value={redirectPath} />

  <p class="text-sm text-ink-muted">{t(locale, 'form.helper')}</p>

  <input
    type="text"
    name="_gotcha"
    tabindex="-1"
    autocomplete="off"
    class="hidden"
    aria-hidden="true"
  />

  <div class="space-y-2">
    <label for="name" class="block text-xs font-medium uppercase tracking-[0.15em] text-ink">
      {t(locale, 'form.name')}
    </label>
    <input
      id="name"
      name="name"
      type="text"
      required
      autocomplete="name"
      class="w-full rounded-none border border-line bg-surface-muted px-4 py-3.5 text-[15px] text-cream placeholder:text-cream/35 focus:border-terracotta/60 focus:outline-none focus:ring-1 focus:ring-terracotta/40 transition"
      placeholder={t(locale, 'form.namePh')}
      aria-required="true"
    />
  </div>

  <div class="space-y-2">
    <label for="contact" class="block text-xs font-medium uppercase tracking-[0.15em] text-ink">
      {t(locale, 'form.contact')}
    </label>
    <input
      id="contact"
      name="contact"
      type="text"
      required
      autocomplete="email"
      class="w-full rounded-none border border-line bg-surface-muted px-4 py-3.5 text-[15px] text-cream placeholder:text-cream/35 focus:border-terracotta/60 focus:outline-none focus:ring-1 focus:ring-terracotta/40 transition"
      placeholder={t(locale, 'form.contactPh')}
      aria-required="true"
    />
  </div>

  <div class="space-y-2">
    <label for="message" class="block text-xs font-medium uppercase tracking-[0.15em] text-ink">
      {t(locale, 'form.message')}
    </label>
    <textarea
      id="message"
      name="message"
      rows="5"
      class="w-full rounded-none border border-line bg-surface-muted px-4 py-3.5 text-[15px] text-cream placeholder:text-cream/35 focus:border-terracotta/60 focus:outline-none focus:ring-1 focus:ring-terracotta/40 transition resize-y min-h-[120px]"
      placeholder={t(locale, 'form.messagePh')}
    ></textarea>
    <p class="text-[11px] text-ink-muted">{t(locale, 'form.messageHint')}</p>
  </div>

  <div class="pt-2">
    <button type="submit" class="btn-primary w-full md:w-auto">
      {t(locale, 'form.submit')}
    </button>
  </div>
</form>
