---
import type { Locale } from '../i18n/types';
import { t } from '../i18n/t';
import { site } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const mailTo = site.contactEmail;
const lCompany = t(locale, 'form.mailBodyCompany');
const lPhone = t(locale, 'form.mailBodyPhone');
const lMsg = t(locale, 'form.mailBodyMessage');
---

<form
  id="contact-mailto-form"
  class="space-y-6 rounded-[24px] border border-[#ded7c9] bg-white px-8 py-10 shadow-[0_18px_40px_rgba(22,18,12,0.08)] md:px-10 md:py-12"
  aria-label={t(locale, 'form.aria')}
  data-mail-to={mailTo}
  data-label-company={lCompany}
  data-label-phone={lPhone}
  data-label-message={lMsg}
>
  <p class="text-sm leading-relaxed text-ink-muted">{t(locale, 'form.helper')}</p>

  <div class="space-y-2">
    <label for="contact-company" class="block text-sm font-medium text-ink/88">
      {t(locale, 'form.company')}
    </label>
    <input
      id="contact-company"
      name="company"
      type="text"
      required
      autocomplete="organization"
      class="w-full rounded-xl border border-[#d9d1c3] bg-[#fcfbf8] px-4 py-4 text-[15px] text-ink placeholder:text-ink/42 focus:border-heading/55 focus:outline-none focus:ring-2 focus:ring-heading/20 transition"
      placeholder={t(locale, 'form.companyPh')}
      aria-required="true"
    />
  </div>

  <div class="space-y-2">
    <label for="contact-phone" class="block text-sm font-medium text-ink/88">
      {t(locale, 'form.phone')}
    </label>
    <input
      id="contact-phone"
      name="phone"
      type="tel"
      required
      autocomplete="tel"
      class="w-full rounded-xl border border-[#d9d1c3] bg-[#fcfbf8] px-4 py-4 text-[15px] text-ink placeholder:text-ink/42 focus:border-heading/55 focus:outline-none focus:ring-2 focus:ring-heading/20 transition"
      placeholder={t(locale, 'form.phonePh')}
      aria-required="true"
    />
  </div>

  <div class="space-y-2">
    <label for="contact-message" class="block text-sm font-medium text-ink/88">
      {t(locale, 'form.message')}
    </label>
    <textarea
      id="contact-message"
      name="message"
      rows="6"
      required
      class="w-full min-h-[150px] resize-y rounded-xl border border-[#d9d1c3] bg-[#fcfbf8] px-4 py-4 text-[15px] text-ink placeholder:text-ink/42 focus:border-heading/55 focus:outline-none focus:ring-2 focus:ring-heading/20 transition"
      placeholder={t(locale, 'form.messagePh')}
      aria-required="true"
    ></textarea>
    <p class="text-[11px] text-ink-muted">{t(locale, 'form.privacyNote')}</p>
  </div>

  <div class="pt-1">
    <button type="submit" class="btn-primary w-full justify-center">
      {t(locale, 'form.submit')}
    </button>
  </div>
</form>

<script is:inline>
  document.getElementById('contact-mailto-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;
    const mailTo = form.dataset.mailTo;
    const lCompany = form.dataset.labelCompany ?? '';
    const lPhone = form.dataset.labelPhone ?? '';
    const lMsg = form.dataset.labelMessage ?? '';
    if (!mailTo) return;
    const companyEl = document.getElementById('contact-company');
    const phoneEl = document.getElementById('contact-phone');
    const messageEl = document.getElementById('contact-message');
    const company = companyEl && 'value' in companyEl ? String(companyEl.value).trim() : '';
    const phone = phoneEl && 'value' in phoneEl ? String(phoneEl.value).trim() : '';
    const message = messageEl && 'value' in messageEl ? String(messageEl.value).trim() : '';
    if (!company || !phone || !message) return;
    const subject = encodeURIComponent('[Coffee Los Andes B2B] ' + company);
    const body = encodeURIComponent(
      lCompany + ': ' + company + '\n' + lPhone + ': ' + phone + '\n\n' + lMsg + ':\n' + message
    );
    window.location.href = 'mailto:' + mailTo + '?subject=' + subject + '&body=' + body;
  });
</script>
