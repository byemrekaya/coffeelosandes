---
---
<form
  class="glass-panel space-y-6 px-8 py-10 md:px-10 md:py-12"
  aria-label="B2B toptan kahve talep formu"
  action="#"
  method="post"
>
  <div class="grid gap-5 md:grid-cols-2">
    <div class="space-y-2">
      <label for="name" class="block text-xs font-medium uppercase tracking-[0.15em] text-cream/80">
        Ad Soyad
      </label>
      <input
        id="name"
        name="name"
        type="text"
        required
        autocomplete="name"
        class="w-full rounded-lg border border-cream/[0.1] bg-charcoal/60 px-4 py-3.5 text-[15px] text-cream placeholder:text-cream/35 focus:border-gold/60 focus:outline-none focus:ring-1 focus:ring-gold/40 transition"
        placeholder="İş birliği için yetkili kişi"
        aria-required="true"
      />
    </div>
    <div class="space-y-2">
      <label for="company" class="block text-xs font-medium uppercase tracking-[0.15em] text-cream/80">
        Şirket / Marka Adı
      </label>
      <input
        id="company"
        name="company"
        type="text"
        required
        autocomplete="organization"
        class="w-full rounded-lg border border-cream/[0.1] bg-charcoal/60 px-4 py-3.5 text-[15px] text-cream placeholder:text-cream/35 focus:border-gold/60 focus:outline-none focus:ring-1 focus:ring-gold/40 transition"
        placeholder="Örn. Alto Valle Coffee Roasters"
        aria-required="true"
      />
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <div class="space-y-2">
      <label for="email" class="block text-xs font-medium uppercase tracking-[0.15em] text-cream/80">
        Kurumsal E-posta
      </label>
      <input
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
        class="w-full rounded-lg border border-cream/[0.1] bg-charcoal/60 px-4 py-3.5 text-[15px] text-cream placeholder:text-cream/35 focus:border-gold/60 focus:outline-none focus:ring-1 focus:ring-gold/40 transition"
        placeholder="b2b@markaniz.com"
        aria-required="true"
      />
    </div>
    <div class="space-y-2">
      <label for="phone" class="block text-xs font-medium uppercase tracking-[0.15em] text-cream/80">
        Telefon
      </label>
      <input
        id="phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        class="w-full rounded-lg border border-cream/[0.1] bg-charcoal/60 px-4 py-3.5 text-[15px] text-cream placeholder:text-cream/35 focus:border-gold/60 focus:outline-none focus:ring-1 focus:ring-gold/40 transition"
        placeholder="+90 ..."
      />
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <div class="space-y-2">
      <label for="country" class="block text-xs font-medium uppercase tracking-[0.15em] text-cream/80">
        Ülke / Bölge
      </label>
      <input
        id="country"
        name="country"
        type="text"
        autocomplete="country-name"
        class="w-full rounded-lg border border-cream/[0.1] bg-charcoal/60 px-4 py-3.5 text-[15px] text-cream placeholder:text-cream/35 focus:border-gold/60 focus:outline-none focus:ring-1 focus:ring-gold/40 transition"
        placeholder="Örn. Türkiye, Orta Avrupa"
      />
    </div>
    <div class="space-y-2">
      <label for="volume" class="block text-xs font-medium uppercase tracking-[0.15em] text-cream/80">
        Tahmini Aylık Hacim
      </label>
      <select
        id="volume"
        name="volume"
        class="w-full rounded-lg border border-cream/[0.1] bg-charcoal/60 px-4 py-3.5 text-[15px] text-cream focus:border-gold/60 focus:outline-none focus:ring-1 focus:ring-gold/40 transition"
        aria-describedby="volume-hint"
      >
        <option value="">Seçin</option>
        <option value="sub-60">60 kg altı</option>
        <option value="60-120">60 – 120 kg</option>
        <option value="120-300">120 – 300 kg</option>
        <option value="300-plus">300 kg üzeri</option>
      </select>
      <p id="volume-hint" class="text-[11px] text-cream/50">B2B planlaması için tahmini değer yeterlidir.</p>
    </div>
  </div>

  <div class="space-y-2">
    <label for="interest" class="block text-xs font-medium uppercase tracking-[0.15em] text-cream/80">
      İlgi Alanı
    </label>
    <select
      id="interest"
      name="interest"
      class="w-full rounded-lg border border-cream/[0.1] bg-charcoal/60 px-4 py-3.5 text-[15px] text-cream focus:border-gold/60 focus:outline-none focus:ring-1 focus:ring-gold/40 transition"
    >
      <option value="">Seçin</option>
      <option value="wholesale">Toptan satın alma</option>
      <option value="distribution">Dağıtım ortaklığı</option>
      <option value="private-label">Özel etiket / white-label</option>
      <option value="info">Genel bilgi talebi</option>
    </select>
  </div>

  <div class="space-y-2">
    <label for="message" class="block text-xs font-medium uppercase tracking-[0.15em] text-cream/80">
      Mesajınız
    </label>
    <textarea
      id="message"
      name="message"
      rows="5"
      class="w-full rounded-lg border border-cream/[0.1] bg-charcoal/60 px-4 py-3.5 text-[15px] text-cream placeholder:text-cream/35 focus:border-gold/60 focus:outline-none focus:ring-1 focus:ring-gold/40 transition resize-y min-h-[120px]"
      placeholder="Hacim hedefleriniz, menü odaklarınız veya özel talepleriniz hakkında kısaca bilgi verin."
      aria-describedby="message-hint"
    ></textarea>
    <p id="message-hint" class="text-[11px] text-cream/50">Detaylı bilgi, ekibimizin size daha hızlı dönüş yapmasına yardımcı olur.</p>
  </div>

  <div class="pt-2">
    <button type="submit" class="btn-primary w-full md:w-auto">
      Talebi Gönder
    </button>
  </div>
</form>
