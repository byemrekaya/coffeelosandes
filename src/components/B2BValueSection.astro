---
import { b2bPoints } from '../data/brand';
import SectionHeader from './SectionHeader.astro';
---

<section class="mt-20 md:mt-28" data-reveal>
  <div class="section-shell space-y-10">
    <SectionHeader
      eyebrow="B2B için tasarlandı"
      title="Tedarik zincirinizin görünmeyen ortağı."
      description="Coffee Los Andes, yalnızca çekirdek tedarik etmez; operasyon, menü ve marka kararlarınız için omurga kurar."
      align="center"
    />

    <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {b2bPoints.map((point, i) => (
        <article class="glass-panel relative flex h-full flex-col border border-cream/5 bg-espresso/40 px-5 py-6" data-reveal-step={String(i + 1)}>
          <div
            class="pointer-events-none absolute -right-10 -top-10 h-24 w-24 rounded-full bg-gradient-to-br from-bronze/25 via-transparent to-transparent blur-2xl"
            aria-hidden="true"
          ></div>
          <h3 class="text-xs font-semibold uppercase tracking-[0.25em] text-cream/70">{point.title}</h3>
          <p class="mt-3 text-[12px] leading-relaxed text-cream/70">{point.detail}</p>
        </article>
      ))}
    </div>
  </div>
</section>

