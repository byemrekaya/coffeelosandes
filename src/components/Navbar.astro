---
import type { Locale } from '../i18n/types';
import { t } from '../i18n/t';
import { homeSection, withLang } from '../i18n/paths';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

type NavItem =
  | { kind: 'section'; hash: string; key: string }
  | { kind: 'page'; path: string; key: string };

const navLinks: NavItem[] = [
  { kind: 'section', hash: 'hero', key: 'nav.home' },
  { kind: 'page', path: '/about', key: 'nav.about' },
  { kind: 'section', hash: 'kahvelerimiz', key: 'nav.coffees' },
  { kind: 'section', hash: 'kalite', key: 'nav.qualityDocs' },
  { kind: 'section', hash: 'toptan', key: 'nav.wholesale' },
];

const navLeft = navLinks.slice(0, 3);
const navRight = navLinks.slice(3);

const linkClass =
  'whitespace-nowrap text-[10px] font-semibold uppercase tracking-brand text-white/75 transition-colors hover:text-white xl:text-[11px]';
---

<header class="fixed inset-x-0 top-0 z-40" data-navbar>
  <div class="bg-ink text-white shadow-nav">
    <div class="section-shell relative">
      <div class="flex items-center justify-between gap-3 py-3.5 lg:hidden">
        <a
          href={homeSection(locale, 'hero')}
          class="min-w-0 truncate text-xs font-bold uppercase tracking-brand text-white"
        >
          Coffee Los Andes
        </a>
        <div class="flex shrink-0 items-center gap-2">
          <LanguageSwitcher locale={locale} variant="dark" />
        </div>
      </div>

      <nav class="relative hidden h-[4.6rem] items-center lg:flex" aria-label={t(locale, 'nav.aria')}>
        <ul class="flex h-full flex-1 items-center justify-end gap-x-6 pr-[min(8rem,12vw)] xl:gap-x-10">
          {navLeft.map((item) => (
            <li>
              <a
                href={item.kind === 'section' ? homeSection(locale, item.hash) : withLang(item.path, locale)}
                class={linkClass}
              >
                {t(locale, item.key)}
              </a>
            </li>
          ))}
        </ul>

        <a href={homeSection(locale, 'hero')} class="absolute left-1/2 top-[2px] -translate-x-1/2">
          <span
            class="flex min-h-[92px] w-[74px] flex-col items-center justify-center gap-1.5 rounded-b-[18px] border-x border-b border-white/20 bg-ink px-2 pb-2.5 pt-2 shadow-[0_10px_18px_rgba(0,0,0,0.28)]"
            aria-hidden="true"
          >
            <img src="/logo.png" alt="" class="h-11 w-11 shrink-0 object-contain" loading="eager" decoding="async" />
          </span>
          <span class="sr-only">Coffee Los Andes</span>
        </a>

        <div class="flex h-full flex-1 items-center justify-start gap-x-4 pl-[min(8rem,12vw)] xl:gap-x-6">
          <ul class="flex h-full items-center gap-x-6 xl:gap-x-10">
            {navRight.map((item) => (
              <li>
                <a
                  href={item.kind === 'section' ? homeSection(locale, item.hash) : withLang(item.path, locale)}
                  class={linkClass}
                >
                  {t(locale, item.key)}
                </a>
              </li>
            ))}
          </ul>
          <div class="ml-auto flex items-center gap-3 pl-2">
            <LanguageSwitcher locale={locale} variant="dark" />
          </div>
        </div>
      </nav>
    </div>
  </div>

  <div class="border-t border-white/10 bg-ink lg:hidden">
    <div class="section-shell overflow-x-auto py-2">
      <ul class="flex w-max min-w-full gap-2 pb-0.5">
        {navLinks.map((item) => (
          <li class="shrink-0">
            <a
              href={item.kind === 'section' ? homeSection(locale, item.hash) : withLang(item.path, locale)}
              class="inline-block border border-white/20 bg-white/5 px-3 py-2 text-[10px] font-semibold uppercase tracking-wider text-white/85"
            >
              {t(locale, item.key)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>
