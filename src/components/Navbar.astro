---
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/types';
import { t } from '../i18n/t';
import { homeSection, withLang } from '../i18n/paths';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

type NavItem =
  | { kind: 'section'; hash: string; key: string }
  | { kind: 'page'; path: string; key: string };

const navLinks: NavItem[] = [
  { kind: 'section', hash: 'hero', key: 'nav.home' },
  { kind: 'section', hash: 'hikayemiz', key: 'nav.story' },
  { kind: 'section', hash: 'bolgelerimiz', key: 'nav.regions' },
  { kind: 'section', hash: 'kalite', key: 'nav.qualityMenu' },
  { kind: 'section', hash: 'urun-portfoy', key: 'nav.products' },
  { kind: 'section', hash: 'misyonumuz', key: 'nav.mission' },
];

const navLeft = navLinks.slice(0, 3);
const navRight = navLinks.slice(3);
const isHomePath = /^\/(?:(tr|de|en|fr|es|nl|pl|cs|it|ru|ar)\/?)?$/.test(Astro.url.pathname);
const homeAriaByLocale: Record<Locale, string> = {
  tr: 'Coffee Los Andes ana sayfa',
  de: 'Coffee Los Andes Startseite',
  en: 'Coffee Los Andes homepage',
  fr: 'Page d accueil Coffee Los Andes',
  es: 'Pagina de inicio Coffee Los Andes',
  nl: 'Coffee Los Andes homepage',
  pl: 'Coffee Los Andes homepage',
  cs: 'Coffee Los Andes homepage',
  it: 'Homepage Coffee Los Andes',
  ru: 'Главная страница Coffee Los Andes',
  ar: 'الصفحة الرئيسية Coffee Los Andes',
};

const linkClass =
  'whitespace-nowrap text-[10px] font-semibold uppercase tracking-brand text-nav-cream/80 transition-colors hover:text-nav-cream xl:text-[11px]';
---

<header
  class:list={[
    /* overflow-x-hidden kullanma: overflow-y auto’ya zorlanır ve mobilde dil menüsü kesilir */
    'fixed inset-x-0 top-0 z-40 max-w-full overflow-visible transition-all duration-500',
  ]}
  data-navbar
>
  <div
    class:list={[
      'text-nav-cream transition-all duration-500',
      isHomePath ? 'bg-nav/45 backdrop-blur-md shadow-none' : 'bg-nav shadow-nav-dark',
    ]}
    data-navbar-surface
  >
    <div class="section-shell relative">
      <div class="flex items-center gap-2 py-3.5 lg:hidden">
        <div class="flex w-[3.25rem] shrink-0 justify-start sm:w-14">
          <LanguageSwitcher locale={locale} variant="dark" dropdownAlign="left" />
        </div>
        <div class="flex min-w-0 flex-1 justify-center px-1">
          <a
            href={homeSection(locale, 'hero')}
            class="flex max-w-[min(100%,220px)] items-center justify-center"
            aria-label={homeAriaByLocale[locale]}
          >
            <Image
              src="/coffeelosandes-navbar-logo.svg"
              alt=""
              class="h-8 w-auto max-h-9 object-contain object-center"
              width="220"
              height="44"
              loading="eager"
            />
          </a>
        </div>
        <div class="flex w-[3.25rem] shrink-0 justify-end sm:w-14">
          <button
            type="button"
            class="flex h-10 w-10 items-center justify-center rounded-xl border border-nav-cream/25 bg-nav-surface/90 text-nav-cream shadow-sm transition hover:bg-white/10 sm:h-11 sm:w-11"
            aria-expanded="false"
            aria-controls="mobile-nav-drawer"
            data-mobile-nav-open
            aria-label={t(locale, 'nav.menuOpen')}
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
        </div>
      </div>

      <nav class="relative hidden h-[4.35rem] items-center lg:flex" aria-label={t(locale, 'nav.aria')}>
        <ul class="flex h-full flex-1 items-center justify-end gap-x-6 pr-[min(8rem,12vw)] xl:gap-x-10">
          {navLeft.map((item) => (
            <li>
              <a
                href={item.kind === 'section' ? homeSection(locale, item.hash) : withLang(item.path, locale)}
                class={linkClass}
              >
                {t(locale, item.key)}
              </a>
            </li>
          ))}
        </ul>

        <a
          href={homeSection(locale, 'hero')}
          class:list={[
            'absolute left-1/2 top-[3px] -translate-x-1/2 transition-all duration-500',
            isHomePath && 'opacity-0 -translate-y-2 scale-95 pointer-events-none',
          ]}
          data-navbar-center-link
          aria-label={homeAriaByLocale[locale]}
        >
          <span
            class="flex min-h-[86px] min-w-[108px] max-w-[180px] flex-col items-center justify-center gap-1 rounded-b-[16px] border-x border-b border-nav-cream/20 bg-nav-surface px-3 pb-2 pt-2 shadow-nav-floating"
            aria-hidden="true"
          >
            <Image
              src="/coffeelosandes-navbar-logo.svg"
              alt=""
              class="h-[46px] w-full max-w-[164px] object-contain object-center"
              width="164"
              height="46"
              loading="eager"
            />
          </span>
          <span class="sr-only">Coffee Los Andes</span>
        </a>

        <div class="flex h-full flex-1 items-center justify-start gap-x-4 pl-[min(8rem,12vw)] xl:gap-x-6">
          <ul class="flex h-full items-center gap-x-6 xl:gap-x-10">
            {navRight.map((item) => (
              <li>
                <a
                  href={item.kind === 'section' ? homeSection(locale, item.hash) : withLang(item.path, locale)}
                  class={linkClass}
                >
                  {t(locale, item.key)}
                </a>
              </li>
            ))}
          </ul>
          <div class="ml-auto flex items-center gap-3 pl-2">
            <LanguageSwitcher locale={locale} variant="dark" />
          </div>
        </div>
      </nav>
    </div>
  </div>
</header>

<div
  class="pointer-events-none fixed inset-0 z-[45] bg-black/50 opacity-0 transition-opacity duration-300 lg:hidden"
  data-mobile-nav-overlay
  aria-hidden="true"
></div>
<div
  id="mobile-nav-drawer"
  class="fixed left-0 top-0 z-[50] flex h-[100dvh] w-[min(88vw,19rem)] max-w-full -translate-x-full flex-col border-r border-nav-cream/15 bg-nav shadow-[8px_0_32px_rgba(0,0,0,0.35)] transition-transform duration-300 ease-out sm:w-[min(85vw,20rem)] lg:hidden"
  data-mobile-nav-drawer
  role="dialog"
  aria-modal="true"
  aria-label={t(locale, 'nav.aria')}
>
  <div class="flex shrink-0 items-center justify-between border-b border-nav-cream/15 px-3 py-3 pt-[max(0.75rem,env(safe-area-inset-top))]">
    <span class="pl-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-nav-cream/55">{t(locale, 'nav.drawerHeading')}</span>
    <button
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-xl text-nav-cream transition hover:bg-white/10"
      data-mobile-nav-close
      aria-label={t(locale, 'nav.menuClose')}
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>
  <nav class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-3 pb-[max(1rem,env(safe-area-inset-bottom))] pt-2" aria-label={t(locale, 'nav.aria')}>
    <ul class="space-y-0.5">
      {navLinks.map((item) => (
        <li>
          <a
            href={item.kind === 'section' ? homeSection(locale, item.hash) : withLang(item.path, locale)}
            class="block rounded-lg px-3 py-3.5 text-[11px] font-semibold uppercase tracking-brand text-nav-cream/90 transition hover:bg-white/10"
            data-mobile-nav-link
          >
            {t(locale, item.key)}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script is:inline>
  (function () {
    const openBtn = document.querySelector('[data-mobile-nav-open]');
    const drawer = document.querySelector('[data-mobile-nav-drawer]');
    const overlay = document.querySelector('[data-mobile-nav-overlay]');
    const closeBtn = document.querySelector('[data-mobile-nav-close]');
    if (!(openBtn instanceof HTMLElement) || !(drawer instanceof HTMLElement) || !(overlay instanceof HTMLElement)) return;

    const setOpen = (open) => {
      drawer.classList.toggle('-translate-x-full', !open);
      drawer.classList.toggle('translate-x-0', open);
      overlay.classList.toggle('opacity-0', !open);
      overlay.classList.toggle('pointer-events-none', !open);
      openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      overlay.setAttribute('aria-hidden', open ? 'false' : 'true');
      document.body.classList.toggle('overflow-hidden', open);
    };

    openBtn.addEventListener('click', () => setOpen(true));
    closeBtn?.addEventListener('click', () => setOpen(false));
    overlay.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
    drawer.querySelectorAll('[data-mobile-nav-link]').forEach((a) => {
      a.addEventListener('click', () => setOpen(false));
    });
  })();
</script>

{
  isHomePath && (
    <script>
      const navbar = document.querySelector('[data-navbar]');
      const hero = document.querySelector('#hero');
      const surface = document.querySelector('[data-navbar-surface]');
      const centerLink = document.querySelector('[data-navbar-center-link]');

      if (
        navbar instanceof HTMLElement &&
        surface instanceof HTMLElement &&
        centerLink instanceof HTMLElement
      ) {
        const onScroll = () => {
          const threshold = hero instanceof HTMLElement ? Math.min(220, hero.offsetHeight * 0.26) : 110;
          const isScrolled = window.scrollY > threshold;

          surface.classList.toggle('bg-nav/45', !isScrolled);
          surface.classList.toggle('backdrop-blur-md', !isScrolled);
          surface.classList.toggle('shadow-none', !isScrolled);

          surface.classList.toggle('bg-nav', isScrolled);
          surface.classList.toggle('shadow-nav-dark', isScrolled);

          centerLink.classList.toggle('opacity-0', !isScrolled);
          centerLink.classList.toggle('-translate-y-2', !isScrolled);
          centerLink.classList.toggle('scale-95', !isScrolled);
          centerLink.classList.toggle('pointer-events-none', !isScrolled);
        };

        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  )
}
