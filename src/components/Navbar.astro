---
const links: { href: string; label: string }[] = [
  { href: '/products', label: 'Kahve portföyü' },
  { href: '/about', label: 'Hakkımızda' },
  { href: '/contact', label: 'İletişim' },
];
---

<header class="fixed inset-x-0 top-0 z-40 px-4 md:px-8" data-navbar>
  <nav
    class="mx-auto mt-5 flex w-full max-w-[1280px] items-center justify-between rounded-xl border border-cream/[0.06] bg-charcoal/80 px-5 py-3.5 text-sm text-cream shadow-nav backdrop-blur-xl md:px-8"
    aria-label="Ana navigasyon"
  >
    <a href="/" class="flex items-center gap-3 transition-opacity hover:opacity-90">
      <span class="font-display text-base md:text-lg font-semibold tracking-brand uppercase text-cream">Coffee Los Andes</span>
    </a>

    <div class="hidden items-center gap-10 md:flex">
      <ul class="flex items-center gap-8">
        {links.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-[13px] font-medium tracking-wide text-cream/70 transition-colors hover:text-cream"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/contact" class="btn-primary text-xs px-5 py-2.5">
        B2B İletişim
      </a>
    </div>

    <div class="flex items-center md:hidden">
      <a href="/contact" class="btn-primary text-xs px-4 py-2.5">
        B2B İletişim
      </a>
    </div>
  </nav>
</header>

