---
import type { Locale } from '../i18n/types';
import { locales } from '../i18n/types';
import { switchLocalePath } from '../i18n/paths';

interface Props {
  locale: Locale;
  variant?: 'default' | 'dark';
}

const { locale, variant = 'default' } = Astro.props;
const pathname = Astro.url.pathname;

const localeMeta: Record<Locale, { flag: string; label: string }> = {
  tr: { flag: '🇹🇷', label: 'TR' },
  de: { flag: '🇩🇪', label: 'DE' },
  en: { flag: '🇬🇧', label: 'EN' },
  fr: { flag: '🇫🇷', label: 'FR' },
  es: { flag: '🇪🇸', label: 'ES' },
};

const triggerClass =
  variant === 'dark'
    ? 'bg-white/[0.07] text-white/90 hover:bg-white/[0.11]'
    : 'bg-surface-muted text-ink/85 hover:bg-surface';

const menuClass =
  variant === 'dark'
    ? 'border border-line bg-ink/95 text-white shadow-[0_14px_35px_rgba(0,0,0,0.35)]'
    : 'border border-line bg-surface text-ink shadow-[0_12px_28px_rgba(13,44,63,0.12)]';

const itemClass =
  variant === 'dark'
    ? 'text-white/80 hover:bg-white/10 hover:text-white'
    : 'text-ink/80 hover:bg-surface-muted hover:text-ink';
---

<details class="relative">
  <summary
    class:list={[
      'flex list-none cursor-pointer items-center gap-1.5 rounded-[999px] px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-[0.14em] transition-colors marker:content-none',
      triggerClass,
    ]}
    aria-label="Language switcher"
  >
    <span class="text-sm leading-none">{localeMeta[locale].flag}</span>
    <span>{localeMeta[locale].label}</span>
  </summary>

  <div class:list={['absolute right-0 z-50 mt-2 min-w-[10rem] overflow-hidden rounded-xl p-1', menuClass]}>
    {locales.map((code) => {
      const href = switchLocalePath(pathname, code);
      const active = code === locale;
      return (
        <a
          href={href}
          hreflang={code}
          class:list={[
            'flex items-center gap-2 rounded-lg px-3 py-2 text-[11px] font-semibold transition-colors',
            itemClass,
            active && (variant === 'dark' ? 'bg-white/15 text-white' : 'bg-ink/10 text-ink'),
          ]}
          aria-current={active ? 'true' : undefined}
        >
          <span class="text-base leading-none">{localeMeta[code].flag}</span>
          <span>{localeMeta[code].label}</span>
        </a>
      );
    })}
  </div>
</details>
