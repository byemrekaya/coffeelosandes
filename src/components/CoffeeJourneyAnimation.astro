---
---
<section id="coffee-journey-animation" class="relative py-24 md:py-32 overflow-hidden" aria-hidden="true">
  <div class="section-shell relative">
    <div class="coffee-journey-track flex items-center justify-center gap-8 md:gap-16" data-coffee-track>
      <!-- Kiraz → Çekirdek → Kavrulmuş → Fincan -->
      <div class="coffee-step flex flex-col items-center gap-4" data-coffee-step="1">
        <div class="step-icon h-20 w-20 rounded-full border-2 border-terracotta/60 bg-terracotta/20 flex items-center justify-center">
          <svg class="h-10 w-10 text-terracotta" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <circle cx="12" cy="12" r="8" />
          </svg>
        </div>
        <span class="text-xs uppercase tracking-[0.2em] text-cream/60">Kiraz</span>
      </div>
      <div class="journey-line h-0.5 w-12 md:w-24 origin-left bg-gradient-to-r from-terracotta/40 to-bronze/40" data-coffee-line="1" />
      <div class="coffee-step flex flex-col items-center gap-4" data-coffee-step="2">
        <div class="step-icon h-20 w-20 rounded-full border-2 border-olive/60 bg-olive/20 flex items-center justify-center">
          <svg class="h-10 w-10 text-olive" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <ellipse cx="12" cy="12" rx="6" ry="8" />
          </svg>
        </div>
        <span class="text-xs uppercase tracking-[0.2em] text-cream/60">Çekirdek</span>
      </div>
      <div class="journey-line h-0.5 w-12 md:w-24 origin-left bg-gradient-to-r from-bronze/40 to-gold/40" data-coffee-line="2" />
      <div class="coffee-step flex flex-col items-center gap-4" data-coffee-step="3">
        <div class="step-icon h-20 w-20 rounded-full border-2 border-bronze/60 bg-bronze/20 flex items-center justify-center">
          <svg class="h-10 w-10 text-bronze" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <ellipse cx="12" cy="12" rx="6" ry="8" />
          </svg>
        </div>
        <span class="text-xs uppercase tracking-[0.2em] text-cream/60">Kavurma</span>
      </div>
      <div class="journey-line h-0.5 w-12 md:w-24 origin-left bg-gradient-to-r from-gold/40 to-cream/30" data-coffee-line="3" />
      <div class="coffee-step flex flex-col items-center gap-4" data-coffee-step="4">
        <div class="step-icon h-20 w-20 rounded-full border-2 border-gold/60 bg-gold/20 flex items-center justify-center">
          <svg class="h-10 w-10 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 8h10v6H6z" />
            <path d="M16 10h2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-2" />
          </svg>
        </div>
        <span class="text-xs uppercase tracking-[0.2em] text-cream/60">Fincan</span>
      </div>
    </div>
    <p class="mt-8 text-center text-sm text-cream/50" data-coffee-copy>
      Kahvenin yolculuğu — Venezüella plantasyonlarından B2B ortaklarınıza
    </p>
  </div>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    if (typeof window !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
    }

    function initCoffeeJourney() {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReduced) return;

      const track = document.querySelector('[data-coffee-track]');
      const steps = document.querySelectorAll('[data-coffee-step]');
      const lines = document.querySelectorAll('[data-coffee-line]');
      const copy = document.querySelector('[data-coffee-copy]');
      const section = document.getElementById('coffee-journey-animation');

      if (!track || !section) return;

      gsap.set([...steps, ...lines, copy], { opacity: 0, scale: 0.8 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 75%',
          end: 'top 25%',
          toggleActions: 'play none none reverse',
        },
      });

      steps.forEach((step, i) => {
        tl.to(step, { opacity: 1, scale: 1, duration: 0.5, ease: 'back.out(1.2)' }, i * 0.15);
        if (lines[i]) {
          tl.fromTo(lines[i], { scaleX: 0 }, { scaleX: 1, duration: 0.4, ease: 'power2.out' }, i * 0.15 + 0.2);
        }
      });
      tl.to(copy, { opacity: 1, duration: 0.5 }, '-=0.2');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCoffeeJourney);
    } else {
      initCoffeeJourney();
    }
  </script>
</section>
