---
import { products } from '../data/products';
import ProductCard from './ProductCard.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  featuredOnly?: boolean;
  eyebrow?: string;
  title?: string;
  description?: string;
}

const { featuredOnly = false, eyebrow, title, description } = Astro.props;

const list = featuredOnly ? products.filter((p) => p.isFeatured) : products;
---

<section class="mt-24" data-reveal>
  <div class="section-shell space-y-10">
    {(title || eyebrow || description) && (
      <SectionHeader
        eyebrow={eyebrow}
        title={title ?? 'Kahve Portföyü'}
        description={description}
      />
    )}

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {list.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  </div>
</section>

