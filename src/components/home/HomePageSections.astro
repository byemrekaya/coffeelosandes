<style is:global>
  [data-category-filter-root] .home-filter-pill-dot,
  [data-master-filter-root] .home-filter-pill-dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: linear-gradient(145deg, #c5d4b8 0%, #8fa68a 100%);
    box-shadow:
      0 0 0 1px rgba(77, 107, 82, 0.35),
      0 1px 4px rgba(15, 38, 28, 0.25);
    opacity: 0;
    transform: scale(0.45);
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }

  [data-category-filter-root] .home-filter-pill-btn[aria-pressed='true'] .home-filter-pill-dot,
  [data-master-filter-root] .home-filter-pill-btn[aria-pressed='true'] .home-filter-pill-dot {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-category-filter-root] .home-filter-pill-btn,
    [data-master-filter-root] .home-filter-pill-btn {
      transform: none !important;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  function applyClasses(el: Element, list: string, add: boolean) {
    const classes = list.split(' ').map((v) => v.trim()).filter(Boolean);
    if (!classes.length) return;
    el.classList[add ? 'add' : 'remove'](...classes);
  }

  function initCategoryFilter() {
    const root = document.querySelector('[data-category-filter-root]');
    if (!root) return;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const buttons = Array.from(root.querySelectorAll<HTMLElement>('[data-category-tab]'));
    const cardsRoot = document.querySelector('[data-category-cards]');
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-segment-panel]'));
    const cards = cardsRoot
      ? Array.from(cardsRoot.querySelectorAll<HTMLElement>('[data-category-card][data-segment]'))
      : [];
    if (!buttons.length || !cards.length) return;

    const setActive = (segment: string, opts?: { skipClear?: boolean }) => {
      buttons.forEach((btn) => {
        const tab = btn.getAttribute('data-category-tab');
        const isActive = tab === segment;
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        applyClasses(btn, btn.getAttribute('data-active-classes') ?? '', false);
        applyClasses(btn, btn.getAttribute('data-inactive-classes') ?? '', false);
        if (isActive) {
          applyClasses(btn, btn.getAttribute('data-active-classes') ?? '', true);
        } else {
          applyClasses(btn, btn.getAttribute('data-inactive-classes') ?? '', true);
        }
      });

      panels.forEach((panel) => {
        const pid = panel.getAttribute('data-segment-panel');
        panel.classList.toggle('hidden', pid !== segment);
      });

      cards.forEach((card) => {
        const sid = card.getAttribute('data-segment');
        const match = sid === segment;
        card.classList.toggle('hidden', !match);
        if (match && !opts?.skipClear) {
          gsap.killTweensOf(card);
          gsap.set(card, { clearProps: 'opacity,transform,scale' });
        }
      });

      if (prefersReduced) {
        cards.forEach((card) => {
          if (card.getAttribute('data-segment') === segment) {
            gsap.set(card, { opacity: 1, y: 0, scale: 1 });
          }
        });
        return;
      }

      const activePanel = panels.find((p) => p.getAttribute('data-segment-panel') === segment);
      const activeCards = cards.filter((c) => c.getAttribute('data-segment') === segment);

      if (activePanel) {
        gsap.fromTo(
          activePanel,
          { opacity: 0, y: 10 },
          { opacity: 1, y: 0, duration: 0.3, ease: 'power2.out', overwrite: 'auto' }
        );
      }

      if (activeCards.length) {
        gsap.fromTo(
          activeCards,
          { opacity: 0, y: 18, scale: 0.985 },
          { opacity: 1, y: 0, scale: 1, duration: 0.42, stagger: 0.06, ease: 'power2.out', overwrite: 'auto' }
        );
      }
    };

    const initial = buttons[0]?.getAttribute('data-category-tab');
    if (initial) setActive(initial, { skipClear: true });

    root.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      const btn = t.closest('[data-category-tab]');
      if (!btn || !root.contains(btn)) return;
      const segment = btn.getAttribute('data-category-tab');
      if (segment) setActive(segment);
    });
  }

  function initCategoryCardsAnimation() {
    if (typeof document === 'undefined') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const root = document.querySelector('[data-category-cards]');
    if (!root) return;

    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-category-card]')).filter(
      (el) => !el.classList.contains('hidden')
    );
    const cta = document.querySelector<HTMLElement>('[data-category-cta]');
    if (!cards.length) return;

    gsap.set(cards, { opacity: 0, y: 48, scale: 0.94, transformOrigin: 'center bottom' });
    if (cta) gsap.set(cta, { opacity: 0, y: 20 });

    let played = false;
    let obs: IntersectionObserver;
    const runReveal = () => {
      if (played) return;
      played = true;
      obs.disconnect();
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
      tl.to(cards, {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.75,
        stagger: 0.06,
        force3D: true,
      }).to(cta, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' }, '-=0.35');
    };

    obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) runReveal();
        });
      },
      { threshold: 0, rootMargin: '0px 0px 24% 0px' }
    );
    obs.observe(root);

    const tryRevealIfVisible = () => {
      const rect = root.getBoundingClientRect();
      const vh = window.innerHeight;
      if (rect.top < vh && rect.bottom > 0) runReveal();
    };
    requestAnimationFrame(tryRevealIfVisible);
    setTimeout(tryRevealIfVisible, 350);
  }

  function initMasterFilter() {
    const root = document.querySelector('[data-master-filter-root]');
    if (!root) return;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const buttons = Array.from(root.querySelectorAll<HTMLElement>('[data-master-tab]'));
    const cardsRoot = document.querySelector('[data-master-cards]');
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-master-panel]'));
    const cards = cardsRoot
      ? Array.from(cardsRoot.querySelectorAll<HTMLElement>('[data-master-card][data-master-segment]'))
      : [];
    if (!buttons.length || !cards.length) return;

    const setActive = (segment: string, opts?: { skipClear?: boolean }) => {
      buttons.forEach((btn) => {
        const tab = btn.getAttribute('data-master-tab');
        const isActive = tab === segment;
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        applyClasses(btn, btn.getAttribute('data-active-classes') ?? '', false);
        applyClasses(btn, btn.getAttribute('data-inactive-classes') ?? '', false);
        if (isActive) {
          applyClasses(btn, btn.getAttribute('data-active-classes') ?? '', true);
        } else {
          applyClasses(btn, btn.getAttribute('data-inactive-classes') ?? '', true);
        }
      });

      panels.forEach((panel) => {
        const pid = panel.getAttribute('data-master-panel');
        panel.classList.toggle('hidden', pid !== segment);
      });

      cards.forEach((card) => {
        const sid = card.getAttribute('data-master-segment');
        const match = sid === segment;
        card.classList.toggle('hidden', !match);
        if (match && !opts?.skipClear) {
          gsap.killTweensOf(card);
          gsap.set(card, { clearProps: 'opacity,transform,scale' });
        }
      });

      if (prefersReduced) {
        cards.forEach((card) => {
          if (card.getAttribute('data-master-segment') === segment) {
            gsap.set(card, { opacity: 1, y: 0, scale: 1 });
          }
        });
        return;
      }

      const activePanel = panels.find((p) => p.getAttribute('data-master-panel') === segment);
      const activeCards = cards.filter((c) => c.getAttribute('data-master-segment') === segment);

      if (activePanel) {
        gsap.fromTo(
          activePanel,
          { opacity: 0, y: 10 },
          { opacity: 1, y: 0, duration: 0.3, ease: 'power2.out', overwrite: 'auto' }
        );
      }

      if (activeCards.length) {
        gsap.fromTo(
          activeCards,
          { opacity: 0, y: 18, scale: 0.985 },
          { opacity: 1, y: 0, scale: 1, duration: 0.42, stagger: 0.06, ease: 'power2.out', overwrite: 'auto' }
        );
      }
    };

    const initial = buttons[0]?.getAttribute('data-master-tab');
    if (initial) setActive(initial, { skipClear: true });

    root.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      const btn = t.closest('[data-master-tab]');
      if (!btn || !root.contains(btn)) return;
      const segment = btn.getAttribute('data-master-tab');
      if (segment) setActive(segment);
    });
  }

  function initMasterCardsAnimation() {
    if (typeof document === 'undefined') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const root = document.querySelector('[data-master-cards]');
    if (!root) return;

    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-master-card]')).filter(
      (el) => !el.classList.contains('hidden')
    );
    const cta = document.querySelector<HTMLElement>('[data-master-cta]');
    if (!cards.length) return;

    gsap.set(cards, { opacity: 0, y: 48, scale: 0.94, transformOrigin: 'center bottom' });
    if (cta) gsap.set(cta, { opacity: 0, y: 20 });

    let played = false;
    let obs: IntersectionObserver;
    const runReveal = () => {
      if (played) return;
      played = true;
      obs.disconnect();
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
      tl.to(cards, {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.75,
        stagger: 0.06,
        force3D: true,
      }).to(cta, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' }, '-=0.35');
    };

    obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) runReveal();
        });
      },
      { threshold: 0, rootMargin: '0px 0px 24% 0px' }
    );
    obs.observe(root);

    const tryRevealIfVisible = () => {
      const rect = root.getBoundingClientRect();
      const vh = window.innerHeight;
      if (rect.top < vh && rect.bottom > 0) runReveal();
    };
    requestAnimationFrame(tryRevealIfVisible);
    setTimeout(tryRevealIfVisible, 350);
  }

  function run() {
    initCategoryFilter();
    initCategoryCardsAnimation();
    initMasterFilter();
    initMasterCardsAnimation();
  }

  document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', run) : run();
</script>

