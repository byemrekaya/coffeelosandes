---
import { Image } from 'astro:assets';
import type { Locale } from '../../i18n/types';
import type { HomeExtendedShape } from '../../i18n/homeExtended';
import { resolveLocale } from '../../i18n/config';
import { getLocalizedDictionary } from '../../i18n/localizedDictionary';
import { t } from '../../i18n/t';
import { withLang } from '../../i18n/paths';
import { HOME_PORTFOLIO_CATEGORY_ORDER, HOME_PORTFOLIO_CUPPING_BAR_PCT } from '../../data/homePortfolioByCategory';

interface Props {
  locale: Locale;
}

const { locale: localeProp } = Astro.props;
const locale = resolveLocale(localeProp as string | undefined);
const dict = getLocalizedDictionary(locale);
const hx = dict.homeExtended as HomeExtendedShape;

---

<section id="hikayemiz" class="section-band-b anchor-target scroll-mt-28 border-t border-line/60 py-20 md:py-28" data-reveal>
  <div class="section-shell">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-[#6f7f5f]">{hx.storyEyebrow}</p>
      <h2 class="font-display text-[clamp(2rem,4vw,2.75rem)] font-semibold tracking-tight text-heading">
        {hx.storySectionTitle}
      </h2>
      <p class="mt-3 text-[17px] font-medium text-[#4a4540] md:text-lg">{hx.storyLead}</p>
    </div>

    <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-start">
      <div class="min-w-0 lg:pr-2">
        <div class="max-w-prose space-y-6 text-[16px] font-medium leading-[1.85] text-[#5a564f]">
          {hx.storyParagraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>

        <ul class="mt-8 space-y-3 text-[14px] font-semibold text-[#4a4540]">
          {hx.storyHighlights.map((b) => (
            <li class="flex gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-heading/55" aria-hidden="true" />
              <span>{b}</span>
            </li>
          ))}
        </ul>

        <div class="mt-9 rounded-2xl border border-heading/10 bg-heading/[0.04] p-6">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-heading/75">{hx.storyNote.title}</p>
          <p class="mt-3 text-[15px] leading-relaxed text-heading/90">
            <span class="font-semibold">“</span>
            {hx.storyNote.body}
            <span class="font-semibold">”</span>
          </p>
        </div>
      </div>
      <div class="min-w-0">
        <div class="flex justify-center lg:justify-end">
          <Image
            src="/coffee-farm-about.webp"
            alt={hx.storyImageAlt}
            width="1100"
            height="1400"
            class="h-auto max-h-[min(460px,70vw)] w-auto max-w-[min(100%,520px)] object-contain object-center lg:max-h-[520px] lg:max-w-[520px]"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-4 sm:mt-14 lg:grid-cols-4 lg:gap-5">
      {hx.stats.map((s) => (
        <div class="rounded-[22px] border border-[#e7dfd3] bg-[#fbfaf7] px-6 py-6 text-left shadow-[0_14px_40px_rgba(40,96,63,0.04)] transition-transform duration-300 hover:-translate-y-[1px]">
          <p class="font-display text-[2.05rem] font-semibold leading-none text-heading">{s.value}</p>
          <div class="mt-3 h-px w-12 bg-heading/12" aria-hidden="true"></div>
          <p class="mt-3 text-[11px] font-semibold uppercase tracking-[0.16em] text-[#6f7f5f]">{s.label}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:mt-12 sm:flex-row sm:flex-wrap sm:gap-4">
      <a
        href={withLang('/about#biz-kimiz', locale)}
        class="inline-flex w-full max-w-sm items-center justify-center rounded-full border border-heading/18 bg-heading px-7 py-3.5 text-center text-[11px] font-semibold uppercase tracking-[0.2em] text-nav-cream shadow-[0_10px_32px_rgba(40,96,63,0.12)] transition hover:bg-heading/92 sm:w-auto sm:max-w-none"
      >
        {hx.storyWhoWeAreCtaLabel}
      </a>
      <a
        href={withLang('/about#venezuela-hikaye', locale)}
        class="inline-flex w-full max-w-sm items-center justify-center rounded-full border border-heading/18 bg-white px-7 py-3.5 text-center text-[11px] font-semibold uppercase tracking-[0.2em] text-heading shadow-[0_10px_32px_rgba(40,96,63,0.06)] transition hover:border-heading/32 hover:bg-[#fbfaf7] sm:w-auto sm:max-w-none"
      >
        {hx.storyAboutCtaLabel}
      </a>
    </div>
  </div>
</section>

<section id="bolgelerimiz" class="section-band-a anchor-target scroll-mt-28 border-t border-line/60 py-20 md:py-28" data-reveal>
  <div class="section-shell">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-[clamp(2rem,4vw,2.75rem)] font-semibold tracking-tight text-heading">{hx.regionsTitle}</h2>
      <p class="mt-3 text-[17px] text-[#5f5b55] md:text-lg">{hx.regionsSubtitle}</p>
    </div>
    <div class="mt-14 grid gap-8 lg:grid-cols-3">
      {hx.regions.map((region, idx) => {
        const [titleMain, titleSubRaw] = region.title.split('—');
        const titleSub = titleSubRaw?.trim();
        const cardImageSrc =
          idx === 0 ? '/venezuela-sales.webp' : idx === 1 ? '/europe-sales.webp' : '/middle-east-sales.webp';

        return (
          <article class="group relative flex h-full flex-col overflow-hidden rounded-[28px] border border-[#e7dfd3] bg-[#fbfaf7] shadow-[0_14px_50px_rgba(40,96,63,0.05)] transition-transform duration-300 hover:-translate-y-1">
            <div class="relative flex h-44 items-center justify-center overflow-hidden bg-white sm:h-48">
              <Image
                src={cardImageSrc}
                alt={region.title}
                width="1200"
                height="700"
                class="h-full w-full max-h-full max-w-full object-contain object-center transition-transform duration-500 group-hover:scale-[1.02]"
                loading="lazy"
              />
              <div
                class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_top,rgba(15,38,28,0.12),transparent_55%)]"
                aria-hidden="true"
              />
            </div>

            <div class="flex flex-1 flex-col p-8">
              <header>
                <h3 class="font-display text-[1.3rem] font-semibold tracking-tight text-heading">{titleMain.trim()}</h3>
                {titleSub ? (
                  <p class="mt-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-[#6f7f5f]">{titleSub}</p>
                ) : null}
              </header>

              <p class="mt-4 text-[15px] leading-relaxed text-[#5a564f]">{region.body}</p>

              <ul class="mt-6 space-y-2.5 text-[14px] font-medium text-[#4a4540]">
                {region.bullets.slice(0, 4).map((b) => (
                  <li class="flex gap-2.5">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-heading/55" aria-hidden="true" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<section id="kalite" class="section-band-b anchor-target scroll-mt-28 border-t border-line/60 py-20 md:py-28" data-reveal>
  <div class="section-shell">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-[clamp(2rem,4vw,2.75rem)] font-semibold tracking-tight text-heading">{hx.qualityProcessTitle}</h2>
      <p class="mt-3 text-[17px] text-[#5f5b55] md:text-lg">{hx.qualityProcessSubtitle}</p>
    </div>

    <div class="relative mt-14">
      {/* Horizontal flow (desktop) */}
      <div
        class="pointer-events-none absolute left-10 right-10 top-[22px] hidden h-px bg-heading/25 lg:block"
        aria-hidden="true"
      />
      <div
        class="pointer-events-none absolute left-10 right-10 top-[22px] hidden h-px bg-[repeating-linear-gradient(to_right,rgba(40,96,63,0.22)_0,rgba(40,96,63,0.22)_10px,transparent_10px,transparent_22px)] lg:block"
        aria-hidden="true"
      />

      {/* Vertical flow (mobile/tablet) */}
      <div class="pointer-events-none absolute left-6 top-6 hidden h-[calc(100%-3rem)] w-px bg-heading/12 sm:block lg:hidden" aria-hidden="true" />

      <ol class="grid gap-6 sm:gap-7 lg:grid-cols-4 lg:items-stretch lg:gap-7">
        {hx.processSteps.map((step, i) => {
          const n = i + 1;

          return (
            <li class="relative flex h-full flex-col">
              {/* Flow marker */}
              <div class="absolute left-0 top-0 flex h-11 w-11 items-center justify-center sm:left-0 lg:left-1/2 lg:-translate-x-1/2">
                <div class="flex h-11 w-11 items-center justify-center rounded-full bg-heading shadow-[0_14px_40px_rgba(40,96,63,0.14)] ring-1 ring-white/15">
                  <span class="font-display text-[15px] font-semibold text-white">{n}</span>
                </div>
              </div>

              <article class="group flex h-full min-h-[260px] flex-col rounded-[24px] border border-[#e7dfd3] bg-[linear-gradient(180deg,#fbfaf7_0%,#ffffff_100%)] px-6 pb-6 pt-16 shadow-[0_14px_45px_rgba(40,96,63,0.04)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_60px_rgba(40,96,63,0.085)] lg:min-h-[300px]">
                <h3 class="font-display text-[1.05rem] font-semibold leading-snug tracking-tight text-heading md:text-lg">
                  {step.title}
                </h3>
                <p class="mt-4 flex-1 text-[14px] leading-[1.7] text-[#5f5b55]">{step.desc}</p>
              </article>
            </li>
          );
        })}
      </ol>
    </div>

    {/* Trust bar */}
    <div class="mx-auto mt-10 max-w-5xl">
      <div class="rounded-[24px] bg-heading px-5 py-5 text-white shadow-[0_18px_60px_rgba(40,96,63,0.18)]">
        <div class="flex flex-wrap items-center justify-center gap-3 text-center">
          <span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-white/85">{t(locale, 'home.qualitySectionTitle')}</span>
          <span class="hidden h-4 w-px bg-white/20 sm:inline-block" aria-hidden="true" />
          <span class="rounded-full bg-white/10 px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/90 ring-1 ring-white/15">
            SGS
          </span>
          <span class="rounded-full bg-white/10 px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/90 ring-1 ring-white/15">
            Q Grader
          </span>
          <span class="rounded-full bg-white/10 px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/90 ring-1 ring-white/15">
            INSAI
          </span>
          <a
            href={withLang('/quality', locale)}
            class="ml-1 inline-flex items-center justify-center rounded-full bg-white px-5 py-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-heading shadow-[0_12px_28px_rgba(0,0,0,0.12)] transition hover:-translate-y-[1px] hover:bg-[#fffdf7]"
          >
            {t(locale, 'home.qualitySectionTitle')}
          </a>
        </div>
      </div>
      <p class="mx-auto mt-3 max-w-4xl text-center text-[13px] leading-relaxed text-[#7b756d]">
        {t(locale, 'home.qualitySectionIntro')}
      </p>
    </div>
  </div>
</section>

<section
  id="urun-portfoy"
  class="section-band-a anchor-target scroll-mt-28 border-t border-line/60 py-20 md:py-32 revealed"
  data-reveal
>
  <div class="section-shell">
    <div class="mx-auto max-w-3xl text-center lg:mx-0 lg:max-w-2xl lg:text-left">
      <span class="mb-3 block text-[11px] font-semibold uppercase tracking-[0.28em] text-[#6f7f5f]">{t(locale, 'products.eyebrow')}</span>
      <h2 class="font-display text-[clamp(2.35rem,4.6vw,3.35rem)] font-semibold tracking-tight text-heading">{hx.portfolioSectionTitle}</h2>
      <p class="mt-5 text-[17px] leading-[1.7] text-[#5f5b55] md:text-lg">{hx.portfolioSectionSubtitle}</p>
    </div>

    <div
      class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-7 lg:mt-16 lg:grid-cols-3 lg:gap-8"
      aria-label={hx.portfolioSectionTitle}
    >
      {HOME_PORTFOLIO_CATEGORY_ORDER.map((catId) => {
        const cat = hx.portfolioCategories[catId];
        const barPct = HOME_PORTFOLIO_CUPPING_BAR_PCT[catId];
        const tierName = hx.portfolioQualityTierName[catId];
        const isTopSegment = catId === 'competition-lot' || catId === 'micro-lot';
        const isMixed = catId === 'mixed';
        const cardSurface = isTopSegment
          ? 'bg-[linear-gradient(168deg,#fff8f2_0%,#fffdfb_36%,#ede8df_100%)] shadow-[0_1px_0_rgba(255,255,255,0.93)_inset,0_14px_42px_rgba(40,96,63,0.1),0_3px_10px_rgba(60,45,30,0.05)] ring-heading/20'
          : 'bg-[linear-gradient(165deg,#fffefb_0%,#ffffff_42%,#f3f1ed_100%)] shadow-[0_1px_0_rgba(255,255,255,0.88)_inset,0_12px_36px_rgba(22,48,38,0.07),0_2px_8px_rgba(22,48,38,0.04)] ring-stone-300/40';
        return (
          <a
            href={withLang(`/portfolio/${catId}`, locale)}
            class:list={[
              'portfolio-nav-card group relative flex h-full min-h-[308px] cursor-pointer flex-col overflow-hidden rounded-[20px] p-7 text-left ring-1 transition-[transform,box-shadow,ring-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] motion-safe:hover:-translate-y-[8px] motion-safe:active:scale-[0.992] motion-safe:hover:shadow-[0_1px_0_rgba(255,255,255,0.95)_inset,0_28px_56px_rgba(22,48,38,0.16),0_10px_24px_rgba(22,48,38,0.08)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-heading/35 focus-visible:ring-offset-2 md:min-h-[316px] md:p-8',
              cardSurface,
              isTopSegment && 'motion-safe:hover:ring-heading/28',
              !isTopSegment && 'motion-safe:hover:ring-stone-300/55',
            ]}
          >
            <div
              class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-heading/25 to-transparent"
              aria-hidden="true"
            />
            <div
              class:list={[
                'pointer-events-none absolute rounded-full blur-2xl',
                isTopSegment ? '-right-14 -top-24 h-44 w-44 bg-amber-900/[0.06]' : '-right-16 -top-20 h-40 w-40 bg-heading/[0.045]',
              ]}
              aria-hidden="true"
            />
            <div class="relative z-10 flex flex-1 flex-col">
              <h3 class="font-display text-[1.22rem] font-semibold leading-snug tracking-tight text-heading md:text-[1.3rem]">{cat.title}</h3>
              <div class="mt-2.5 flex flex-row flex-wrap items-center gap-2">
                <span
                  class:list={[
                    'inline-flex w-fit rounded-full border px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.14em]',
                    isTopSegment
                      ? 'border-amber-900/18 bg-amber-50/50 text-[#4a3d30]'
                      : isMixed
                        ? 'border-heading/30 bg-heading/[0.12] text-heading'
                        : 'border-heading/15 bg-heading/[0.06] text-heading/90',
                  ]}
                >
                  {tierName}
                </span>
                {isTopSegment ? (
                  <span class="inline-flex w-fit rounded-full border border-amber-900/15 bg-gradient-to-r from-amber-50/90 to-[#fff8f0] px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-[#5c4a38] shadow-sm ring-1 ring-amber-900/10">
                    {hx.portfolioTopSegmentRibbon}
                  </span>
                ) : isMixed ? (
                  <span class="inline-flex w-fit rounded-full border border-heading/25 bg-heading/[0.1] px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-heading shadow-sm ring-1 ring-heading/15">
                    {hx.portfolioMixedRibbon}
                  </span>
                ) : null}
              </div>
              <p class="mt-3 flex-1 text-[15px] leading-[1.65] text-[#5a564e]">{cat.desc}</p>
              {cat.scoreLine != null && barPct != null ? (
                <div class="mt-7">
                  <div
                    class="rounded-full bg-[linear-gradient(180deg,rgba(0,0,0,0.04)_0%,transparent_100%)] p-[3px] shadow-[inset_0_1px_2px_rgba(0,0,0,0.06)] ring-1 ring-stone-200/60"
                    aria-hidden="true"
                  >
                    <div class="h-2 overflow-hidden rounded-full bg-stone-100/95">
                      <div
                        class="portfolio-cupping-fill h-full rounded-full bg-gradient-to-r from-[#2a4f3e] via-heading to-[#4d8f6f]"
                        style={`--cup-pct: ${barPct}`}
                      />
                    </div>
                  </div>
                  <p class="mt-3 text-[14px] font-semibold leading-snug text-heading">{cat.scoreLine}</p>
                  {cat.qualityBandCaption != null ? (
                    <p class="mt-2 text-[11px] leading-relaxed text-stone-500">{cat.qualityBandCaption}</p>
                  ) : null}
                </div>
              ) : (
                <div class="mt-7 rounded-xl border border-stone-200/60 bg-stone-50/40 px-3 py-3 ring-1 ring-stone-100/80">
                  <p class="text-[12px] leading-relaxed text-stone-600">{hx.portfolioQualityFallbackNote}</p>
                </div>
              )}
              <div class="relative mt-8 border-t border-stone-200/40 pt-6">
                <span class="portfolio-explore-cta text-[15px] font-semibold tracking-wide text-heading transition-all duration-300 ease-out max-sm:opacity-100 sm:text-heading/45 sm:group-hover:text-heading sm:group-hover:translate-x-0.5">
                  <span class="relative inline-block pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-0 after:rounded-full after:bg-heading/70 after:transition-all after:duration-300 group-hover:after:w-full">
                    {hx.portfolioExploreCta}
                  </span>
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<section id="misyonumuz" class="section-band-b anchor-target scroll-mt-28 border-t border-line/60 py-20 md:py-28" data-reveal>
  <div class="section-shell">
    <div class="w-full text-center">
      <h2 class="font-display text-[clamp(1.85rem,3.5vw,2.75rem)] font-semibold tracking-tight text-heading">{hx.missionTitle}</h2>
      <p class="mx-auto mt-6 max-w-4xl text-[17px] leading-[1.72] text-[#5f5b55] md:max-w-5xl md:text-lg">{hx.missionBody}</p>
      <div class="mt-12 flex flex-wrap items-center justify-center gap-3 sm:gap-5 md:mt-14">
        {hx.missionPillars.map((p) => (
          <span class="rounded-full border border-heading/25 bg-paper/90 px-5 py-2 text-[12px] font-semibold uppercase tracking-[0.14em] text-heading shadow-sm">
            {p}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="toptan" class="anchor-target scroll-mt-28 relative min-h-[min(480px,78vh)] overflow-hidden border-t border-line/60" data-reveal>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <Image
      src="/coffee-cherries.webp"
      alt="Fresh coffee cherries from farm"
      class="h-full w-full object-cover object-center brightness-[1.05] saturate-[1.03]"
      loading="lazy"
      width="1920"
      height="1080"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/45 via-black/25 to-black/15"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(13,44,63,0.35),transparent_45%)]"></div>
  </div>

  <div class="section-shell relative z-10 flex min-h-[min(480px,78vh)] items-center py-16 md:py-24">
    <div class="max-w-xl">
      <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-heading">
        {t(locale, 'home.b2bCtaEyebrow')}
      </p>
      <h2 class="mt-4 font-display text-[clamp(1.85rem,4.5vw,2.75rem)] font-bold leading-[1.12] tracking-tight text-white drop-shadow-[0_2px_24px_rgba(0,0,0,0.35)]">
        {t(locale, 'home.b2bCtaTitle')}
      </h2>
      <p class="mt-5 font-sans text-[17px] leading-[1.65] text-white/95 md:text-lg">
        {t(locale, 'home.b2bCtaBody')}
      </p>
      <a href={withLang('/contact', locale)} class="btn-primary mt-10">
        {t(locale, 'home.b2bCtaButton')}
      </a>
    </div>
  </div>
</section>

<style is:global>
  #urun-portfoy .portfolio-cupping-fill {
    width: max(0%, calc(var(--cup-pct) * 1% - 4%));
    box-shadow: 0 0 0 rgba(52, 120, 90, 0);
    transition:
      width 0.7s cubic-bezier(0.33, 1, 0.68, 1),
      box-shadow 0.45s ease,
      filter 0.35s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    #urun-portfoy .portfolio-nav-card:hover .portfolio-cupping-fill {
      width: calc(var(--cup-pct) * 1%);
      box-shadow: 0 0 16px rgba(52, 120, 90, 0.32);
      filter: brightness(1.07);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #urun-portfoy .portfolio-nav-card {
      transition: none;
    }
    #urun-portfoy .portfolio-nav-card:hover,
    #urun-portfoy .portfolio-nav-card:active {
      transform: none;
    }
    #urun-portfoy .portfolio-cupping-fill {
      width: calc(var(--cup-pct) * 1%) !important;
      transition: none !important;
      box-shadow: none !important;
      filter: none !important;
    }
    #urun-portfoy .portfolio-explore-cta span::after {
      width: 100% !important;
      transition: none !important;
    }
  }
</style>
