---
import { Image } from 'astro:assets';
import type { Locale } from '../../i18n/types';
import type { HomeExtendedShape } from '../../i18n/homeExtended';
import { resolveLocale } from '../../i18n/config';
import { getLocalizedDictionary } from '../../i18n/localizedDictionary';
import { t } from '../../i18n/t';
import { withLang } from '../../i18n/paths';
import { HOME_PORTFOLIO_CATEGORY_ORDER, HOME_PORTFOLIO_CUPPING_BAR_PCT } from '../../data/homePortfolioByCategory';

interface Props {
  locale: Locale;
}

const { locale: localeProp } = Astro.props;
const locale = resolveLocale(localeProp as string | undefined);
const dict = getLocalizedDictionary(locale);
const hx = dict.homeExtended as HomeExtendedShape;

---

<section id="hikayemiz" class="section-band-b anchor-target scroll-mt-28 border-t border-line/60 py-20 md:py-28" data-reveal>
  <div class="section-shell">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-[#6f7f5f]">{hx.storyEyebrow}</p>
      <h2 class="font-display text-[clamp(2rem,4vw,2.75rem)] font-semibold tracking-tight text-heading">
        {hx.storySectionTitle}
      </h2>
      <p class="mt-3 text-[17px] font-medium text-[#4a4540] md:text-lg">{hx.storyLead}</p>
    </div>

    <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-start">
      <div class="min-w-0 lg:pr-2">
        <div class="max-w-prose space-y-6 text-[16px] font-medium leading-[1.85] text-[#5a564f]">
          {hx.storyParagraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>

        <ul class="mt-8 space-y-3 text-[14px] font-semibold text-[#4a4540]">
          {hx.storyHighlights.map((b) => (
            <li class="flex gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-heading/55" aria-hidden="true" />
              <span>{b}</span>
            </li>
          ))}
        </ul>

        <div class="mt-9 rounded-2xl border border-heading/10 bg-heading/[0.04] p-6">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-heading/75">{hx.storyNote.title}</p>
          <p class="mt-3 text-[15px] leading-relaxed text-heading/90">
            <span class="font-semibold">“</span>
            {hx.storyNote.body}
            <span class="font-semibold">”</span>
          </p>
        </div>
      </div>
      <div class="hidden min-w-0 lg:block">
        <div class="flex justify-center lg:justify-end">
          <Image
            src="/coffee-farm-about.webp"
            alt={hx.storyImageAlt}
            width="1100"
            height="1400"
            class="h-auto max-h-[min(460px,70vw)] w-auto max-w-[min(100%,520px)] object-contain object-center lg:max-h-[520px] lg:max-w-[520px]"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-4 sm:mt-14 lg:grid-cols-4 lg:gap-5">
      {hx.stats.map((s) => (
        <div class="rounded-[22px] border border-[#e7dfd3] bg-[#fbfaf7] px-6 py-6 text-left shadow-[0_14px_40px_rgba(40,96,63,0.04)] transition-transform duration-300 hover:-translate-y-[1px]">
          <p class="font-display text-[2.05rem] font-semibold leading-none text-heading">{s.value}</p>
          <div class="mt-3 h-px w-12 bg-heading/12" aria-hidden="true"></div>
          <p class="mt-3 text-[11px] font-semibold uppercase tracking-[0.16em] text-[#6f7f5f]">{s.label}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:mt-12 sm:flex-row sm:flex-wrap sm:gap-4">
      <a
        href={withLang('/about#biz-kimiz', locale)}
        class="inline-flex w-full max-w-sm items-center justify-center rounded-full border border-heading/18 bg-heading px-7 py-3.5 text-center text-[11px] font-semibold uppercase tracking-[0.2em] text-nav-cream shadow-[0_10px_32px_rgba(40,96,63,0.12)] transition hover:bg-heading/92 sm:w-auto sm:max-w-none"
      >
        {hx.storyWhoWeAreCtaLabel}
      </a>
      <a
        href={withLang('/about#venezuela-hikaye', locale)}
        class="inline-flex w-full max-w-sm items-center justify-center rounded-full border border-heading/18 bg-white px-7 py-3.5 text-center text-[11px] font-semibold uppercase tracking-[0.2em] text-heading shadow-[0_10px_32px_rgba(40,96,63,0.06)] transition hover:border-heading/32 hover:bg-[#fbfaf7] sm:w-auto sm:max-w-none"
      >
        {hx.storyAboutCtaLabel}
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     PRODUCT SHOWCASE — bean-to-package animasyonu
     ═══════════════════════════════════════════════════════════ -->
<section
  id="urunumuz"
  class="pkg-showcase anchor-target scroll-mt-28 relative overflow-hidden border-t border-line/60 py-20 md:py-32"
>
  {/* Canvas — bean partikülleri buraya çizilir (z-[5], içerik altında) */}
  <canvas id="pkg-canvas" class="pointer-events-none absolute inset-0 z-[5]" aria-hidden="true" />

  {/* ── Arkaplan ── */}
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(145deg,#0a1a10_0%,#0f2318_50%,#081409_100%)]" aria-hidden="true" />
  <div class="pointer-events-none absolute -left-32 top-1/2 h-[520px] w-[520px] -translate-y-1/2 rounded-full bg-[#28603f]/18 blur-[120px]" aria-hidden="true" />
  <div class="pointer-events-none absolute -right-24 bottom-0 h-[380px] w-[380px] rounded-full bg-[#28603f]/08 blur-[100px]" aria-hidden="true" />

  <div class="section-shell relative z-10">
    <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-20">

      {/* ── Sol — metin bloğu ── */}
      <div class="pkg-text flex flex-col items-start">
        <p class="text-[11px] font-semibold uppercase tracking-[0.32em] text-[#a8c89a]">
          {hx.productShowcaseEyebrow}
        </p>
        <h2 class="mt-4 font-display text-[clamp(2.2rem,4.5vw,3.2rem)] font-semibold leading-[1.1] tracking-tight text-white">
          {hx.productShowcaseTitle}
        </h2>
        <p class="mt-5 max-w-md text-[17px] leading-[1.7] text-white/70">
          {hx.productShowcaseSubtitle}
        </p>

        {/* Özellik pill'leri */}
        <div class="mt-8 flex flex-wrap gap-3">
          {hx.productShowcasePills.map((pill) => (
            <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.07] px-4 py-2 text-[12px] font-semibold uppercase tracking-[0.14em] text-white/85 backdrop-blur-sm ring-1 ring-inset ring-white/10">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#a8c89a]" aria-hidden="true" />
              {pill}
            </span>
          ))}
        </div>

        {/* Ayırıcı çizgi */}
        <div class="mt-10 h-px w-12 bg-gradient-to-r from-[#a8c89a]/60 to-transparent" aria-hidden="true" />

        {/* CTA */}
        <a
          href={withLang('/portfolio/roasted-coffee', locale)}
          class="mt-8 inline-flex items-center gap-3 rounded-full bg-white px-8 py-4 text-[11px] font-semibold uppercase tracking-[0.2em] text-heading shadow-[0_12px_40px_rgba(255,255,255,0.12)] transition-all duration-300 hover:-translate-y-[2px] hover:shadow-[0_18px_56px_rgba(255,255,255,0.18)]"
        >
          {hx.productShowcaseCta}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
        </a>
      </div>

      {/* ── Sağ — tek paket görseli ── */}
      <div class="pkg-visual flex items-center justify-center lg:justify-end">
        <div class="pkg-stage relative flex items-center justify-center">
          {/* Zemin gölgesi (elips) */}
          <div
            class="pointer-events-none absolute bottom-[-28px] left-1/2 h-[40px] w-[280px] -translate-x-1/2 rounded-full bg-black/40 blur-[20px]"
            aria-hidden="true"
          />
          {/* Halka parıltısı */}
          <div
            class="pointer-events-none absolute inset-[-24px] rounded-[40px] bg-[radial-gradient(ellipse_at_center,rgba(40,96,63,0.08)_0%,transparent_70%)]"
            aria-hidden="true"
          />

          {/* ── Tek paket görseli ── */}
          <div class="pkg-wrapper relative">
            <Image
              src="/losandes.coffee.package.jpeg"
              alt={hx.productShowcaseTitle}
              width="460"
              height="600"
              class="relative z-10 h-auto w-[260px] drop-shadow-[0_40px_80px_rgba(0,0,0,0.75)] sm:w-[320px] md:w-[380px] lg:w-[460px]"
              loading="lazy"
            />
          </div>

          {/* Badge — sağ üst */}
          <div class="pkg-badge absolute -right-4 top-4 z-30 flex flex-col items-center rounded-2xl border border-white/15 bg-white/[0.09] px-4 py-3 text-center backdrop-blur-md ring-1 ring-inset ring-white/10 sm:-right-8">
            <span class="font-display text-[1.4rem] font-semibold leading-none text-white">100%</span>
            <span class="mt-1 text-[9px] font-semibold uppercase tracking-[0.18em] text-[#c8a06a]">Arabica</span>
          </div>

          {/* Badge — sol alt */}
          <div class="pkg-badge-2 absolute -left-4 bottom-8 z-30 flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.09] px-4 py-2.5 backdrop-blur-md ring-1 ring-inset ring-white/10 sm:-left-8">
            <span class="h-2 w-2 rounded-full bg-[#c8a06a]" aria-hidden="true" />
            <span class="text-[10px] font-semibold uppercase tracking-[0.14em] text-white/80">Venezuela</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style is:global>
  /* ── JS aktifken paket + badge'leri gizle ── */
  .pkg-showcase.pkg-js-ready .pkg-wrapper {
    opacity: 0;
    transform: scale(0.88);
  }
  .pkg-showcase.pkg-js-ready .pkg-badge,
  .pkg-showcase.pkg-js-ready .pkg-badge-2 {
    opacity: 0;
    transform: scale(0.5);
  }

  /* ── Float animasyonu — reveal sonrası nazik sallanma ── */
  @keyframes pkg-float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-7px); }
  }
  .pkg-wrapper.pkg-floating {
    animation: pkg-float 4s ease-in-out infinite;
  }

  /* ── Text fade-in (tetikleyici: pkg-js-ready yokken data-reveal'dan bağımsız) ── */
  @media (prefers-reduced-motion: no-preference) {
    .pkg-showcase:not(.pkg-js-ready) .pkg-text {
      animation: pkg-txt-in 0.85s cubic-bezier(0.22,1,0.36,1) both;
    }
    @keyframes pkg-txt-in {
      from { opacity: 0; transform: translateX(-32px); }
      to   { opacity: 1; transform: translateX(0); }
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  function initBeanAnim() {
    const section = document.getElementById('urunumuz') as HTMLElement | null;
    if (!section) return;
    const canvas = document.getElementById('pkg-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const pkgStage   = section.querySelector<HTMLElement>('.pkg-stage');
    const pkgWrapper = section.querySelector<HTMLElement>('.pkg-wrapper');
    const pkgBadge   = section.querySelector<HTMLElement>('.pkg-badge');
    const pkgBadge2  = section.querySelector<HTMLElement>('.pkg-badge-2');

    if (!pkgStage || !pkgWrapper || !pkgBadge || !pkgBadge2) return;

    /* ── Reduced-motion fallback ── */
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    /* ── Mark section as JS-controlled ── */
    section.classList.add('pkg-js-ready');

    let cssW = 0, cssH = 0;
    let rafId: number | null = null;

    /* ── Canvas resize ── */
    function resizeCanvas() {
      const dpr = window.devicePixelRatio || 1;
      cssW = section!.offsetWidth;
      cssH = section!.offsetHeight;
      canvas!.width  = Math.round(cssW * dpr);
      canvas!.height = Math.round(cssH * dpr);
      canvas!.style.width  = cssW + 'px';
      canvas!.style.height = cssH + 'px';
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    /* ── Bean data ── */
    interface Bean {
      x: number; y: number; rotation: number; scale: number; opacity: number;
      vx: number; vy: number; vrotation: number; size: number;
      convX: number; convY: number; convRot: number;
      scatterX: number; scatterY: number;
    }
    const beans: Bean[] = [];

    function createBeans(
      pkgRect: { left: number; top: number; width: number; height: number }
    ) {
      beans.length = 0;
      const total = 24;
      const targetCX = pkgRect.left + pkgRect.width  / 2;
      const targetCY = pkgRect.top  + pkgRect.height / 2;

      for (let i = 0; i < total; i++) {
        const sx  = cssW * 0.05 + Math.random() * cssW * 0.90;
        const sy  = cssH * 0.04 + Math.random() * cssH * 0.92;
        const rot = Math.random() * Math.PI * 2;
        const dir = Math.random() > 0.5 ? 1 : -1;
        const sa  = Math.random() * Math.PI * 2;
        const sd  = 155 + Math.random() * 195;

        beans.push({
          x: sx, y: sy,
          rotation:  rot,
          scale:     0.5 + Math.random() * 0.85,
          opacity:   0,
          vx:        (Math.random() - 0.5) * 0.55,
          vy:        (Math.random() - 0.5) * 0.55,
          vrotation: (Math.random() - 0.5) * 0.024,
          size:      13 + Math.random() * 13,
          convX:    pkgRect.left + 0.1 * pkgRect.width  + Math.random() * 0.8 * pkgRect.width,
          convY:    pkgRect.top  + 0.1 * pkgRect.height + Math.random() * 0.8 * pkgRect.height,
          convRot:  rot + dir * (Math.PI * (4 + Math.random() * 2.5)),
          scatterX: targetCX + Math.cos(sa) * sd,
          scatterY: targetCY + Math.sin(sa) * sd,
        });
      }
    }

    /* ── Draw one coffee bean on canvas ── */
    function drawBean(b: Bean) {
      if (b.opacity < 0.006 || b.scale < 0.01) return;
      ctx!.save();
      ctx!.globalAlpha = Math.min(b.opacity, 1);
      ctx!.translate(b.x, b.y);
      ctx!.rotate(b.rotation);
      ctx!.scale(b.scale, b.scale);

      const w = b.size;
      const h = b.size * 1.62;

      /* Body */
      ctx!.beginPath();
      ctx!.ellipse(0, 0, w / 2, h / 2, 0, 0, Math.PI * 2);
      const g = ctx!.createLinearGradient(-w / 3, -h / 2, w / 3, h / 2);
      g.addColorStop(0,   'rgba(162, 98, 46, 0.93)');
      g.addColorStop(0.5, 'rgba(112, 60, 18, 0.96)');
      g.addColorStop(1,   'rgba(70,  36, 12, 0.90)');
      ctx!.fillStyle = g;
      ctx!.fill();

      /* Crease */
      ctx!.beginPath();
      ctx!.moveTo(0, -h / 2 + 2.5);
      ctx!.bezierCurveTo(w / 5.5, -h / 4, w / 5.5, h / 4, 0, h / 2 - 2.5);
      ctx!.strokeStyle = 'rgba(32, 14, 4, 0.55)';
      ctx!.lineWidth   = 1.5;
      ctx!.stroke();

      /* Highlight */
      ctx!.beginPath();
      ctx!.ellipse(-w / 7, -h / 6, w / 4.5, h / 7, -0.5, 0, Math.PI * 2);
      ctx!.fillStyle = 'rgba(235, 170, 100, 0.17)';
      ctx!.fill();

      ctx!.restore();
    }

    /* ── RAF draw loop ── */
    function rafLoop() {
      rafId = requestAnimationFrame(rafLoop);
      ctx!.clearRect(0, 0, cssW, cssH);
      for (let i = 0; i < beans.length; i++) drawBean(beans[i]);
    }

    /* ── Main animation timeline ── */
    function runTimeline() {
      resizeCanvas();

      /* Compute package bounds relative to section */
      const sr  = section!.getBoundingClientRect();
      const wrB = pkgWrapper!.getBoundingClientRect();

      const pkgRect = {
        left: wrB.left - sr.left, top: wrB.top - sr.top,
        width: wrB.width, height: wrB.height,
      };

      createBeans(pkgRect);
      rafLoop();

      /* Drift ticker (Phase 1) */
      let drifting = true;
      const driftFn = () => {
        if (!drifting) return;
        for (let i = 0; i < beans.length; i++) {
          const b = beans[i];
          b.x += b.vx; b.y += b.vy; b.rotation += b.vrotation;
          if (b.x < -40)       b.x = cssW + 40;
          if (b.x > cssW + 40) b.x = -40;
          if (b.y < -40)       b.y = cssH + 40;
          if (b.y > cssH + 40) b.y = -40;
        }
      };
      gsap.ticker.add(driftFn);

      const tl = gsap.timeline();

      /* Phase 1 (0 – 1.3s): beans drift and fade in across the section */
      tl.to(beans, {
        opacity: () => 0.38 + Math.random() * 0.50,
        duration: 0.95,
        stagger:  0.038,
        ease: 'power2.out',
      }, 0);

      /* Stop drift */
      tl.call(() => { drifting = false; gsap.ticker.remove(driftFn); }, null, 1.3);

      /* Phase 2 (1.3 – 2.65s): beans converge to the single package */
      tl.to(beans, {
        x:        (i: number) => beans[i].convX,
        y:        (i: number) => beans[i].convY,
        rotation: (i: number) => beans[i].convRot,
        scale:    0.25,
        opacity:  0.52,
        duration: 1.35,
        stagger:  { amount: 0.55, from: 'random' },
        ease: 'power3.in',
      }, 1.3);

      /* Phase 3 (2.45s): paket belirir */
      tl.fromTo(pkgWrapper,
        { opacity: 0, scale: 0.90, y: 10 },
        { opacity: 1, scale: 1,    y: 0,  duration: 1.10, ease: 'power2.out' },
        2.45
      );

      /* Phase 4 (2.68s): fasulyeler saçılıyor */
      tl.to(beans, {
        x:       (i: number) => beans[i].scatterX,
        y:       (i: number) => beans[i].scatterY,
        opacity: 0,
        scale:   0.07,
        duration: 0.65,
        stagger: { amount: 0.42, from: 'random' },
        ease: 'power2.in',
      }, 2.68);

      /* Badge'ler patlıyor */
      tl.to(pkgBadge,  { opacity: 1, scale: 1, duration: 0.65, ease: 'back.out(2.4)' }, 3.20);
      tl.to(pkgBadge2, { opacity: 1, scale: 1, duration: 0.65, ease: 'back.out(2.4)' }, 3.35);

      /* Cleanup (3.70s): canvas durdur, GSAP inline style'ları temizle, float başlat */
      tl.call(() => {
        if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
        ctx!.clearRect(0, 0, canvas!.width, canvas!.height);
        gsap.set(pkgWrapper!, { clearProps: 'transform,scale,y' });
        gsap.set(pkgBadge!,   { clearProps: 'transform,scale' });
        gsap.set(pkgBadge2!,  { clearProps: 'transform,scale' });
        section!.classList.remove('pkg-js-ready');
        /* Reveal sonrası nazif float hareketi */
        pkgWrapper!.classList.add('pkg-floating');
      }, null, 3.70);
    }

    /* ── IntersectionObserver trigger ── */
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            obs.disconnect();
            /* Layout yerleşmesi için kısa gecikme */
            setTimeout(runTimeline, 90);
          }
        });
      },
      { threshold: 0.25 }
    );
    obs.observe(section);
  }

  /* DOM hazır olduktan sonra çalıştır */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBeanAnim);
  } else {
    initBeanAnim();
  }
</script>

<section id="bolgelerimiz" class="section-band-a anchor-target scroll-mt-28 border-t border-line/60 py-20 md:py-28" data-reveal>
  <div class="section-shell">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-[clamp(2rem,4vw,2.75rem)] font-semibold tracking-tight text-heading">{hx.regionsTitle}</h2>
      <p class="mt-3 text-[17px] text-[#5f5b55] md:text-lg">{hx.regionsSubtitle}</p>
    </div>
    <div class="mt-14 grid gap-8 lg:grid-cols-3">
      {hx.regions.map((region, idx) => {
        const [titleMain, titleSubRaw] = region.title.split('—');
        const titleSub = titleSubRaw?.trim();
        const cardImageSrc =
          idx === 0 ? '/venezuela-sales.webp' : idx === 1 ? '/europe-sales.webp' : '/middle-east-sales.webp';

        return (
          <article class="group relative flex h-full flex-col overflow-hidden rounded-[28px] border border-[#e7dfd3] bg-[#fbfaf7] shadow-[0_14px_50px_rgba(40,96,63,0.05)] transition-transform duration-300 hover:-translate-y-1">
            <div class="relative flex h-44 items-center justify-center overflow-hidden bg-white sm:h-48">
              <Image
                src={cardImageSrc}
                alt={region.title}
                width="1200"
                height="700"
                class="h-full w-full max-h-full max-w-full object-contain object-center transition-transform duration-500 group-hover:scale-[1.02]"
                loading="lazy"
              />
              <div
                class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_top,rgba(15,38,28,0.12),transparent_55%)]"
                aria-hidden="true"
              />
            </div>

            <div class="flex flex-1 flex-col p-8">
              <header>
                <h3 class="font-display text-[1.3rem] font-semibold tracking-tight text-heading">{titleMain.trim()}</h3>
                {titleSub ? (
                  <p class="mt-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-[#6f7f5f]">{titleSub}</p>
                ) : null}
              </header>

              <p class="mt-4 text-[15px] leading-relaxed text-[#5a564f]">{region.body}</p>

              <ul class="mt-6 space-y-2.5 text-[14px] font-medium text-[#4a4540]">
                {region.bullets.slice(0, 4).map((b) => (
                  <li class="flex gap-2.5">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-heading/55" aria-hidden="true" />
                    <span>{b}</span>
                  </li>
