---
import SectionHeader from '../SectionHeader.astro';
import type { Locale } from '../../i18n/types';
import { resolveLocale } from '../../i18n/config';
import { t } from '../../i18n/t';
import { withLang } from '../../i18n/paths';
import { dictionary } from '../../i18n/dictionary';
import { coffeeLots } from '../../data/coffeeLots';
import { localizeCoffeeLots } from '../../i18n/localizeLot';
import CoffeeLotCard from '../coffee/CoffeeLotCard.astro';
import StorySpotlightImage from './StorySpotlightImage.astro';

interface Props {
  locale: Locale;
}

const { locale: localeProp } = Astro.props;
const locale = resolveLocale(localeProp as string | undefined);

const homeStory = dictionary[locale].homeStory as {
  eyebrow: string;
  tagline: string;
  title: string;
  body: string;
  paragraphs: string[];
  knowMore: string;
};
const brandValues = (dictionary[locale].brandValues ?? []) as { title: string; body: string }[];
const homeDict = dictionary[locale].home as Record<string, unknown>;
const productsDict = dictionary[locale].products as Record<string, unknown>;
const retailSpecLines = (productsDict.retailSpecLines ?? []) as string[];
const localizedLots = localizeCoffeeLots(coffeeLots, locale);

const segmentDefs = [
  {
    id: 'competition-lots',
    label: t(locale, 'products.segmentLabelCompetition'),
    title: t(locale, 'products.segmentCompetitionTitle'),
    desc: t(locale, 'products.segmentCompetitionDesc'),
  },
  {
    id: 'premium-microlot',
    label: t(locale, 'products.segmentLabelMicro'),
    title: t(locale, 'products.segmentMicroTitle'),
    desc: t(locale, 'products.segmentMicroDesc'),
  },
  {
    id: 'specialty-series',
    label: t(locale, 'products.segmentLabelSpecialty'),
    title: t(locale, 'products.segmentSpecialtyTitle'),
    desc: t(locale, 'products.segmentSpecialtyDesc'),
  },
  {
    id: 'barista-blend',
    label: t(locale, 'products.segmentLabelBarista'),
    title: t(locale, 'products.segmentBaristaTitle'),
    desc: t(locale, 'products.segmentBaristaDesc'),
  },
  {
    id: 'commercial',
    label: t(locale, 'products.segmentLabelCommercial'),
    title: t(locale, 'products.segmentCommercialTitle'),
    desc: t(locale, 'products.segmentCommercialDesc'),
  },
  {
    id: 'retail',
    label: t(locale, 'products.segmentLabelRetail'),
    title: t(locale, 'products.segmentRoastedTitle'),
    desc: t(locale, 'products.segmentRoastedDesc'),
  },
] as const;

const defaultSegment = segmentDefs[0].id;

const farmToRoasteryFlow = [
  {
    title: t(locale, 'home.flowStep1Title'),
    body: t(locale, 'home.flowStep1Body'),
    icon: 'harvest',
  },
  {
    title: t(locale, 'home.flowStep2Title'),
    body: t(locale, 'home.flowStep2Body'),
    icon: 'shipment',
  },
  {
    title: t(locale, 'home.flowStep3Title'),
    body: t(locale, 'home.flowStep3Body'),
    icon: 'storage',
  },
  {
    title: t(locale, 'home.flowStep4Title'),
    body: t(locale, 'home.flowStep4Body'),
    icon: 'roastery',
  },
] as const;
---

<section class="border-y border-line/80 bg-paper py-14 md:py-16" data-reveal>
  <div class="section-shell">
    <p class="stage-eyebrow">{t(locale, 'home.wholesaleEyebrow')}</p>
    <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-ink md:text-[2.25rem]">
      {t(locale, 'home.flowTitle')}
    </h2>
    <div class="relative mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <div class="pointer-events-none absolute left-10 right-10 top-[2.35rem] hidden h-px bg-gradient-to-r from-transparent via-gold/55 to-transparent xl:block" aria-hidden="true"></div>
      {farmToRoasteryFlow.map((step, idx) => (
        <article class="glass-panel relative overflow-hidden px-6 py-6 transition-transform duration-300 hover:-translate-y-0.5">
          <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold/65 to-transparent" aria-hidden="true"></div>
          <p class="absolute right-5 top-4 text-[11px] font-semibold uppercase tracking-[0.16em] text-ink/35">
            {String(idx + 1).padStart(2, '0')}
          </p>
          <div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-lg border border-gold/45 bg-gold/15 text-ink shadow-soft-gold">
            {step.icon === 'harvest' && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M7 21v-7a5 5 0 0 1 10 0v7" stroke-linecap="round" />
                <circle cx="12" cy="7" r="3" />
              </svg>
            )}
            {step.icon === 'shipment' && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M3 7h12v9H3zM15 10h3l3 3v3h-6z" stroke-linejoin="round" />
                <circle cx="8" cy="18" r="1.5" />
                <circle cx="18" cy="18" r="1.5" />
              </svg>
            )}
            {step.icon === 'storage' && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M3 10 12 4l9 6v10H3z" />
                <path d="M9 20v-5h6v5" />
              </svg>
            )}
            {step.icon === 'roastery' && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M7 14a5 5 0 0 0 10 0V9H7z" />
                <path d="M17 11h1a2 2 0 1 1 0 4h-1" />
                <path d="M12 4c2 1.2 2 2.6.6 4M9 5.4c1.6 1 1.6 2.2.5 3.3" stroke-linecap="round" />
              </svg>
            )}
          </div>
          <h3 class="font-display text-[1.9rem] font-semibold leading-[1.05] tracking-tight text-ink">{step.title}</h3>
          <p class="mt-4 text-[15px] leading-relaxed text-ink-muted">{step.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="hikayemiz" class="anchor-target scroll-mt-28 bg-paper py-20 md:py-24" data-reveal>
  <div class="section-shell">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12 xl:gap-16">
      <div class="flex justify-center lg:justify-start">
        <StorySpotlightImage src="/about.svg" />
      </div>
      <div class="flex flex-col justify-center">
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-ink md:text-xs">
          {homeStory.tagline}
        </p>
        <h2 class="mt-3 font-display text-[clamp(1.65rem,3.5vw,2.25rem)] font-semibold leading-tight tracking-tight text-ink">
          {homeStory.title}
        </h2>
        <div class="mt-6 space-y-4 text-[15px] leading-relaxed text-ink-muted md:text-[16px]">
          {homeStory.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
        <a
          href={withLang('/about', locale)}
          class="mt-8 inline-flex w-fit items-center justify-center rounded-xl bg-ink px-7 py-3.5 text-[13px] font-semibold text-white shadow-sm transition hover:bg-ink/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/50 focus-visible:ring-offset-2"
        >
          {homeStory.knowMore}
        </a>
      </div>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2 md:mt-16">
      {brandValues.slice(0, 2).map((value, i) => (
        <article class="glass-panel px-7 py-8" data-reveal-step={String(i + 1)}>
          <h3 class="text-[13px] font-semibold uppercase tracking-[0.18em] text-ink">{value.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">{value.body}</p>
        </article>
      ))}
    </div>
    <article class="glass-panel mt-6 px-7 py-8 md:px-10" data-reveal>
      <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-ink/55">{t(locale, 'home.originEyebrow')}</p>
      <h3 class="mt-2 font-display text-xl font-semibold text-ink">{t(locale, 'home.originTitle')}</h3>
      <ul class="mt-5 grid gap-2 text-sm text-ink-muted sm:grid-cols-2 lg:grid-cols-3">
        {((homeDict.originBullets ?? []) as string[]).map((line) => (
          <li class="flex gap-2">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-gold" aria-hidden="true" />
            <span>{line}</span>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-[12px] font-semibold uppercase tracking-[0.16em] text-ink">{t(locale, 'home.originFarmsTitle')}</p>
      <ul class="mt-3 space-y-1 text-sm text-ink-muted">
        {((homeDict.originFarms ?? []) as string[]).map((line) => (
          <li>{line}</li>
        ))}
      </ul>
    </article>
  </div>
</section>

<section id="kahvelerimiz" class="anchor-target scroll-mt-28 bg-paper py-20 md:py-24" data-reveal>
  <div class="section-shell">
    <SectionHeader
      eyebrow={t(locale, 'products.eyebrow')}
      title={t(locale, 'home.coffeesSectionTitle')}
      description={t(locale, 'home.coffeesSectionIntro')}
    />

    <div class="relative z-20 mt-8 flex flex-wrap gap-3" data-category-filter-root>
      {segmentDefs.map((segment, i) => (
        <button
          type="button"
          data-category-tab={segment.id}
          data-active-classes="bg-ink text-white border-ink"
          data-inactive-classes="bg-surface text-ink/75 border-line hover:border-ink/30"
          class:list={[
            'border px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.16em] transition-colors',
            i === 0 ? 'bg-ink text-white border-ink' : 'bg-surface text-ink/75 border-line hover:border-ink/30',
          ]}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {segment.label}
        </button>
      ))}
    </div>

    <div class="mt-8 space-y-4">
      {segmentDefs.map((segment, i) => (
        <div data-segment-panel={segment.id} class:list={[i !== 0 && 'hidden']}>
          <h3 class="text-lg font-bold text-ink">{segment.title}</h3>
          <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-muted">{segment.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3" data-category-cards>
      {localizedLots.map((lot) => (
        <div
          data-category-card
          data-segment={lot.segment}
          class:list={[lot.segment !== defaultSegment && 'hidden']}
        >
          <CoffeeLotCard lot={lot} locale={locale} />
        </div>
      ))}
      <div
        data-category-card
        data-segment="retail"
        class:list={['md:col-span-3', defaultSegment !== 'retail' && 'hidden']}
      >
        <article class="glass-panel border border-line/90 px-7 py-10 md:px-10">
          <h3 class="font-display text-xl font-semibold text-ink">{t(locale, 'home.retailTeaserTitle')}</h3>
          <p class="mt-4 max-w-3xl text-sm leading-relaxed text-ink-muted">{t(locale, 'home.retailTeaserBody')}</p>
          <p class="mt-6 text-sm font-semibold text-ink">{t(locale, 'products.retailProductTitle')}</p>
          <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-muted">{t(locale, 'products.retailProductStory')}</p>
          <ul class="mt-6 grid gap-2 text-sm text-ink-muted sm:grid-cols-2 lg:grid-cols-3">
            {retailSpecLines.map((line) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-gold" aria-hidden="true" />
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>

    <div class="mt-12 flex justify-center" data-category-cta>
      <a href={withLang('/products', locale)} class="btn-primary inline-flex justify-center px-8">
        {t(locale, 'home.coffeesCtaAll')}
      </a>
    </div>
  </div>
</section>

<section id="kalite" class="anchor-target scroll-mt-28 border-y border-line bg-paper-deep py-20 md:py-24" data-reveal>
  <div class="section-shell">
    <SectionHeader
      title={t(locale, 'home.qualitySectionTitle')}
      description={t(locale, 'home.qualitySectionIntro')}
      align="center"
    />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <article class="glass-panel px-6 py-7">
        <h3 class="text-sm font-semibold uppercase tracking-[0.16em] text-ink">{t(locale, 'qualityPage.sgsTitle')}</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'qualityPage.sgsBody')}</p>
      </article>
      <article class="glass-panel px-6 py-7">
        <h3 class="text-sm font-semibold uppercase tracking-[0.16em] text-ink">{t(locale, 'qualityPage.qTitle')}</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'qualityPage.qBody')}</p>
      </article>
      <article class="glass-panel px-6 py-7">
        <h3 class="text-sm font-semibold uppercase tracking-[0.16em] text-ink">{t(locale, 'qualityPage.insaiTitle')}</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'qualityPage.insaiBody')}</p>
      </article>
    </div>
  </div>
</section>

<section id="toptan" class="anchor-target scroll-mt-28 relative min-h-[min(480px,78vh)] overflow-hidden" data-reveal>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <img
      src="/coffefruits.webp"
      alt=""
      class="h-full w-full object-cover object-center brightness-[1.05] saturate-[1.03]"
      loading="lazy"
      decoding="async"
      width="1920"
      height="1080"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/45 via-black/25 to-black/15"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(13,44,63,0.35),transparent_45%)]"></div>
  </div>

  <div class="section-shell relative z-10 flex min-h-[min(480px,78vh)] items-center py-16 md:py-24">
    <div class="max-w-xl">
      <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-gold">
        {t(locale, 'home.b2bCtaEyebrow')}
      </p>
      <h2 class="mt-4 font-display text-[clamp(1.85rem,4.5vw,2.75rem)] font-bold leading-[1.12] tracking-tight text-white drop-shadow-[0_2px_24px_rgba(0,0,0,0.35)]">
        {t(locale, 'home.b2bCtaTitle')}
      </h2>
      <p class="mt-5 font-sans text-[17px] leading-[1.65] text-white/95 md:text-lg">
        {t(locale, 'home.b2bCtaBody')}
      </p>
      <a href={withLang('/contact', locale)} class="btn-primary mt-10">
        {t(locale, 'home.b2bCtaButton')}
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function applyClasses(el: Element, list: string, add: boolean) {
    const classes = list.split(' ').map((v) => v.trim()).filter(Boolean);
    if (!classes.length) return;
    el.classList[add ? 'add' : 'remove'](...classes);
  }

  function initCategoryFilter() {
    const root = document.querySelector('[data-category-filter-root]');
    if (!root) return;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const buttons = Array.from(root.querySelectorAll<HTMLElement>('[data-category-tab]'));
    const cardsRoot = document.querySelector('[data-category-cards]');
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-segment-panel]'));
    const cards = cardsRoot
      ? Array.from(cardsRoot.querySelectorAll<HTMLElement>('[data-category-card][data-segment]'))
      : [];
    if (!buttons.length || !cards.length) return;

    const setActive = (segment: string, opts?: { skipClear?: boolean }) => {
      buttons.forEach((btn) => {
        const tab = btn.getAttribute('data-category-tab');
        const isActive = tab === segment;
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        applyClasses(btn, btn.getAttribute('data-active-classes') ?? '', false);
        applyClasses(btn, btn.getAttribute('data-inactive-classes') ?? '', false);
        if (isActive) {
          applyClasses(btn, btn.getAttribute('data-active-classes') ?? '', true);
        } else {
          applyClasses(btn, btn.getAttribute('data-inactive-classes') ?? '', true);
        }
      });

      panels.forEach((panel) => {
        const pid = panel.getAttribute('data-segment-panel');
        panel.classList.toggle('hidden', pid !== segment);
      });

      cards.forEach((card) => {
        const sid = card.getAttribute('data-segment');
        const match = sid === segment;
        card.classList.toggle('hidden', !match);
        /* İlk yüklemede clearProps yapma — giriş animasyonundaki opacity:0 ile çakışır */
        if (match && !opts?.skipClear) {
          gsap.killTweensOf(card);
          gsap.set(card, { clearProps: 'opacity,transform,scale' });
        }
      });

      if (prefersReduced) {
        cards.forEach((card) => {
          if (card.getAttribute('data-segment') === segment) {
            gsap.set(card, { opacity: 1, y: 0, scale: 1 });
          }
        });
        return;
      }

      const activePanel = panels.find((p) => p.getAttribute('data-segment-panel') === segment);
      const activeCards = cards.filter((c) => c.getAttribute('data-segment') === segment);

      if (activePanel) {
        gsap.fromTo(
          activePanel,
          { opacity: 0, y: 10 },
          { opacity: 1, y: 0, duration: 0.3, ease: 'power2.out', overwrite: 'auto' }
        );
      }

      if (activeCards.length) {
        gsap.fromTo(
          activeCards,
          { opacity: 0, y: 18, scale: 0.985 },
          { opacity: 1, y: 0, scale: 1, duration: 0.42, stagger: 0.06, ease: 'power2.out', overwrite: 'auto' }
        );
      }
    };

    const initial = buttons[0]?.getAttribute('data-category-tab');
    if (initial) setActive(initial, { skipClear: true });

    root.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      const btn = t.closest('[data-category-tab]');
      if (!btn || !root.contains(btn)) return;
      const segment = btn.getAttribute('data-category-tab');
      if (segment) setActive(segment);
    });
  }

  function initCategoryCardsAnimation() {
    if (typeof document === 'undefined') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const root = document.querySelector('[data-category-cards]');
    if (!root) return;

    /* Sadece seçili segmentteki kartlar: tüm grid'e opacity:0 yazmak, gizli segmentleri sonra görünür yapınca boş bırakıyordu */
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-category-card]')).filter(
      (el) => !el.classList.contains('hidden')
    );
    const cta = document.querySelector<HTMLElement>('[data-category-cta]');
    if (!cards.length) return;

    gsap.set(cards, { opacity: 0, y: 48, scale: 0.94, transformOrigin: 'center bottom' });
    if (cta) gsap.set(cta, { opacity: 0, y: 20 });

    let played = false;
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting || played) return;
          played = true;
          const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
          tl.to(cards, {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.75,
            stagger: 0.06,
            force3D: true,
          }).to(cta, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' }, '-=0.35');
          obs.disconnect();
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    obs.observe(root);
  }

  function run() {
    initCategoryFilter();
    initCategoryCardsAnimation();
  }

  document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', run) : run();
</script>
