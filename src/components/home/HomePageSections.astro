---
import SectionHeader from '../SectionHeader.astro';
import type { Locale } from '../../i18n/types';
import { resolveLocale } from '../../i18n/config';
import { t } from '../../i18n/t';
import { withLang } from '../../i18n/paths';
import { dictionary } from '../../i18n/dictionary';
import { coffeeLots } from '../../data/coffeeLots';
import { site, mailtoB2B } from '../../config/site';

interface Props {
  locale: Locale;
}

const { locale: localeProp } = Astro.props;
const locale = resolveLocale(localeProp as string | undefined);

const homeStory = dictionary[locale].homeStory as { eyebrow: string; title: string; body: string };
const brandValues = (dictionary[locale].brandValues ?? []) as { title: string; body: string }[];
const homeDict = dictionary[locale].home as Record<string, unknown>;
const wholesaleBullets = (homeDict.wholesaleBullets ?? []) as string[];

const segmentDefs = [
  {
    id: 'ultra-premium',
    label: t(locale, 'products.segmentLabelUltra'),
    title: t(locale, 'products.segmentUltraTitle'),
    desc: t(locale, 'products.segmentUltraDesc'),
  },
  {
    id: 'special-series',
    label: t(locale, 'products.segmentLabelSpecial'),
    title: t(locale, 'products.segmentSpecialTitle'),
    desc: t(locale, 'products.segmentSpecialDesc'),
  },
  {
    id: 'blend-mixed',
    label: t(locale, 'products.segmentLabelBlend'),
    title: t(locale, 'products.segmentBlendTitle'),
    desc: t(locale, 'products.segmentBlendDesc'),
  },
] as const;

const defaultSegment = segmentDefs[0].id;
---

<section id="hikayemiz" class="anchor-target scroll-mt-28 py-20 md:py-24" data-reveal>
  <div class="section-shell">
    <SectionHeader
      eyebrow={homeStory.eyebrow}
      title={homeStory.title}
      description={homeStory.body}
      align="center"
    />
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {brandValues.slice(0, 2).map((value, i) => (
        <article class="glass-panel px-7 py-8" data-reveal-step={String(i + 1)}>
          <h3 class="text-[13px] font-semibold uppercase tracking-[0.18em] text-ink">{value.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">{value.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="kahvelerimiz" class="anchor-target scroll-mt-28 bg-paper py-20 md:py-24" data-reveal>
  <div class="section-shell">
    <SectionHeader
      eyebrow={t(locale, 'products.eyebrow')}
      title={t(locale, 'home.coffeesSectionTitle')}
      description={t(locale, 'home.coffeesSectionIntro')}
    />

    <div class="mt-8 flex flex-wrap gap-3" data-category-filter-root>
      {segmentDefs.map((segment, i) => (
        <button
          type="button"
          data-category-tab={segment.id}
          data-active-classes="bg-ink text-white border-ink"
          data-inactive-classes="bg-surface text-ink/75 border-line hover:border-ink/30"
          class:list={[
            'border px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.16em] transition-colors',
            i === 0 ? 'bg-ink text-white border-ink' : 'bg-surface text-ink/75 border-line hover:border-ink/30',
          ]}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {segment.label}
        </button>
      ))}
    </div>

    <div class="mt-8 space-y-4">
      {segmentDefs.map((segment, i) => (
        <div data-segment-panel={segment.id} class:list={[i !== 0 && 'hidden']}>
          <h3 class="text-lg font-bold text-ink">{segment.title}</h3>
          <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-muted">{segment.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3" data-category-cards>
      {coffeeLots.map((lot) => (
        <article
          data-category-card
          data-segment={lot.segment}
          class:list={['border border-line bg-surface shadow-card', lot.segment !== defaultSegment && 'hidden']}
        >
          <div class="border-b border-line bg-surface-muted px-5 py-4">
            <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-ink/55">{lot.collectionLabel ?? t(locale, 'coffee.heroSpecialty')}</p>
            <h4 class="mt-2 text-[17px] font-bold text-ink">{lot.name}</h4>
            <p class="mt-1 text-sm text-ink-muted">{lot.region}, {lot.country}</p>
          </div>
          <div class="px-5 py-4">
            <p class="text-[12px] font-semibold text-ink">SCA {lot.score.toFixed(2)}</p>
            <a href={withLang(`/coffees/${lot.slug}`, locale)} class="mt-3 inline-flex text-[11px] font-semibold uppercase tracking-[0.14em] text-gold hover:text-ink">
              {t(locale, 'home.lotDetail')}
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 flex justify-center" data-category-cta>
      <a href={withLang('/products', locale)} class="btn-primary inline-flex justify-center px-8">
        {t(locale, 'home.coffeesCtaAll')}
      </a>
    </div>
  </div>
</section>

<section id="kalite" class="anchor-target scroll-mt-28 border-y border-line bg-paper-deep py-20 md:py-24" data-reveal>
  <div class="section-shell">
    <SectionHeader
      title={t(locale, 'home.qualitySectionTitle')}
      description={t(locale, 'home.qualitySectionIntro')}
      align="center"
    />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <article class="glass-panel px-6 py-7">
        <h3 class="text-sm font-semibold uppercase tracking-[0.16em] text-ink">{t(locale, 'qualityPage.sgsTitle')}</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'qualityPage.sgsBody')}</p>
      </article>
      <article class="glass-panel px-6 py-7">
        <h3 class="text-sm font-semibold uppercase tracking-[0.16em] text-ink">{t(locale, 'qualityPage.qTitle')}</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'qualityPage.qBody')}</p>
      </article>
      <article class="glass-panel px-6 py-7">
        <h3 class="text-sm font-semibold uppercase tracking-[0.16em] text-ink">{t(locale, 'qualityPage.insaiTitle')}</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'qualityPage.insaiBody')}</p>
      </article>
    </div>
  </div>
</section>

<section id="toptan" class="anchor-target scroll-mt-28 py-20 md:py-24" data-reveal>
  <div class="section-shell">
    <SectionHeader
      eyebrow={t(locale, 'home.wholesaleEyebrow')}
      title={t(locale, 'home.wholesaleSectionTitle')}
      description={t(locale, 'home.wholesaleSectionIntro')}
    />
    <div class="mt-10 border border-gold/40 bg-ink px-8 py-10 text-white md:px-10">
      <ul class="space-y-3 text-sm leading-relaxed">
        {wholesaleBullets.map((line) => (
          <li class="flex gap-3">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true" />
            <span>{line}</span>
          </li>
        ))}
      </ul>
      <div class="mt-8">
        <a href={withLang('/contact', locale)} class="inline-flex border border-gold/35 bg-gold px-6 py-3 text-[11px] font-semibold uppercase tracking-[0.14em] text-ink">
          {t(locale, 'nav.cta')}
        </a>
      </div>
    </div>
  </div>
</section>

<section id="iletisim" class="anchor-target scroll-mt-28 py-16 md:py-20" data-reveal>
  <div class="section-shell">
    <SectionHeader
      eyebrow={t(locale, 'contactBlock.eyebrow')}
      title={t(locale, 'contactBlock.title')}
      description={t(locale, 'contactBlock.description')}
    />
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <article class="glass-panel px-7 py-8">
        <h3 class="text-[12px] font-semibold uppercase tracking-[0.16em] text-ink">{t(locale, 'contact.infoTitle')}</h3>
        <ul class="mt-5 space-y-3 text-sm text-ink-muted">
          <li>
            <span class="font-semibold text-ink">{t(locale, 'contact.emailLabel')}</span>
            <a class="ml-2 text-gold hover:text-ink" href={mailtoB2B}>{site.contactEmail}</a>
          </li>
          <li>
            <span class="font-semibold text-ink">{t(locale, 'contact.regionLabel')}</span>
            <span class="ml-2">{t(locale, 'contact.regionValue')}</span>
          </li>
          <li>
            <span class="font-semibold text-ink">{t(locale, 'contact.partnerLabel')}</span>
            <span class="ml-2">{t(locale, 'contact.partnerValue')}</span>
          </li>
        </ul>
      </article>

      <article class="glass-panel px-7 py-8">
        <h3 class="text-[12px] font-semibold uppercase tracking-[0.16em] text-ink">{t(locale, 'contact.whoTitle')}</h3>
        <ul class="mt-5 space-y-2 text-sm text-ink-muted">
          <li>{t(locale, 'contact.who1')}</li>
          <li>{t(locale, 'contact.who2')}</li>
          <li>{t(locale, 'contact.who3')}</li>
          <li>{t(locale, 'contact.who4')}</li>
          <li>{t(locale, 'contact.who5')}</li>
        </ul>
        <div class="mt-6">
          <a href={withLang('/contact', locale)} class="btn-primary">{t(locale, 'nav.contact')}</a>
        </div>
      </article>
    </div>
    <p class="mt-8 text-sm text-ink-muted">
      {t(locale, 'contact.infoFootnote')}
    </p>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function applyClasses(el: Element, list: string, add: boolean) {
    const classes = list.split(' ').map((v) => v.trim()).filter(Boolean);
    if (!classes.length) return;
    el.classList[add ? 'add' : 'remove'](...classes);
  }

  function initCategoryFilter() {
    const root = document.querySelector('[data-category-filter-root]');
    if (!root) return;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const buttons = Array.from(root.querySelectorAll<HTMLElement>('[data-category-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-segment-panel]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-category-card][data-segment]'));
    if (!buttons.length || !cards.length) return;

    const setActive = (segment: string) => {
      buttons.forEach((btn) => {
        const isActive = btn.dataset.categoryTab === segment;
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        applyClasses(btn, btn.dataset.activeClasses ?? '', false);
        applyClasses(btn, btn.dataset.inactiveClasses ?? '', false);
        if (isActive) {
          applyClasses(btn, btn.dataset.activeClasses ?? '', true);
        } else {
          applyClasses(btn, btn.dataset.inactiveClasses ?? '', true);
        }
      });

      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.segmentPanel !== segment);
      });

      cards.forEach((card) => {
        card.classList.toggle('hidden', card.dataset.segment !== segment);
      });

      if (prefersReduced) return;

      const activePanel = panels.find((panel) => panel.dataset.segmentPanel === segment);
      const activeCards = cards.filter((card) => card.dataset.segment === segment);

      if (activePanel) {
        gsap.fromTo(
          activePanel,
          { opacity: 0, y: 10 },
          { opacity: 1, y: 0, duration: 0.3, ease: 'power2.out', overwrite: 'auto' }
        );
      }

      if (activeCards.length) {
        gsap.fromTo(
          activeCards,
          { opacity: 0, y: 18, scale: 0.985 },
          { opacity: 1, y: 0, scale: 1, duration: 0.42, stagger: 0.06, ease: 'power2.out', overwrite: 'auto' }
        );
      }
    };

    const initial = buttons[0]?.dataset.categoryTab;
    if (initial) setActive(initial);

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const segment = btn.dataset.categoryTab;
        if (segment) setActive(segment);
      });
    });
  }

  function initCategoryCardsAnimation() {
    if (typeof document === 'undefined') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const root = document.querySelector('[data-category-cards]');
    const cards = document.querySelectorAll<HTMLElement>('[data-category-card]');
    const cta = document.querySelector<HTMLElement>('[data-category-cta]');
    if (!root || !cards.length) return;

    gsap.set(cards, { opacity: 0, y: 48, scale: 0.94, transformOrigin: 'center bottom' });
    if (cta) gsap.set(cta, { opacity: 0, y: 20 });

    let played = false;
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting || played) return;
          played = true;
          const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
          tl.to(cards, {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.75,
            stagger: 0.06,
            force3D: true,
          }).to(cta, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' }, '-=0.35');
          obs.disconnect();
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    obs.observe(root);
  }

  function run() {
    initCategoryFilter();
    initCategoryCardsAnimation();
  }

  document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', run) : run();
</script>
