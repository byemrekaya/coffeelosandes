---
import { Image } from 'astro:assets';
import SectionHeader from '../SectionHeader.astro';
import type { Locale } from '../../i18n/types';
import { resolveLocale } from '../../i18n/config';
import { getLocalizedDictionary } from '../../i18n/localizedDictionary';
import { t } from '../../i18n/t';
import { withLang } from '../../i18n/paths';
import { coffeeLots } from '../../data/coffeeLots';
import { venezuelaCoffeeMasterWithSlug } from '../../data/venezuelaCoffeeMaster';
import { localizeCoffeeLots } from '../../i18n/localizeLot';
import CoffeeLotCard from '../coffee/CoffeeLotCard.astro';
import CoffeeMasterCard from '../products/CoffeeMasterCard.astro';

interface Props {
  locale: Locale;
}

const { locale: localeProp } = Astro.props;
const locale = resolveLocale(localeProp as string | undefined);
const dict = getLocalizedDictionary(locale);

const homeStory = dict.homeStory as {
  eyebrow: string;
  tagline: string;
  title: string;
  paragraphs: string[];
  knowMore: string;
  imageAlt: string;
  badgeSince: string;
};
const localizedLots = localizeCoffeeLots(coffeeLots, locale);
const totalLots = localizedLots.length;

const segmentDefs = [
  {
    id: 'competition-lots',
    label: t(locale, 'products.segmentLabelCompetition'),
    title: t(locale, 'products.segmentCompetitionTitle'),
    desc: t(locale, 'products.segmentCompetitionDesc'),
  },
  {
    id: 'premium-microlot',
    label: t(locale, 'products.segmentLabelMicro'),
    title: t(locale, 'products.segmentMicroTitle'),
    desc: t(locale, 'products.segmentMicroDesc'),
  },
  {
    id: 'specialty-series',
    label: t(locale, 'products.segmentLabelSpecialty'),
    title: t(locale, 'products.segmentSpecialtyTitle'),
    desc: t(locale, 'products.segmentSpecialtyDesc'),
  },
  {
    id: 'barista-blend',
    label: t(locale, 'products.segmentLabelBarista'),
    title: t(locale, 'products.segmentBaristaTitle'),
    desc: t(locale, 'products.segmentBaristaDesc'),
  },
  {
    id: 'commercial',
    label: t(locale, 'products.segmentLabelCommercial'),
    title: t(locale, 'products.segmentCommercialTitle'),
    desc: t(locale, 'products.segmentCommercialDesc'),
  },
  {
    id: 'retail',
    label: t(locale, 'products.segmentLabelRetail'),
    title: t(locale, 'products.segmentRoastedTitle'),
    desc: t(locale, 'products.segmentRoastedDesc'),
  },
] as const;

const defaultSegment = segmentDefs[0].id;
const totalCategories = segmentDefs.length;
const masterSegmentDefs = [
  { id: 'MICRO LOT', label: t(locale, 'products.segmentLabelMicro') },
  { id: 'SPECIALTY', label: t(locale, 'products.segmentLabelSpecialty') },
  { id: 'COMMERCIAL', label: t(locale, 'products.segmentLabelCommercial') },
] as const;
const masterDefaultSegment = masterSegmentDefs[0].id;
const masterTotalCategories = masterSegmentDefs.length;
const masterTotalLots = venezuelaCoffeeMasterWithSlug.length;
const lotWordByLocale: Record<Locale, string> = {
  tr: 'lot',
  de: 'Lots',
  en: 'lots',
  fr: 'lots',
  es: 'lotes',
};
const categoryWordByLocale: Record<Locale, string> = {
  tr: 'kategori',
  de: 'Kategorien',
  en: 'categories',
  fr: 'categories',
  es: 'categorias',
};

---

<section id="hikayemiz" class="section-band-b anchor-target scroll-mt-28 border-t border-line/60 py-20 md:py-28" data-reveal>
  <div class="section-shell">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-16">
      <div class="order-2 flex min-w-0 flex-col justify-center lg:order-1">
        <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-[#6f7f5f] md:text-xs">
          {homeStory.tagline}
        </p>
        <h2 class="mt-4 font-display text-[clamp(2rem,4.2vw,3.2rem)] font-semibold leading-[1.1] tracking-tight text-heading">
          {homeStory.title}
        </h2>
        <div class="mt-6 space-y-4 text-[17px] leading-[1.72] text-[#5f5b55]">
          {homeStory.paragraphs.slice(0, 2).map((p) => (
            <p>{p}</p>
          ))}
        </div>
        <a
          href={withLang('/about', locale)}
          class="mt-9 inline-flex w-fit items-center justify-center rounded-full bg-heading px-8 py-3.5 text-[13px] font-semibold text-white shadow-sm transition hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-heading/50 focus-visible:ring-offset-2"
        >
          {homeStory.knowMore}
        </a>
      </div>
      <div class="relative order-1 min-w-0 lg:order-2">
        <div class="absolute -left-3 -top-4 z-10 rounded-full bg-white px-5 py-3 text-sm font-semibold text-heading shadow-[0_10px_30px_rgba(0,0,0,0.14)] md:-left-5 md:-top-5 md:px-6 md:py-4">
          {homeStory.badgeSince}
        </div>
        <div class="group relative overflow-hidden rounded-[30px]">
          <Image
            src="/coffee-farm-about.webp"
            alt={homeStory.imageAlt}
            width="960"
            height="1200"
            class="h-full w-full object-cover object-[52%_46%] transition-transform duration-700 group-hover:scale-[1.03]"
            loading="lazy"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/12 to-transparent"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section
  id="barista-blend-paket"
  class="section-band-a anchor-target scroll-mt-28 border-t border-line/60 py-16 md:py-24"
  data-reveal
>
  <div class="section-shell">
    <div
      class="grid items-center gap-10 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.1fr)] lg:items-center lg:gap-12 xl:gap-16"
    >
      <div class="order-2 flex min-w-0 flex-col justify-center lg:order-1">
        <p
          class="text-[10px] font-semibold uppercase tracking-[0.22em] text-[#6f7f5f] sm:text-[11px] md:tracking-[0.26em]"
        >
          {t(locale, 'home.retailPackEyebrow')}
        </p>
        <h2
          class="mt-3 max-w-[min(22ch,100%)] font-display text-[clamp(1.85rem,3.8vw,3rem)] font-semibold leading-[1.08] tracking-tight text-heading"
        >
          {t(locale, 'products.retailProductTitle')}
        </h2>
        <p class="mt-5 max-w-md text-[16px] leading-[1.68] text-[#5f5b55] md:text-[17px] md:leading-[1.7]">
          {t(locale, 'products.retailProductStory')}
        </p>
        <ul class="mt-6 max-w-md space-y-2.5 border-l border-[#c4b8a8]/55 pl-4 text-[14px] leading-snug text-[#4a4540] md:text-[15px]">
          <li>{t(locale, 'home.retailPackFeatOrigin')}</li>
          <li>{t(locale, 'home.retailPackFeatProcess')}</li>
          <li>{t(locale, 'home.retailPackFeatProfile')}</li>
        </ul>
        <p class="mt-5 max-w-md text-[11px] leading-relaxed tracking-tight text-[#8a847a] sm:text-[12px]">
          {t(locale, 'home.retailPackStrip1')} · {t(locale, 'home.retailPackStrip2')} ·{' '}
          {t(locale, 'home.retailPackStrip3')}
        </p>
        <div class="mt-8 flex flex-row flex-wrap items-center gap-2 sm:mt-9 sm:gap-3 md:gap-4">
          <a
            href={withLang('/coffees/cafe-1600-catimor', locale)}
            class="inline-flex min-h-[44px] flex-1 items-center justify-center rounded-full bg-heading px-4 py-2.5 text-center text-[12px] font-semibold leading-tight text-white shadow-[0_8px_24px_rgba(30,35,28,0.18)] transition hover:opacity-92 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-heading/45 focus-visible:ring-offset-2 sm:min-h-0 sm:flex-initial sm:px-7 sm:py-3.5 sm:text-[13px]"
          >
            {t(locale, 'home.retailPackCtaPrimary')}
          </a>
          <a
            href={withLang('/contact', locale)}
            class="inline-flex min-h-[44px] flex-1 items-center justify-center rounded-full border border-heading/18 bg-transparent px-4 py-2.5 text-center text-[12px] font-semibold leading-tight text-heading transition hover:border-heading/35 hover:bg-heading/[0.04] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-heading/30 focus-visible:ring-offset-2 sm:min-h-0 sm:flex-initial sm:px-6 sm:py-3 sm:text-[13px]"
          >
            {t(locale, 'home.retailPackCtaSecondary')}
          </a>
        </div>
      </div>

      <div
        class="relative order-1 flex min-w-0 justify-center overflow-visible lg:order-2 lg:justify-end lg:overflow-visible"
      >
        <div
          class="relative flex w-full max-w-[min(100%,400px)] flex-col items-center justify-center py-4 sm:py-6 lg:max-w-[min(100%,480px)] lg:items-end lg:pr-2"
        >
          <div class="pointer-events-none absolute left-1/2 top-[42%] z-0 h-[min(120%,420px)] w-[min(140%,520px)] -translate-x-1/2 -translate-y-1/2 md:top-[44%]" aria-hidden="true">
            <div
              class="absolute inset-0 bg-[radial-gradient(circle_at_50%_42%,rgba(243,239,233,0.92)_0%,rgba(234,228,219,0.55)_52%,transparent_72%)]"
            ></div>
            <div
              class="absolute left-1/2 top-1/2 h-[75%] w-[85%] -translate-x-1/2 -translate-y-1/2 bg-[radial-gradient(ellipse_at_center,rgba(190,165,130,0.14),transparent_68%)] blur-3xl"
            ></div>
          </div>
          <div
            class="pointer-events-none absolute bottom-[12%] left-1/2 z-0 h-14 w-[68%] max-w-[252px] -translate-x-1/2 rounded-[100%] bg-[radial-gradient(ellipse_at_center,rgba(35,28,22,0.14),transparent_72%)] blur-xl sm:bottom-[14%]"
            aria-hidden="true"
          ></div>

          <div class="relative z-10 w-full lg:translate-x-2 xl:translate-x-3">
            <div class="group relative mx-auto w-fit max-w-[min(100%,216px)] sm:max-w-[min(100%,234px)] md:max-w-[min(100%,252px)] lg:mx-0 lg:ml-auto">
              <div
                class="pointer-events-none absolute left-1/2 top-[48%] z-0 h-[88%] w-[118%] max-w-none -translate-x-1/2 -translate-y-1/2 bg-[radial-gradient(ellipse_at_center,rgba(120,95,72,0.2),transparent_70%)] blur-2xl"
                aria-hidden="true"
              ></div>
              <Image
                src="/losandes-coffee-package.webp"
                alt={t(locale, 'home.retailPackImageAlt')}
                width="800"
                height="1000"
                class="relative z-[1] mx-auto block h-auto w-full max-w-full rounded-xl object-contain object-center drop-shadow-[0_32px_48px_rgba(18,14,10,0.2)] transition duration-500 ease-out will-change-transform group-hover:scale-[1.02] group-hover:drop-shadow-[0_40px_56px_rgba(18,14,10,0.16)] sm:rounded-2xl"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="kahvelerimiz" class="section-band-a anchor-target scroll-mt-28 border-t border-line/60 py-20 md:py-28" data-reveal>
  <div class="section-shell">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <span class="mb-3 block text-[11px] font-semibold uppercase tracking-[0.28em] text-[#6f7f5f]">
          {t(locale, 'products.eyebrow')}
        </span>
        <h2 class="font-display text-[clamp(2.35rem,4.6vw,3.8rem)] font-semibold tracking-tight text-heading">
          {t(locale, 'home.coffeesSectionTitle')}
        </h2>
        <p class="mt-4 text-[18px] leading-[1.65] text-[#5f5b55]">
          {t(locale, 'home.coffeesSectionIntro')}
        </p>
      </div>
      <p class="text-[13px] font-medium uppercase tracking-[0.16em] text-[#7b756d]">
        {totalLots} {lotWordByLocale[locale]} · {totalCategories} {categoryWordByLocale[locale]}
      </p>
    </div>

    <div class="relative z-20 mt-10 w-full min-w-0 max-w-full overflow-hidden" data-category-filter-root>
      <div
        class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 bg-gradient-to-l from-paper to-transparent md:w-16"
        aria-hidden="true"
      />
      <div
        class="w-full min-w-0 max-w-full overflow-x-auto overscroll-x-contain scroll-pl-4 scroll-pr-2 pb-2 pt-0.5 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden snap-x snap-mandatory"
      >
        <div
          class="inline-flex min-w-max items-center gap-3 rounded-[28px] border border-black/5 bg-[#f5f2ed] px-4 py-3.5 shadow-[inset_0_1px_0_rgba(255,255,255,0.75),0_10px_28px_rgba(15,38,28,0.06)] ring-1 ring-black/[0.03]"
        >
          {segmentDefs.map((segment, i) => (
            <button
              type="button"
              data-category-tab={segment.id}
              data-active-classes="bg-gradient-to-b from-[#1a1b19] to-[#2d322b] text-white border-black/15 shadow-[0_4px_20px_rgba(15,38,28,0.34),inset_0_1px_0_rgba(255,255,255,0.12)] ring-1 ring-[#4d6b52]/45"
              data-inactive-classes="bg-[#f0ebe4] text-[#3d3835] border-black/[0.06] shadow-[0_1px_3px_rgba(0,0,0,0.05)] hover:border-black/10 hover:bg-[#f7f4ef] hover:shadow-[0_3px_14px_rgba(15,38,28,0.09)]"
              class:list={[
                'home-filter-pill-btn group relative flex min-h-[46px] shrink-0 snap-start items-center gap-2 rounded-full border px-4 py-2.5 text-left text-[13px] font-semibold leading-snug tracking-tight transition-all duration-200 ease-out motion-safe:hover:scale-[0.99] motion-safe:active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-heading/35 focus-visible:ring-offset-2 focus-visible:ring-offset-paper',
                i === 0
                  ? 'border-black/15 bg-gradient-to-b from-[#1a1b19] to-[#2d322b] text-white shadow-[0_4px_20px_rgba(15,38,28,0.34),inset_0_1px_0_rgba(255,255,255,0.12)] ring-1 ring-[#4d6b52]/45'
                  : 'border-black/[0.06] bg-[#f0ebe4] text-[#3d3835] shadow-[0_1px_3px_rgba(0,0,0,0.05)]',
              ]}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span class="home-filter-pill-dot shrink-0" aria-hidden="true" />
              <span class="relative z-[1]">{segment.label}</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-8 space-y-4">
      {segmentDefs.map((segment, i) => (
        <div data-segment-panel={segment.id} class:list={[i !== 0 && 'hidden']}>
          <h3 class="text-[22px] font-semibold text-ink">{segment.title}</h3>
          <p class="mt-2 max-w-3xl text-[17px] leading-[1.6] text-[#5f5b55]">{segment.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-2 xl:grid-cols-3" data-category-cards>
      {localizedLots.map((lot) => (
        <div
          data-category-card
          data-segment={lot.segment}
          class:list={[lot.segment !== defaultSegment && 'hidden']}
        >
          <CoffeeLotCard lot={lot} locale={locale} />
        </div>
      ))}
    </div>

    <div class="mt-12 flex justify-center" data-category-cta>
      <a href={withLang('/products/awarded', locale)} class="btn-primary inline-flex justify-center px-8">
        {t(locale, 'home.awardedCtaAll')}
      </a>
    </div>
  </div>
</section>

<section id="urunlerimiz" class="section-band-b anchor-target scroll-mt-28 border-t border-line/60 py-20 md:py-28" data-reveal>
  <div class="section-shell">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <span class="mb-3 block text-[11px] font-semibold uppercase tracking-[0.28em] text-[#6f7f5f]">
          {t(locale, 'products.eyebrow')}
        </span>
        <h2 class="font-display text-[clamp(2.35rem,4.6vw,3.8rem)] font-semibold tracking-tight text-heading">
          {t(locale, 'home.productsSectionTitle')}
        </h2>
        <p class="mt-4 text-[18px] leading-[1.65] text-[#5f5b55]">
          {t(locale, 'home.productsSectionIntro')}
        </p>
      </div>
      <p class="text-[13px] font-medium uppercase tracking-[0.16em] text-[#7b756d]">
        {masterTotalLots} {lotWordByLocale[locale]} · {masterTotalCategories} {categoryWordByLocale[locale]}
      </p>
    </div>

    <div class="relative z-20 mt-10 w-full min-w-0 max-w-full overflow-hidden" data-master-filter-root>
      <div
        class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 bg-gradient-to-l from-surface to-transparent md:w-16"
        aria-hidden="true"
      />
      <div
        class="w-full min-w-0 max-w-full overflow-x-auto overscroll-x-contain scroll-pl-4 scroll-pr-2 pb-2 pt-0.5 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden snap-x snap-mandatory"
      >
        <div
          class="inline-flex min-w-max items-center gap-3 rounded-[28px] border border-black/5 bg-[#f7f5f1] px-4 py-3.5 shadow-[inset_0_1px_0_rgba(255,255,255,0.85),0_10px_28px_rgba(15,38,28,0.05)] ring-1 ring-black/[0.03]"
        >
          {masterSegmentDefs.map((segment, i) => (
            <button
              type="button"
              data-master-tab={segment.id}
              data-active-classes="bg-gradient-to-b from-[#1a1b19] to-[#2d322b] text-white border-black/15 shadow-[0_4px_20px_rgba(15,38,28,0.34),inset_0_1px_0_rgba(255,255,255,0.12)] ring-1 ring-[#4d6b52]/45"
              data-inactive-classes="bg-[#f2efe9] text-[#3d3835] border-black/[0.06] shadow-[0_1px_3px_rgba(0,0,0,0.05)] hover:border-black/10 hover:bg-[#faf8f3] hover:shadow-[0_3px_14px_rgba(15,38,28,0.09)]"
              class:list={[
                'home-filter-pill-btn group relative flex min-h-[46px] shrink-0 snap-start items-center gap-2 rounded-full border px-4 py-2.5 text-left text-[13px] font-semibold leading-snug tracking-tight transition-all duration-200 ease-out motion-safe:hover:scale-[0.99] motion-safe:active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-heading/35 focus-visible:ring-offset-2 focus-visible:ring-offset-surface',
                i === 0
                  ? 'border-black/15 bg-gradient-to-b from-[#1a1b19] to-[#2d322b] text-white shadow-[0_4px_20px_rgba(15,38,28,0.34),inset_0_1px_0_rgba(255,255,255,0.12)] ring-1 ring-[#4d6b52]/45'
                  : 'border-black/[0.06] bg-[#f2efe9] text-[#3d3835] shadow-[0_1px_3px_rgba(0,0,0,0.05)]',
              ]}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span class="home-filter-pill-dot shrink-0" aria-hidden="true" />
              <span class="relative z-[1]">{segment.label}</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-8 space-y-4">
      {masterSegmentDefs.map((segment, i) => (
        <div data-master-panel={segment.id} class:list={[i !== 0 && 'hidden']}>
          <h3 class="text-[22px] font-semibold text-ink">{segment.label}</h3>
        </div>
      ))}
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-2 xl:grid-cols-3" data-master-cards>
      {venezuelaCoffeeMasterWithSlug.map((item) => (
        <div data-master-card data-master-segment={item.segment} class:list={[item.segment !== masterDefaultSegment && 'hidden']}>
          <CoffeeMasterCard item={item} locale={locale} slug={item.slug} />
        </div>
      ))}
    </div>

    <div class="mt-12 flex justify-center" data-master-cta>
      <a href={withLang('/products', locale)} class="btn-primary inline-flex justify-center px-8">
        {t(locale, 'home.productsCtaAll')}
      </a>
    </div>
  </div>
</section>

<section id="kalite" class="section-band-b anchor-target scroll-mt-28 border-t border-line/60 py-20 md:py-28" data-reveal>
  <div class="section-shell">
    <SectionHeader
      title={t(locale, 'home.qualitySectionTitle')}
      description={t(locale, 'home.qualitySectionIntro')}
      align="center"
    />
    <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
      <article class="border-l-[3px] border-heading/30 pl-6">
        <h3 class="text-sm font-semibold uppercase tracking-[0.16em] text-ink">{t(locale, 'qualityPage.sgsTitle')}</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'qualityPage.sgsBody')}</p>
      </article>
      <article class="border-l-[3px] border-heading/30 pl-6">
        <h3 class="text-sm font-semibold uppercase tracking-[0.16em] text-ink">{t(locale, 'qualityPage.qTitle')}</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'qualityPage.qBody')}</p>
      </article>
      <article class="border-l-[3px] border-heading/30 pl-6">
        <h3 class="text-sm font-semibold uppercase tracking-[0.16em] text-ink">{t(locale, 'qualityPage.insaiTitle')}</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'qualityPage.insaiBody')}</p>
      </article>
    </div>
  </div>
</section>

<section id="toptan" class="anchor-target scroll-mt-28 relative min-h-[min(480px,78vh)] overflow-hidden border-t border-line/60" data-reveal>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <Image
      src="/coffee-cherries.webp"
      alt="Fresh coffee cherries from farm"
      class="h-full w-full object-cover object-center brightness-[1.05] saturate-[1.03]"
      loading="lazy"
      width="1920"
      height="1080"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/45 via-black/25 to-black/15"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(13,44,63,0.35),transparent_45%)]"></div>
  </div>

  <div class="section-shell relative z-10 flex min-h-[min(480px,78vh)] items-center py-16 md:py-24">
    <div class="max-w-xl">
      <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-heading">
        {t(locale, 'home.b2bCtaEyebrow')}
      </p>
