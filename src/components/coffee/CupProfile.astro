---
import type { CoffeeLot } from '../../data/coffeeLots';
import type { Locale } from '../../i18n/types';
import { t } from '../../i18n/t';

interface Props {
  lot: CoffeeLot;
  locale: Locale;
}

const { lot, locale } = Astro.props;
const notes = lot.longTastingNotes.split(',').map((s) => s.trim()).filter(Boolean);
---

<section class="py-20 md:py-28" data-reveal>
  <div class="section-shell">
    <div class="grid gap-14 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <div>
        <p class="stage-eyebrow mb-4">{t(locale, 'coffee.cupEyebrow')}</p>
        <h2 class="font-display text-display-md font-semibold tracking-tight-display text-cream">
          {t(locale, 'coffee.cupTitle')}
        </h2>
        <p class="mt-6 text-[17px] leading-[1.75] text-cream/75">
          {lot.cupProfileSummary}
        </p>
      </div>

      <div class="rounded-2xl border border-line bg-paper-deep p-8 md:p-10">
        <p class="text-[11px] font-medium uppercase tracking-[0.2em] text-cream/50">{t(locale, 'coffee.cupLexicon')}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {notes.map((note) => (
            <span class="rounded-md border border-line bg-stone-100/80 px-2.5 py-1 text-[12px] leading-relaxed text-cream/70">
              {note}
            </span>
          ))}
        </div>
        <p class="mt-8 text-sm leading-relaxed text-cream/55">
          {t(locale, 'coffee.cupDisclaimer')}
        </p>
      </div>
    </div>
  </div>
</section>
