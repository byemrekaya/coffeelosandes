---
import type { CoffeeLot } from '../../data/coffeeLots';
import type { Locale } from '../../i18n/types';
import { t } from '../../i18n/t';

interface Props {
  lot: CoffeeLot;
  locale: Locale;
}

const { lot, locale } = Astro.props;
---

<section class="py-20 md:py-28" data-reveal>
  <div class="section-shell">
    <div class="mx-auto max-w-3xl text-center">
      <p class="stage-eyebrow mb-4">{t(locale, 'coffee.overviewEyebrow')}</p>
      <h2 class="font-display text-display-md font-semibold tracking-tight-display text-cream">
        {t(locale, 'coffee.overviewTitle')}
      </h2>
    </div>

    <div class="mx-auto mt-14 max-w-3xl space-y-8 text-[17px] leading-[1.75] text-cream/75">
      <p>{lot.story}</p>
      <p class="border-l-2 border-gold/40 pl-6 text-cream/80">
        {lot.commercialSummary}
      </p>
      <p>
        {t(locale, 'coffee.overviewFooter')}
      </p>
    </div>
  </div>
</section>
