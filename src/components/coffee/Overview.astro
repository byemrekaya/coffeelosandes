---
import type { CoffeeLot } from '../../data/coffeeLots';

interface Props {
  lot: CoffeeLot;
}

const { lot } = Astro.props;
---

<section class="py-20 md:py-28" data-reveal>
  <div class="section-shell">
    <div class="mx-auto max-w-3xl text-center">
      <p class="stage-eyebrow mb-4">Lot overview</p>
      <h2 class="font-display text-display-md font-semibold tracking-tight-display text-cream">
        Why this lot matters
      </h2>
    </div>

    <div class="mx-auto mt-14 max-w-3xl space-y-8 text-[17px] leading-[1.75] text-cream/75">
      <p>{lot.story}</p>
      <p class="border-l-2 border-gold/40 pl-6 text-cream/80">
        {lot.commercialSummary}
      </p>
      <p>
        For wholesale buyers, the value is straightforward: a clearly articulated sensory identity, traceable origin, and a cup that holds up
        across roasting styles and service contexts — whether you are building a flagship release or strengthening a specialty line-up.
      </p>
    </div>
  </div>
</section>
