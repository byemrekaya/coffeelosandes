---
import { type CoffeeLot, getLotImageSrc, lotScoreLine } from '../../data/coffeeLots';
import type { Locale } from '../../i18n/types';
import { t } from '../../i18n/t';
import { withLang } from '../../i18n/paths';

interface Props {
  lot: CoffeeLot;
  locale: Locale;
}

const { lot, locale } = Astro.props;
const eyebrow = lot.collectionLabel ?? t(locale, 'coffee.heroSpecialty');
const coverSrc = getLotImageSrc(lot.slug);
const lightboxId = `lot-lightbox-${lot.slug}`;
const isRetailPackHero = lot.slug === 'espresso-crema';
const heroIntro = isRetailPackHero
  ? t(locale, 'coffee.heroIntroRetailPack')
      .replace('{region}', lot.region)
      .replace('{country}', lot.country)
  : t(locale, 'coffee.heroIntroTemplate')
      .replace('{producer}', lot.producer)
      .replace('{farm}', lot.farm)
      .replace('{region}', lot.region);
---

<section class="section-band-a relative overflow-hidden border-b border-line pb-12 pt-24 md:pb-16 md:pt-28 lg:pt-32" data-reveal>
  <div class="pointer-events-none absolute -right-32 top-0 h-96 w-96 rounded-full bg-terracotta/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-bronze/10 blur-3xl" aria-hidden="true"></div>

  <div class="section-shell relative">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-12 xl:gap-16">
      <div class="lg:col-span-5 transition-all duration-700 ease-out will-change-transform" data-coffee-hero-enter="left">
        <p class="mb-5 inline-flex rounded-full border border-heading/30 bg-white/70 px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.26em] text-heading">
          {eyebrow}
        </p>
        <h1 class="m-0 p-0 font-display text-[clamp(2.5rem,7vw,4rem)] font-semibold leading-[1.02] tracking-[-0.03em] text-ink">
          {lot.name}
        </h1>

        <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-ink/78 md:text-[16px]">{heroIntro}</p>

        <div class="mt-8">
          <span class="font-display text-[clamp(2.5rem,6.2vw,4.2rem)] font-semibold tabular-nums leading-none text-heading">
            {lotScoreLine(lot)}
          </span>
          <p class="mt-2 text-[11px] font-semibold uppercase tracking-[0.26em] text-ink/55">
            {t(locale, 'coffee.heroCupScore')}
          </p>
        </div>

        <p class="mt-8 text-[12px] font-semibold uppercase tracking-[0.16em] text-ink/72 md:text-[13px]">
          {lot.flavorTags.slice(0, 3).join(' • ')}
        </p>

        <div class="mx-auto mt-10 flex w-full max-w-md flex-col items-center gap-3 sm:mx-0 sm:max-w-none sm:flex-row sm:items-stretch">
          <a
            href={withLang('/contact', locale)}
            class="inline-flex min-h-[48px] w-full max-w-full items-center justify-center rounded-full bg-heading px-5 py-3.5 text-center text-[12px] font-semibold uppercase leading-snug tracking-[0.08em] text-balance text-white shadow-[0_10px_24px_rgba(40,96,63,0.28)] transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_16px_34px_rgba(40,96,63,0.35)] sm:w-auto sm:px-8 sm:text-[13px]"
          >
            {t(locale, 'coffee.heroRequest')}
          </a>
          <a
            href="#lot-details"
            class="inline-flex min-h-[48px] w-full max-w-full items-center justify-center rounded-full border border-heading/35 bg-white/65 px-5 py-2.5 text-center text-[11px] font-semibold uppercase leading-snug tracking-[0.1em] text-balance text-heading transition-all duration-300 hover:border-heading/60 hover:bg-white sm:w-auto"
          >
            {t(locale, 'coffee.heroDetails')}
          </a>
        </div>
        <p class="mt-4 text-[12px] text-ink/45">{t(locale, 'coffee.heroSheetsNote')}</p>
      </div>

      <div
        class:list={[
          'lg:col-span-7 transition-all duration-700 ease-out will-change-transform',
          isRetailPackHero ? 'lg:justify-self-center' : 'lg:justify-self-end',
        ]}
        data-coffee-hero-enter="right"
      >
        <div
          class:list={[
            'lot-photo-frame group/frame relative w-full max-w-none transition-[box-shadow,transform] duration-500 ease-out will-change-transform hover:-translate-y-1',
            isRetailPackHero
              ? 'lg:max-w-[min(100%,600px)] xl:max-w-[min(100%,640px)]'
              : 'lg:max-w-[min(100%,820px)] xl:max-w-[min(100%,920px)]',
          ]}
        >
          <div class="lot-photo-frame-inner w-full overflow-hidden">
            <button
              type="button"
              class="group/photo relative block w-full overflow-hidden bg-[#1a1510] text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-heading focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1510]"
              data-lot-lightbox-open
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-controls={lightboxId}
            >
              <img
                src={coverSrc}
                alt=""
                class:list={[
                  'aspect-[4/3] w-full object-cover contrast-[1.03] saturate-[1.04] transition duration-[1.15s] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/photo:scale-[1.05] lg:aspect-auto',
                  isRetailPackHero
                    ? 'object-center min-h-[260px] sm:min-h-[320px] lg:h-[min(54vh,560px)] lg:min-h-[360px]'
                    : 'object-[center_38%] min-h-[260px] sm:min-h-[340px] lg:h-[min(72vh,760px)] lg:min-h-[520px]',
                ]}
                loading="eager"
                decoding="async"
                width="800"
                height="600"
              />
              <div
                class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_78%_58%_at_50%_20%,rgba(212,168,72,0.26),transparent_60%),radial-gradient(ellipse_95%_85%_at_88%_100%,rgba(48,32,22,0.28),transparent_54%),linear-gradient(to_top,rgba(24,16,11,0.45),transparent_55%)]"
                aria-hidden="true"
              />
              <div class="pointer-events-none absolute inset-0 grain-overlay opacity-[0.4]" aria-hidden="true"></div>
              <div
                class="pointer-events-none absolute inset-x-0 bottom-0 h-[38%] bg-gradient-to-t from-[rgba(14,10,7,0.82)] via-[rgba(14,10,7,0.35)] to-transparent"
                aria-hidden="true"
              />
              <span
                class="pointer-events-none absolute bottom-3 right-3 flex items-center gap-1.5 rounded-full border border-white/35 bg-black/50 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-white/95 shadow-lg backdrop-blur-md"
              >
                <svg class="h-3.5 w-3.5 opacity-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                {t(locale, 'coffee.heroImageZoomHint')}
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<dialog
  id={lightboxId}
  class="lot-lightbox-dialog"
  aria-modal="true"
  aria-label={t(locale, 'coffee.lightboxAria')}
>
  <div
    class="flex h-full min-h-0 w-full cursor-pointer items-center justify-center p-4 md:p-10"
    data-lot-lightbox-pane
  >
    <button
      type="button"
      class="absolute right-3 top-3 z-20 flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-white/90 bg-white text-ink shadow-[0_4px_20px_rgba(0,0,0,0.45),0_0_0_1px_rgba(0,0,0,0.08)_inset] transition hover:border-heading hover:bg-heading hover:text-white hover:shadow-[0_6px_28px_rgba(0,0,0,0.35)] focus:outline-none focus-visible:ring-2 focus-visible:ring-heading focus-visible:ring-offset-2 focus-visible:ring-offset-transparent md:right-6 md:top-6"
      data-lot-lightbox-close
      aria-label={t(locale, 'coffee.lightboxClose')}
    >
      <svg
        class="h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
    <img
      src={coverSrc}
      alt=""
      class="lot-lightbox-img h-auto max-h-[min(88dvh,900px)] w-auto max-w-full cursor-default rounded-md object-contain shadow-[0_25px_80px_rgba(0,0,0,0.55)] ring-1 ring-white/12 contrast-[1.02] saturate-[1.03] sm:max-w-[min(100%,1200px)]"
      loading="eager"
      decoding="async"
    />
  </div>
</dialog>

<style is:global>
  .lot-lightbox-dialog {
    margin: 0;
    max-height: 100dvh;
    max-width: 100%;
    width: 100%;
    height: 100%;
    border: none;
    padding: 0;
    background: transparent;
  }
  .lot-lightbox-dialog::backdrop {
    background: rgba(8, 12, 18, 0.92);
    backdrop-filter: blur(6px);
  }
</style>

<script>
  function initLotLightbox() {
    const openBtn = document.querySelector('[data-lot-lightbox-open]');
    const dialog = document.querySelector('.lot-lightbox-dialog');
    const closeBtn = dialog?.querySelector('[data-lot-lightbox-close]');
    const pane = dialog?.querySelector('[data-lot-lightbox-pane]');
    if (!openBtn || !dialog || !(dialog instanceof HTMLDialogElement)) return;

    const setExpanded = (open: boolean) => {
      openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    const closeLightbox = () => {
      dialog.close();
      setExpanded(false);
    };

    openBtn.addEventListener('click', () => {
      dialog.showModal();
      setExpanded(true);
    });

    closeBtn?.addEventListener('click', () => {
      closeLightbox();
    });

    pane?.addEventListener('click', (e) => {
      if (e.target === pane) closeLightbox();
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeLightbox();
    });

    dialog.addEventListener('close', () => setExpanded(false));
  }

  function initCoffeeHeroEntryAnimation() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const left = document.querySelector<HTMLElement>('[data-coffee-hero-enter="left"]');
    const right = document.querySelector<HTMLElement>('[data-coffee-hero-enter="right"]');
    if (!left || !right) return;

    left.classList.add('opacity-0', '-translate-x-7');
    right.classList.add('opacity-0', 'translate-x-7');

    const obs = new IntersectionObserver(
      (entries) => {
        const hasVisibleEntry = entries.some((entry) => entry.isIntersecting);
        if (!hasVisibleEntry) return;

        left.classList.remove('opacity-0', '-translate-x-7');
        right.classList.remove('opacity-0', 'translate-x-7');
        obs.disconnect();
      },
      { threshold: 0.22, rootMargin: '0px 0px -6% 0px' }
    );

    obs.observe(left);
    obs.observe(right);
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', () => {
        initLotLightbox();
        initCoffeeHeroEntryAnimation();
      })
    : (initLotLightbox(), initCoffeeHeroEntryAnimation());
</script>
