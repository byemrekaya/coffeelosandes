---
import type { CoffeeLot } from '../../data/coffeeLots';
import type { Locale } from '../../i18n/types';
import { t } from '../../i18n/t';
import { withLang } from '../../i18n/paths';

interface Props {
  lot: CoffeeLot;
  locale: Locale;
}

const { lot, locale } = Astro.props;
const eyebrow = lot.collectionLabel ?? t(locale, 'coffee.heroSpecialty');
---

<section class="relative overflow-hidden border-b border-line pb-16 pt-28 md:pb-24 md:pt-36" data-reveal>
  <div class="pointer-events-none absolute -right-32 top-0 h-96 w-96 rounded-full bg-terracotta/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-bronze/10 blur-3xl" aria-hidden="true"></div>

  <div class="section-shell relative">
    <p class="stage-eyebrow mb-4 text-cream/55">{eyebrow}</p>

    <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <h1 class="font-display text-display-xl font-semibold tracking-tight-display text-cream">
          {lot.name}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-cream/75 md:text-xl">
          {lot.region}, {lot.country}
        </p>
      </div>

      <div class="flex flex-wrap items-end gap-8 lg:justify-end">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.2em] text-cream/45">{t(locale, 'coffee.heroCupScore')}</p>
          <p class="font-display text-4xl font-semibold tabular-nums text-gold md:text-5xl">{lot.score.toFixed(2)}</p>
        </div>
        <div class="h-12 w-px bg-line" aria-hidden="true"></div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.2em] text-cream/45">{t(locale, 'coffee.heroRank')}</p>
          <p class="font-display text-4xl font-semibold tabular-nums text-cream md:text-5xl">#{lot.rank}</p>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap gap-2">
      {lot.flavorTags.map((tag) => (
        <span class="rounded-lg border border-line bg-surface-muted px-3 py-1.5 text-[11px] font-medium uppercase tracking-wider text-ink/85">
          {tag}
        </span>
      ))}
    </div>
    <p class="mt-3 max-w-2xl text-[11px] leading-relaxed text-cream/45">{t(locale, 'coffee.flavorTagsLegend')}</p>

    <p class="mt-10 max-w-3xl text-[17px] leading-[1.65] text-cream/80">
      {lot.story}
    </p>

    <div class="mt-12 flex flex-col gap-3 sm:flex-row sm:items-center">
      <a href={withLang('/contact', locale)} class="btn-primary inline-flex justify-center px-8 py-3.5">
        {t(locale, 'coffee.heroRequest')}
      </a>
      <a
        href="#lot-details"
        class="btn-secondary inline-flex justify-center px-8 py-3.5"
      >
        {t(locale, 'coffee.heroDetails')}
      </a>
    </div>
    <p class="mt-4 text-[12px] text-cream/45">
      {t(locale, 'coffee.heroSheetsNote')}
    </p>
  </div>
</section>
