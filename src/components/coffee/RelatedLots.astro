---
import type { CoffeeLot } from '../../data/coffeeLots';
import type { Locale } from '../../i18n/types';
import { t } from '../../i18n/t';
import CoffeeLotCard from './CoffeeLotCard.astro';

interface Props {
  relatedLots: CoffeeLot[];
  locale: Locale;
}

const { relatedLots, locale } = Astro.props;
---

{relatedLots.length > 0 && (
  <section class="section-band-b border-t border-line pb-24 pt-20 md:pb-32 md:pt-24" data-reveal>
    <div class="section-shell">
      <div class="mb-12 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="stage-eyebrow mb-2">{t(locale, 'coffee.relatedEyebrow')}</p>
          <h2 class="font-display text-2xl font-semibold text-heading md:text-3xl">{t(locale, 'coffee.relatedTitle')}</h2>
        </div>
        <p class="max-w-md text-sm text-ink-muted">
          {t(locale, 'coffee.relatedDesc')}
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
        {relatedLots.map((lot) => (
          <CoffeeLotCard lot={lot} locale={locale} />
        ))}
      </div>
    </div>
  </section>
)}
