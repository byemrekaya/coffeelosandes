---
import { type CoffeeLot, lotScoreLine } from '../../data/coffeeLots';
import type { Locale } from '../../i18n/types';
import { t } from '../../i18n/t';

interface Props {
  lot: CoffeeLot;
  locale: Locale;
}

const { lot, locale } = Astro.props;

function resolveFermentationLabel(currentLot: CoffeeLot): string {
  if (currentLot.fermentation?.trim()) return currentLot.fermentation;
  const process = currentLot.process.toLowerCase();
  if (process.includes('experimental') || process.includes('anaerobic')) {
    return t(locale, 'coffee.techFermentationExperimental');
  }
  if (process.includes('natural') || process.includes('honey') || process.includes('washed')) {
    return t(locale, 'coffee.techFermentationControlled');
  }
  return t(locale, 'coffee.techFermentationDefault');
}

const origin = lot.region ? `${lot.country} – ${lot.region}` : lot.country;
const detailRows: { labelKey: string; value: string }[] = [
  { labelKey: 'coffee.techOrigin', value: origin },
  { labelKey: 'coffee.techFarm', value: lot.farm },
  { labelKey: 'coffee.techProducer', value: lot.producer },
  { labelKey: 'coffee.techVariety', value: lot.variety },
  { labelKey: 'coffee.techProcess', value: lot.process },
  { labelKey: 'coffee.techFermentation', value: resolveFermentationLabel(lot) },
  { labelKey: 'coffee.techAltitude', value: lot.altitudeMeters ?? '—' },
  { labelKey: 'coffee.techScore', value: lotScoreLine(lot) },
];

const tastingRows = lot.tastingStructured ?? [];
---

<section id="lot-details" class="border-y border-line bg-paper-deep/90 py-20 md:py-24" data-reveal>
  <div class="section-shell">
    <div class="mb-10 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="stage-eyebrow mb-2">{t(locale, 'coffee.techEyebrow')}</p>
        <h2 class="font-display text-2xl font-semibold text-ink md:text-3xl">{t(locale, 'coffee.techTitle')}</h2>
      </div>
      <p class="max-w-md text-sm text-ink/60">{t(locale, 'coffee.techDesc')}</p>
    </div>

    <div class="overflow-hidden border border-line/90 bg-surface shadow-card">
      <div class="h-1 w-full bg-gradient-to-r from-transparent via-gold to-transparent" aria-hidden="true"></div>
      <div class="px-5 py-6 md:px-8 md:py-7">
        <dl class="divide-y divide-line/70 overflow-hidden border border-line/80 bg-paper/50">
          {detailRows.map((row) => (
            <div class="flex flex-col gap-2 px-4 py-4 sm:flex-row sm:items-start sm:justify-between sm:gap-7 sm:px-5">
              <dt class="text-[10px] font-semibold uppercase tracking-[0.16em] text-ink/55">{t(locale, row.labelKey)}</dt>
              <dd class="text-[15px] font-semibold leading-snug text-ink sm:max-w-[62%] sm:text-right">{row.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    {
      tastingRows.length > 0 && (
        <div class="mt-12 border-t border-line/60 pt-12 md:mt-14 md:pt-14">
          <div class="mb-8">
            <p class="stage-eyebrow mb-2">{t(locale, 'coffee.tastingSheetEyebrow')}</p>
            <h3 class="font-display text-xl font-semibold tracking-tight text-ink md:text-2xl">
              {t(locale, 'coffee.tastingSheetTitle')}
            </h3>
          </div>
          <div class="overflow-hidden border border-line/90 bg-surface shadow-card">
            <div class="h-1 w-full bg-gradient-to-r from-transparent via-gold to-transparent" aria-hidden="true"></div>
            <div class="px-5 py-6 md:px-8 md:py-7">
              <dl class="divide-y divide-line/70 overflow-hidden border border-line/80 bg-paper/50">
                {tastingRows.map((row) => (
                  <div class="flex flex-col gap-2 px-4 py-4 sm:flex-row sm:items-start sm:justify-between sm:gap-7 sm:px-5">
                    <dt class="max-w-[min(100%,220px)] shrink-0 text-[10px] font-semibold uppercase tracking-[0.16em] text-ink/55">
                      {row.label}
                    </dt>
                    <dd class="text-[15px] font-semibold leading-relaxed text-ink sm:max-w-[62%] sm:text-right">
                      {row.value}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>
