---
import type { Locale } from '../../i18n/types';
import { t } from '../../i18n/t';
import { withLang } from '../../i18n/paths';

interface Props {
  lotName: string;
  locale: Locale;
}

const { lotName, locale } = Astro.props;
const title = t(locale, 'coffee.ctaTitle').replace('{name}', lotName);
---

<section class="section-band-a border-t border-line pb-24 pt-12 md:pb-32 md:pt-16" data-reveal>
  <div class="section-shell">
    <div class="mx-auto max-w-3xl text-center">
      <div class="space-y-4">
        <p class="stage-eyebrow">{t(locale, 'coffee.wholesale')}</p>
        <h2 class="stage-heading">{title}</h2>
        <p class="stage-subtitle">{t(locale, 'coffee.ctaBody')}</p>
      </div>

      <div class="mt-8 flex justify-center">
        <a href={withLang('/contact', locale)} class="btn-primary px-10">
          {t(locale, 'coffee.ctaPrimary')}
        </a>
      </div>
    </div>
  </div>
</section>
