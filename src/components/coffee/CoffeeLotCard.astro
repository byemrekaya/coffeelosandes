---
import { type CoffeeLot, getLotImageAlt, getLotImageSrc, lotScoreLine } from '../../data/coffeeLots';
import type { Locale } from '../../i18n/types';
import { withLang } from '../../i18n/paths';
import { t } from '../../i18n/t';

interface Props {
  lot: CoffeeLot;
  locale: Locale;
}

const { lot, locale } = Astro.props;

const coverSrc = getLotImageSrc(lot.slug);
const coverAlt = getLotImageAlt(lot.slug, lot.name);

const segmentLabelKey =
  lot.segment === 'competition-lots'
    ? 'products.segmentLabelCompetition'
    : lot.segment === 'premium-microlot'
      ? 'products.segmentLabelMicro'
      : lot.segment === 'specialty-series'
        ? 'products.segmentLabelSpecialty'
        : lot.segment === 'barista-blend'
          ? 'products.segmentLabelBarista'
          : lot.segment === 'commercial'
            ? 'products.segmentLabelCommercial'
            : 'products.segmentLabelRetail';
---

<a
  href={withLang(`/coffees/${lot.slug}`, locale)}
  class="group relative flex h-full min-h-[34rem] flex-col overflow-hidden rounded-[24px] border border-[#ddd4c7] bg-[#fcfbf7] shadow-[0_10px_30px_rgba(0,0,0,0.04)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_18px_40px_rgba(0,0,0,0.08)]"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-[#e9e2d6]">
    <img
      src={coverSrc}
      alt={coverAlt}
      class="absolute inset-0 h-full w-full object-cover object-[center_38%] transition duration-500 ease-out group-hover:scale-[1.03]"
      loading="lazy"
      decoding="async"
      width="800"
      height="600"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent"
      aria-hidden="true"
    />
    <div class="absolute inset-x-4 top-4 flex items-center justify-between gap-2">
      <p class="inline-flex items-center rounded-full border border-white/35 bg-white/15 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-white backdrop-blur-sm">
        {lot.collectionLabel ?? t(locale, segmentLabelKey)}
      </p>
      <span class="inline-flex rounded-full bg-black/80 px-3 py-1.5 text-[12px] font-semibold text-white backdrop-blur-sm">
        {lotScoreLine(lot)}
      </span>
    </div>
  </div>

  <div class="flex flex-1 flex-col justify-between p-6">
    <div>
      <h3 class="font-display text-[1.75rem] font-semibold leading-[1.08] tracking-header text-heading md:text-[1.95rem]">
        {lot.name}
      </h3>
      <p class="mt-2 text-[11px] font-medium uppercase tracking-[0.16em] text-[#8a847b]">
        {lot.region}, {lot.country}
      </p>
      <p class="mt-4 overflow-hidden text-[16px] leading-[1.6] text-[#5f5b55] [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:4]">
        {lot.commercialSummary}
      </p>
    </div>

    <div class="mt-6 border-t border-[#e7dfd3] pt-5 text-center">
      <span class="text-[13px] font-semibold uppercase tracking-[0.16em] text-heading transition group-hover:tracking-[0.18em]">
        {t(locale, 'home.lotDetail')}
      </span>
    </div>
  </div>
</a>
