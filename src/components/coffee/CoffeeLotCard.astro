---
import type { CoffeeLot } from '../../data/coffeeLots';
import type { Locale } from '../../i18n/types';
import { withLang } from '../../i18n/paths';
import { t } from '../../i18n/t';

interface Props {
  lot: CoffeeLot;
  locale: Locale;
}

const { lot, locale } = Astro.props;

const segmentLabelKey =
  lot.segment === 'ultra-premium'
    ? 'products.segmentLabelUltra'
    : lot.segment === 'special-series'
      ? 'products.segmentLabelSpecial'
      : 'products.segmentLabelBlend';
---

<a
  href={withLang(`/coffees/${lot.slug}`, locale)}
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface shadow-card transition-all duration-300 hover:-translate-y-0.5 hover:border-stone-300 hover:shadow-card-hover"
>
  <div class="relative aspect-[4/3] overflow-hidden">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_10%_0,rgba(245,233,216,0.12),transparent_55%),radial-gradient(circle_at_90%_100%,rgba(192,138,77,0.45),transparent_60%)] transition duration-700 group-hover:scale-105"
    />
    <div class="absolute inset-0 grain-overlay" />
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black via-black/40 to-transparent" />
    <div class="absolute inset-5 flex flex-col justify-between">
      <div>
        <p class="mb-2 inline-block rounded-full border border-white/35 bg-black/30 px-2 py-0.5 text-[9px] font-semibold uppercase tracking-[0.14em] text-white/95">
          {t(locale, segmentLabelKey)}
        </p>
        <p class="text-[11px] font-medium uppercase tracking-[0.2em] text-white/60">#{lot.rank} · {lot.score.toFixed(2)}</p>
        <h3 class="font-display text-lg text-white drop-shadow-sm">{lot.name}</h3>
      </div>
      <p class="text-[11px] text-white/75">
        {lot.region}, {lot.country} · {lot.process}
      </p>
    </div>
  </div>

  <div class="flex flex-1 flex-col justify-between gap-4 px-5 py-4 text-[12px] text-cream/70">
    <p class="line-clamp-3">{lot.commercialSummary}</p>
    <div class="flex flex-wrap gap-2">
      {lot.flavorTags.slice(0, 4).map((note) => (
        <span class="rounded-lg border border-line bg-stone-100/80 px-3 py-1.5 text-[11px] font-medium uppercase tracking-wider text-cream/80">
          {note}
        </span>
      ))}
    </div>
  </div>
</a>
