---
import type { CoffeeLot } from '../../data/coffeeLots';
import type { Locale } from '../../i18n/types';
import { t } from '../../i18n/t';

interface Props {
  lot: CoffeeLot;
  locale: Locale;
}

const { lot, locale } = Astro.props;

const cardTitles = [
  t(locale, 'coffee.buyerCard1Title'),
  t(locale, 'coffee.buyerCard2Title'),
  t(locale, 'coffee.buyerCard3Title'),
];
---

<section class="section-band-a border-t border-line py-20 md:py-28" data-reveal>
  <div class="section-shell">
    <div class="mx-auto max-w-3xl text-center">
      <p class="stage-eyebrow mb-4">{t(locale, 'coffee.buyerEyebrow')}</p>
      <h2 class="font-display text-display-md font-semibold tracking-tight-display text-heading">
        {t(locale, 'coffee.buyerTitle')}
      </h2>
      <p class="mt-4 text-[15px] text-ink-muted">
        {t(locale, 'coffee.buyerSubtitle')}
      </p>
    </div>

    <div class="mx-auto mt-14 grid gap-6 md:grid-cols-3">
      {lot.buyerUseCases.map((item, idx) => (
        <article
          class:list={[
            'group rounded-2xl border p-6 text-left shadow-[0_8px_26px_rgba(14,12,10,0.06)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_18px_36px_rgba(14,12,10,0.14)]',
            idx === 0
              ? 'border-heading/35 bg-white ring-1 ring-heading/15'
              : 'border-line bg-surface',
          ]}
        >
          <div class="mb-4 flex w-full justify-center">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-heading/25 bg-heading/10 text-heading">
            {idx === 0 && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="m12 2.8 2.85 5.77 6.37.92-4.61 4.49 1.09 6.34L12 17.3l-5.7 3 1.09-6.34L2.78 9.49l6.37-.92L12 2.8Z" stroke-linejoin="round"></path>
              </svg>
            )}
            {idx === 1 && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M7 14a5 5 0 0 0 10 0V9H7z"></path>
                <path d="M17 11h1a2 2 0 1 1 0 4h-1"></path>
              </svg>
            )}
            {idx >= 2 && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M12 2 4 6v6c0 5.2 3.4 8.6 8 10 4.6-1.4 8-4.8 8-10V6l-8-4Z"></path>
                <path d="m9.5 12 1.7 1.7 3.3-3.3" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            )}
            </span>
          </div>

          <h3 class="text-[16px] font-semibold leading-snug text-ink">
            {cardTitles[idx] ?? t(locale, 'coffee.buyerTitle')}
          </h3>
          <p class="mt-3 text-[14px] leading-relaxed text-ink/80">
            {item}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
