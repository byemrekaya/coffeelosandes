---
interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const { eyebrow, title, body, primaryLabel, primaryHref, secondaryLabel, secondaryHref } = Astro.props;
---

<section class="mt-24" data-reveal>
  <div class="section-shell">
    <div class="glass-panel texture-overlay relative overflow-hidden px-6 py-10 md:px-10 md:py-14">
      <div
        class="pointer-events-none absolute -right-20 -top-28 h-64 w-64 rounded-full bg-gradient-to-br from-terracotta/30 via-bronze/5 to-transparent blur-3xl"
        aria-hidden="true"
      ></div>

      <div class="relative flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
        <div class="max-w-xl space-y-3">
          {eyebrow && <p class="stage-eyebrow">{eyebrow}</p>}
          <h2 class="stage-heading text-2xl md:text-3xl lg:text-4xl">{title}</h2>
          <p class="stage-subtitle">{body}</p>
        </div>

        <div class="flex flex-col gap-3 md:flex-row md:items-center">
          <a href={primaryHref} class="btn-primary">
            {primaryLabel}
          </a>
          {secondaryHref && secondaryLabel && (
            <a href={secondaryHref} class="btn-secondary">
              {secondaryLabel}
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

