---
interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  /** Bölüm zemini: A = krem (paper), B = beyaz (surface) — sayfa sırasına göre seçin */
  variant?: 'a' | 'b';
}

const {
  eyebrow,
  title,
  body,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  variant = 'b',
} = Astro.props;

const bandClass = variant === 'a' ? 'section-band-a' : 'section-band-b';
---

<section class:list={[bandClass, 'w-full py-16 md:py-24']} data-reveal>
  <div class="section-shell">
    <div class="flex flex-col gap-10 md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl space-y-4">
        {eyebrow && <p class="stage-eyebrow">{eyebrow}</p>}
        <h2 class="stage-heading">{title}</h2>
        <p class="stage-subtitle">{body}</p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row md:items-center md:shrink-0">
        <a href={primaryHref} class="btn-primary">
          {primaryLabel}
        </a>
        {secondaryHref && secondaryLabel && (
          <a href={secondaryHref} class="btn-secondary">
            {secondaryLabel}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
