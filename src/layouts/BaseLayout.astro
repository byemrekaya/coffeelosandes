---
import '../styles/global.css';
import type { Locale } from '../i18n/types';
import { locales } from '../i18n/types';
import { dictionary } from '../i18n/dictionary';
import { defaultLocale, resolveLocale } from '../i18n/config';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CookieConsentModal from '../components/CookieConsentModal.astro';
import { site } from '../config/site';
import { withLang, stripLocaleFromPath } from '../i18n/paths';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  hideFooter?: boolean;
  fullpage?: boolean;
  noindex?: boolean;
}

const {
  locale: localeProp,
  title = site.defaultTitle,
  description = site.defaultDescription,
  ogImage: ogImageProp,
  ogImageAlt: ogImageAltProp,
  hideFooter = false,
  fullpage = false,
  noindex = false,
} = Astro.props;

const locale = resolveLocale(localeProp as string | undefined);
const htmlLang = String(
  dictionary[locale]?.htmlLang ?? locale
);

const origin = site.canonicalOrigin.replace(/\/$/, '');
const pathname = Astro.url.pathname;
const canonicalURL = new URL(pathname, `${origin}/`).href;

const ogImageRaw = ogImageProp ?? site.ogImage;
const ogImageURL = ogImageRaw.startsWith('http')
  ? ogImageRaw
  : new URL(ogImageRaw.replace(/^\//, ''), `${origin}/`).href;
const ogImageAltResolved =
  ogImageAltProp?.trim() ||
  `${site.name} — ${description.replace(/\s+/g, ' ').trim().slice(0, 160)}`;
const ogLocaleMap: Record<string, string> = {
  tr: 'tr_TR',
  de: 'de_DE',
  en: 'en_US',
  fr: 'fr_FR',
  es: 'es_ES',
  nl: 'nl_NL',
  pl: 'pl_PL',
  cs: 'cs_CZ',
  it: 'it_IT',
  ru: 'ru_RU',
  ar: 'ar_AR',
};
const ogLocale = ogLocaleMap[htmlLang] ?? 'de_DE';
const ogAlternateLocales = Object.values(ogLocaleMap).filter((loc) => loc !== ogLocale);

const pathWithoutLocale = stripLocaleFromPath(pathname);
const altPaths = locales.map((loc) => {
  const p = withLang(pathWithoutLocale === '/' ? '/' : pathWithoutLocale, loc);
  return { loc, href: new URL(p, `${origin}/`).href, hreflang: String(dictionary[loc]?.htmlLang ?? loc) };
});
const xDefaultHref = new URL(
  withLang(pathWithoutLocale === '/' ? '/' : pathWithoutLocale, defaultLocale),
  `${origin}/`
).href;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalEntityName,
  url: origin,
  email: site.contactEmail,
  brand: site.name,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: origin,
  inLanguage: locales.map((loc) => String(dictionary[loc]?.htmlLang ?? loc)),
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {!noindex && altPaths.map(({ href, hreflang }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}
    <link rel="icon" href="/coffeelosandes-navbar-logo.svg?v=1" type="image/svg+xml" />
    <link rel="shortcut icon" href="/coffeelosandes-navbar-logo.svg?v=1" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/coffeelosandes-navbar-logo.svg" />
    {!noindex && (
      <>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:locale" content={ogLocale} />
        {ogAlternateLocales.map((alt) => <meta property="og:locale:alternate" content={alt} />)}
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:alt" content={ogImageAltResolved} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />
        <meta name="twitter:image:alt" content={ogImageAltResolved} />
      </>
    )}
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    <meta name="theme-color" content="#28603f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class:list={[
      'page-shell relative max-w-full overflow-x-hidden',
      fullpage ? 'h-screen flex flex-col overflow-hidden' : '',
    ]}
  >
    <div class="pointer-events-none fixed inset-0 -z-20 bg-paper"></div>
    <div class="pointer-events-none fixed inset-0 -z-10 texture-overlay opacity-55"></div>
    <Navbar locale={locale} />
    <main
      class:list={[
        fullpage ? 'flex-1 min-h-0 overflow-hidden' : 'min-w-0 w-full max-w-full overflow-x-hidden',
      ]}
    >
      <slot />
    </main>
    {!hideFooter && <Footer locale={locale} />}
    <CookieConsentModal locale={locale} />

    <script>
      import { initScrollReveal } from '../client/scroll-reveal';
      function run() {
        initScrollReveal();
      }
      document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', run) : run();
    </script>
  </body>
</html>

<style is:global>
  /* Arabic: text flows right-to-left, layout stays left-to-right */
  :lang(ar) p,
  :lang(ar) h1,
  :lang(ar) h2,
  :lang(ar) h3,
  :lang(ar) h4,
  :lang(ar) h5,
  :lang(ar) h6,
  :lang(ar) li,
  :lang(ar) dt,
  :lang(ar) dd,
  :lang(ar) blockquote,
  :lang(ar) label,
  :lang(ar) td,
  :lang(ar) th {
    direction: rtl;
    unicode-bidi: embed;
    text-align: right;
  }
</style>
