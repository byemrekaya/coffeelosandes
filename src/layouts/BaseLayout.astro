---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
  fullpage?: boolean;
}

const {
  title = site.defaultTitle,
  description = site.defaultDescription,
  hideFooter = false,
  fullpage = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta name="theme-color" content="#0A0908" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={fullpage ? 'page-shell relative overflow-hidden h-screen flex flex-col' : 'page-shell relative overflow-x-hidden'}>
    <div class="pointer-events-none fixed inset-0 -z-20 bg-charcoal"></div>
    <div class="pointer-events-none fixed inset-0 -z-10 texture-overlay opacity-50"></div>
    <Navbar />
    <main class={fullpage ? 'flex-1 min-h-0 overflow-hidden' : ''}>
      <slot />
    </main>
    {!hideFooter && <Footer />}

    <script>
      import { initScrollReveal } from '../client/scroll-reveal';
      function run() {
        initScrollReveal();
      }
      document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', run) : run();
    </script>
  </body>
</html>

