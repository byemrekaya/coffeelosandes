---
import '../styles/global.css';
import type { Locale } from '../i18n/types';
import { dictionary } from '../i18n/dictionary';
import { defaultLocale, resolveLocale } from '../i18n/config';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  hideFooter?: boolean;
  fullpage?: boolean;
}

const {
  locale: localeProp,
  title = site.defaultTitle,
  description = site.defaultDescription,
  hideFooter = false,
  fullpage = false,
} = Astro.props;

const locale = resolveLocale(localeProp as string | undefined);
const htmlLang = String(
  dictionary[locale]?.htmlLang ?? dictionary[defaultLocale].htmlLang ?? 'tr'
);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta name="theme-color" content="#0D2C3F" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={fullpage ? 'page-shell relative h-screen flex flex-col overflow-hidden' : 'page-shell relative overflow-x-hidden'}>
    <div class="pointer-events-none fixed inset-0 -z-20 bg-paper"></div>
    <div class="pointer-events-none fixed inset-0 -z-10 texture-overlay opacity-55"></div>
    <Navbar locale={locale} />
    <main class={fullpage ? 'flex-1 min-h-0 overflow-hidden' : ''}>
      <slot />
    </main>
    {!hideFooter && <Footer locale={locale} />}

    <script>
      import { initScrollReveal } from '../client/scroll-reveal';
      function run() {
        initScrollReveal();
      }
      document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', run) : run();
    </script>
  </body>
</html>
