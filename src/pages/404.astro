---
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLocale } from '../i18n/config';
import { t } from '../i18n/t';
import { withLang } from '../i18n/paths';

const locale = defaultLocale;
---

<BaseLayout
  locale={locale}
  title={t(locale, 'error404.title')}
  description={t(locale, 'error404.description')}
  noindex={true}
>
  <section class="section-shell pt-40 pb-28">
    <div class="max-w-xl">
      <p class="stage-eyebrow mb-3 text-ink/55">404</p>
      <h1 class="font-display text-4xl font-semibold tracking-header text-heading md:text-5xl">
        {t(locale, 'error404.heading')}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-muted">{t(locale, 'error404.body')}</p>
      <a
        href={withLang('/', locale)}
        class="btn-primary mt-10 inline-flex px-8 py-3.5 text-[11px] font-semibold uppercase tracking-brand"
      >
        {t(locale, 'error404.backHome')}
      </a>
    </div>
  </section>
</BaseLayout>
