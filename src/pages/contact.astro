---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { site, mailtoB2B } from '../config/site';
---

<BaseLayout
  title="Contact – B2B Wholesale Inquiry | Coffee Los Andes"
  description="Get in touch with Coffee Los Andes for wholesale coffee partnerships, distribution inquiries, and B2B collaboration. Premium Venezuelan-origin coffee for cafés, restaurants, and corporate partners."
>
  <section class="pt-36 pb-20">
    <div class="section-shell space-y-10">
      <SectionHeader
        eyebrow="B2B İletişim"
        title="Toptan iş birliği talebinizi iletin"
        description="Coffee Los Andes ekibi, hacim ihtiyaçlarınızı, menü hedeflerinizi ve operasyonel gerçekliklerinizi dinlemek için hazır. Formu doldurun; en kısa sürede sizinle iletişime geçeceğiz."
      />
    </div>
  </section>

  <section class="pb-24">
    <div class="section-shell grid gap-16 lg:grid-cols-[1fr_minmax(0,1.2fr)] lg:items-start">
      <div class="space-y-8">
        <div>
          <h3 class="stage-eyebrow mb-3">İletişim Bilgileri</h3>
          <ul class="space-y-3 text-sm text-cream/70">
            <li>
              <strong class="text-cream/90">E-posta:</strong>
              <a href={mailtoB2B} class="ml-2 text-gold hover:text-cream transition">{site.contactEmail}</a>
            </li>
            <li>
              <strong class="text-cream/90">Bölge:</strong>
              Venezüella merkezli, küresel B2B ağı
            </li>
            <li class="pt-4 text-[12px] text-cream/50">
              Detaylı iletişim bilgileri ve ofis adresleri, talebiniz üzerine paylaşılacaktır.
            </li>
          </ul>
        </div>

        <div class="glass-panel px-6 py-8">
          <h3 class="stage-eyebrow mb-4">Kimler İletişime Geçmeli?</h3>
          <ul class="space-y-2 text-sm text-cream/70">
            <li>• Kafe ve restoran zincirleri</li>
            <li>• Otel ve hospitality grupları</li>
            <li>• Kurumsal ofis kahve çözümleri</li>
            <li>• Dağıtım ve wholesale ortakları</li>
            <li>• Özel etiket / white-label projeleri</li>
          </ul>
        </div>

        <div class="rounded-xl border border-cream/[0.08] bg-espresso/40 p-6">
          <h3 class="stage-eyebrow mb-3">Bölge Haritası</h3>
          <div class="aspect-[4/3] rounded-xl bg-charcoal/80 flex items-center justify-center border border-cream/5">
            <p class="text-xs text-cream/40 uppercase tracking-[0.2em]">
              Venezüella · And Etekleri · Plantasyon Bölgeleri
            </p>
          </div>
          <p class="mt-3 text-[11px] text-cream/50">
            Harita placeholder. Gerçek harita entegrasyonu proje gereksinimlerine göre eklenebilir.
          </p>
        </div>
      </div>

      <div>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
