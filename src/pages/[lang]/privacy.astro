---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangStaticPaths } from '../../i18n/staticPaths';
import type { Locale } from '../../i18n/types';
import SectionHeader from '../../components/SectionHeader.astro';
import { t } from '../../i18n/t';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params;
const locale = lang as Locale;
---

<BaseLayout locale={locale} title={t(locale, 'privacy.title')} description={t(locale, 'privacy.description')}>
  <section class="pt-36 pb-20">
    <div class="section-shell space-y-10">
      <SectionHeader
        eyebrow={t(locale, 'privacy.heroEyebrow')}
        title={t(locale, 'privacy.heroTitle')}
      />
    </div>
  </section>

  <section class="pb-24">
    <div class="section-shell max-w-3xl space-y-8 text-[15px] leading-relaxed text-ink/85">
      <section class="space-y-3">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-heading">{t(locale, 'privacy.controllerTitle')}</h2>
        <p>{t(locale, 'privacy.controllerBody')}</p>
      </section>

      <section class="space-y-3">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-heading">{t(locale, 'privacy.hostingTitle')}</h2>
        <p>{t(locale, 'privacy.hostingBody')}</p>
        <p>{t(locale, 'privacy.hostingBody2')}</p>
      </section>

      <section class="space-y-3">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-heading">{t(locale, 'privacy.dataTypesTitle')}</h2>
        <p>{t(locale, 'privacy.dataTypesBody')}</p>
      </section>

      <section class="space-y-3">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-heading">{t(locale, 'privacy.legalBasisTitle')}</h2>
        <p>{t(locale, 'privacy.legalBasisBody')}</p>
      </section>

      <section class="space-y-3">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-heading">{t(locale, 'privacy.cookiesTitle')}</h2>
        <p>{t(locale, 'privacy.cookiesBody')}</p>
      </section>

      <section class="space-y-3">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-heading">{t(locale, 'privacy.rightsTitle')}</h2>
        <p>{t(locale, 'privacy.rightsBody')}</p>
      </section>

      <p class="text-[13px] text-ink/60">{t(locale, 'privacy.lastUpdated')}</p>
    </div>
  </section>
</BaseLayout>
