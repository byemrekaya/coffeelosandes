---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangStaticPaths } from '../../i18n/staticPaths';
import type { Locale } from '../../i18n/types';
import { t } from '../../i18n/t';
import CTASection from '../../components/CTASection.astro';
import { withLang } from '../../i18n/paths';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params;
const locale = lang as Locale;

const blocks = [
  { titleKey: 'qualityPage.sgsTitle', bodyKey: 'qualityPage.sgsBody' },
  { titleKey: 'qualityPage.insaiTitle', bodyKey: 'qualityPage.insaiBody' },
  { titleKey: 'qualityPage.qTitle', bodyKey: 'qualityPage.qBody' },
  { titleKey: 'qualityPage.fourCTitle', bodyKey: 'qualityPage.fourCBody' },
] as const;
---

<BaseLayout locale={locale} title={t(locale, 'qualityPage.title')} description={t(locale, 'qualityPage.description')}>
  <section class="section-band-a w-full pb-16 pt-32 md:pb-20 md:pt-36">
    <div class="section-shell max-w-3xl">
      <p class="stage-eyebrow mb-3">{t(locale, 'qualityPage.heroEyebrow')}</p>
      <h1 class="font-display text-display-md font-semibold tracking-header text-heading">{t(locale, 'qualityPage.heroTitle')}</h1>
      <p class="mt-6 text-base leading-relaxed text-ink-muted">{t(locale, 'qualityPage.heroDesc')}</p>
    </div>
  </section>

  <section class="section-band-b w-full py-16 md:py-24">
    <div class="section-shell grid gap-10 md:grid-cols-2 md:gap-12">
      {blocks.map((b) => (
        <article class="border-l-[3px] border-heading/30 pl-6 md:pl-8" data-reveal>
          <h2 class="font-display text-lg font-semibold text-heading md:text-xl">{t(locale, b.titleKey)}</h2>
          <p class="mt-4 text-sm leading-relaxed text-ink-muted">{t(locale, b.bodyKey)}</p>
        </article>
      ))}
    </div>
  </section>

  <CTASection
    variant="a"
    eyebrow={t(locale, 'cta.eyebrow')}
    title={t(locale, 'cta.title')}
    body={t(locale, 'cta.body')}
    primaryLabel={t(locale, 'cta.primary')}
    primaryHref={withLang('/contact', locale)}
    secondaryLabel={t(locale, 'cta.secondary')}
    secondaryHref={withLang('/products', locale)}
  />
</BaseLayout>
