---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangStaticPaths } from '../../i18n/staticPaths';
import type { Locale } from '../../i18n/types';
import ContactForm from '../../components/ContactForm.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { site, mailtoB2B } from '../../config/site';
import { t } from '../../i18n/t';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params;
const locale = lang as Locale;
---

<BaseLayout locale={locale} title={t(locale, 'contact.title')} description={t(locale, 'contact.description')}>
  <section class="pt-36 pb-20">
    <div class="section-shell space-y-10">
      <SectionHeader
        eyebrow={t(locale, 'contact.heroEyebrow')}
        title={t(locale, 'contact.heroTitle')}
        description={t(locale, 'contact.heroDesc')}
      />
    </div>
  </section>

  <section class="pb-24">
    <div class="section-shell grid gap-16 lg:grid-cols-[1fr_minmax(0,1.2fr)] lg:items-start">
      <div class="space-y-8">
        <div>
          <h3 class="stage-eyebrow mb-3">{t(locale, 'contact.infoTitle')}</h3>
          <ul class="space-y-3 text-sm text-cream/70">
            <li>
              <strong class="text-cream/90">{t(locale, 'contact.emailLabel')}</strong>
              <a href={mailtoB2B} class="ml-2 text-gold hover:text-cream transition">{site.contactEmail}</a>
            </li>
            <li>
              <strong class="text-cream/90">{t(locale, 'contact.regionLabel')}</strong>
              {t(locale, 'contact.regionValue')}
            </li>
            <li>
              <strong class="text-cream/90">{t(locale, 'contact.partnerLabel')}</strong>
              {t(locale, 'contact.partnerValue')}
            </li>
            <li class="pt-4 text-[12px] text-cream/50">
              {t(locale, 'contact.infoFootnote')}
            </li>
          </ul>
        </div>

        <div class="glass-panel px-6 py-8">
          <h3 class="stage-eyebrow mb-4">{t(locale, 'contact.whoTitle')}</h3>
          <ul class="space-y-2 text-sm text-cream/70">
            <li>{t(locale, 'contact.who1')}</li>
            <li>{t(locale, 'contact.who2')}</li>
            <li>{t(locale, 'contact.who3')}</li>
            <li>{t(locale, 'contact.who4')}</li>
            <li>{t(locale, 'contact.who5')}</li>
          </ul>
        </div>

        <div class="rounded-xl border border-line bg-surface-muted p-6">
          <h3 class="stage-eyebrow mb-3">{t(locale, 'contact.mapTitle')}</h3>
          <div class="aspect-[4/3] rounded-xl bg-surface/95 flex items-center justify-center border border-line">
            <p class="text-xs text-cream/40 uppercase tracking-[0.2em]">
              {t(locale, 'contact.mapPlaceholder')}
            </p>
          </div>
          <p class="mt-3 text-[11px] text-cream/50">
            {t(locale, 'contact.mapNote')}
          </p>
        </div>
      </div>

      <div>
        <ContactForm locale={locale} />
      </div>
    </div>
  </section>
</BaseLayout>
