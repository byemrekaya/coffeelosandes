---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangStaticPaths } from '../../../i18n/staticPaths';
import SectionHeader from '../../../components/SectionHeader.astro';
import CoffeeLotCard from '../../../components/coffee/CoffeeLotCard.astro';
import { getLotsBySegment } from '../../../data/coffeeLots';
import { localizeCoffeeLots } from '../../../i18n/localizeLot';
import { t } from '../../../i18n/t';
import { resolveLocale } from '../../../i18n/config';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params;
const locale = resolveLocale(lang);

const competition = localizeCoffeeLots(getLotsBySegment('competition-lots'), locale);
const microlot = localizeCoffeeLots(getLotsBySegment('premium-microlot'), locale);
const specialty = localizeCoffeeLots(getLotsBySegment('specialty-series'), locale);
const barista = localizeCoffeeLots(getLotsBySegment('barista-blend'), locale);
const commercial = localizeCoffeeLots(getLotsBySegment('commercial'), locale);
const retail = localizeCoffeeLots(getLotsBySegment('retail'), locale);
---

<BaseLayout
  locale={locale}
  title={t(locale, 'products.awardedTitle')}
  description={t(locale, 'products.awardedDescription')}
  ogImage="/geisha-premium-coffee.webp"
  ogImageAlt={t(locale, 'products.awardedTitle')}
>
  <section class="border-b border-line pb-16 pt-32 md:pb-20 md:pt-36">
    <div class="section-shell">
      <SectionHeader
        eyebrow={t(locale, 'home.awardedSectionTitle')}
        title={t(locale, 'home.awardedSectionTitle')}
        description={t(locale, 'home.awardedSectionIntro')}
        align="center"
      />
    </div>
  </section>

  <section id="awarded-products" class="section-band-a py-16 md:py-20">
    <div class="section-shell">
      <div class="mb-8 max-w-3xl">
        <h2 class="font-display text-xl font-semibold text-heading md:text-2xl">{t(locale, 'products.segmentCompetitionTitle')}</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'products.segmentCompetitionDesc')}</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
        {competition.map((lot) => (
          <CoffeeLotCard lot={lot} locale={locale} />
        ))}
      </div>
    </div>
  </section>

  <section class="section-band-b border-t border-line/60 py-16 md:py-20">
    <div class="section-shell">
      <div class="mb-8 max-w-3xl">
        <h2 class="font-display text-xl font-semibold text-heading md:text-2xl">{t(locale, 'products.segmentMicroTitle')}</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'products.segmentMicroDesc')}</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
        {microlot.map((lot) => (
          <CoffeeLotCard lot={lot} locale={locale} />
        ))}
      </div>
    </div>
  </section>

  <section class="section-band-a border-t border-line/60 py-16 md:py-20">
    <div class="section-shell">
      <div class="mb-8 max-w-3xl">
        <h2 class="font-display text-xl font-semibold text-heading md:text-2xl">{t(locale, 'products.segmentSpecialtyTitle')}</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'products.segmentSpecialtyDesc')}</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
        {specialty.map((lot) => (
          <CoffeeLotCard lot={lot} locale={locale} />
        ))}
      </div>
    </div>
  </section>

  <section class="section-band-b border-t border-line/60 py-16 md:py-20">
    <div class="section-shell">
      <div class="mb-8 max-w-3xl">
        <h2 class="font-display text-xl font-semibold text-heading md:text-2xl">{t(locale, 'products.segmentBaristaTitle')}</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'products.segmentBaristaDesc')}</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
        {barista.map((lot) => (
          <CoffeeLotCard lot={lot} locale={locale} />
        ))}
      </div>
    </div>
  </section>

  <section class="section-band-a border-t border-line/60 py-16 md:py-20">
    <div class="section-shell">
      <div class="mb-8 max-w-3xl">
        <h2 class="font-display text-xl font-semibold text-heading md:text-2xl">{t(locale, 'products.segmentCommercialTitle')}</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'products.segmentCommercialDesc')}</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
        {commercial.map((lot) => (
          <CoffeeLotCard lot={lot} locale={locale} />
        ))}
      </div>
    </div>
  </section>

  <section class="section-band-b border-t border-line/60 py-16 md:py-20">
    <div class="section-shell">
      <div class="mb-8 max-w-3xl">
        <h2 class="font-display text-xl font-semibold text-heading md:text-2xl">{t(locale, 'products.segmentRoastedTitle')}</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'products.segmentRoastedDesc')}</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
        {retail.map((lot) => (
          <CoffeeLotCard lot={lot} locale={locale} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
