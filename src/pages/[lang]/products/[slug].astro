---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CoffeeMasterCard from '../../../components/products/CoffeeMasterCard.astro';
import { buildLangSlugStaticPaths } from '../../../i18n/staticPaths';
import { resolveLocale } from '../../../i18n/config';
import { venezuelaCoffeeMasterWithSlug } from '../../../data/venezuelaCoffeeMaster';
import { withLang } from '../../../i18n/paths';
import { t } from '../../../i18n/t';

export function getStaticPaths() {
  return buildLangSlugStaticPaths(
    venezuelaCoffeeMasterWithSlug,
    (item) => item.slug,
    (item) => ({ item }),
  );
}

interface Props {
  item: (typeof venezuelaCoffeeMasterWithSlug)[number];
}

const { item } = Astro.props;
const { lang } = Astro.params;
const locale = resolveLocale(lang);

const related = venezuelaCoffeeMasterWithSlug
  .filter((candidate) => candidate.segment === item.segment && candidate.slug !== item.slug)
  .slice(0, 3);

const title = `${item.cesit} · ${item.bolge} · ${item.cupping_score} · Coffee Los Andes`;
const description = `${item.cesit} ${t(locale, 'products.masterDetailMetaSuffix')}`;
const heroLabel = `${item.segment} ${t(locale, 'products.masterDetailSelectionSuffix')}`;
const heroSubtitle = [item.bolge, item.ciftlik].filter(Boolean).join(' • ');
const heroBody = `${t(locale, 'products.masterDetailProducerLabel')}: ${item.uretici}${item.ticari_segment ? ` · ${t(locale, 'products.masterDetailCommercialLabel')}: ${item.ticari_segment}` : ''}`;
const lightboxId = `master-lot-lightbox-${item.slug}`;
const keyRows = [
  { key: 'score', label: t(locale, 'products.masterDetailCuppingScoreLabel'), value: item.cupping_score },
  { key: 'segment', label: t(locale, 'products.masterDetailSegmentLabel'), value: item.segment },
  { key: 'region', label: t(locale, 'products.masterDetailRegionLabel'), value: item.bolge },
  { key: 'farm', label: t(locale, 'products.masterDetailFarmLabel'), value: item.ciftlik },
  { key: 'producer', label: t(locale, 'products.masterDetailProducerLabel'), value: item.uretici },
  { key: 'variety', label: t(locale, 'products.masterDetailVarietyLabel'), value: item.cesit },
  { key: 'commercial', label: t(locale, 'products.masterDetailCommercialLabel'), value: item.ticari_segment },
].filter((row) => Boolean(row.value && row.value.trim()));
---

<BaseLayout locale={locale} title={title} description={description}>
  <section class="section-band-a relative overflow-hidden border-b border-line pb-10 pt-20 sm:pb-12 sm:pt-24 md:pb-16 md:pt-28 lg:pt-32">
    <div class="section-shell">
      <div class="grid gap-8 sm:gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
        <div class="space-y-8">
          <div>
            <p class="mb-5 inline-flex rounded-full border border-heading/30 bg-white/70 px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.26em] text-heading">
              {heroLabel}
            </p>
            <h1 class="m-0 p-0 font-display text-[clamp(1.85rem,6.5vw,4rem)] font-semibold leading-[1.05] tracking-[-0.03em] text-ink">
              {item.cesit}
            </h1>
            {heroSubtitle && (
              <p class="mt-4 text-[12px] font-semibold uppercase tracking-[0.16em] text-ink/72 md:text-[13px]">
                {heroSubtitle}
              </p>
            )}
            <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-ink/78 md:text-[16px]">
              {heroBody}
            </p>
          </div>

          <div class="mx-auto mt-8 flex w-full max-w-md flex-col items-center gap-3 sm:mx-0 sm:mt-10 sm:max-w-none sm:flex-row sm:items-stretch sm:justify-start">
            <a
              href={withLang('/contact', locale)}
              class="inline-flex min-h-[48px] w-full max-w-full items-center justify-center rounded-full bg-heading px-5 py-3.5 text-center text-[12px] font-semibold uppercase leading-snug tracking-[0.08em] text-balance text-white shadow-[0_10px_24px_rgba(40,96,63,0.28)] transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_16px_34px_rgba(40,96,63,0.35)] sm:w-auto sm:px-8 sm:text-[13px]"
            >
              {t(locale, 'products.masterDetailRequestCta')}
            </a>
            <a
              href="#lot-details"
              class="inline-flex min-h-[48px] w-full max-w-full items-center justify-center rounded-full border border-heading/35 bg-white/65 px-5 py-2.5 text-center text-[11px] font-semibold uppercase leading-snug tracking-[0.1em] text-balance text-heading transition-all duration-300 hover:border-heading/60 hover:bg-white sm:w-auto"
            >
              {t(locale, 'products.masterDetailLotDetailsCta')}
            </a>
          </div>
        </div>

        <div class="space-y-4 lg:justify-self-end">
          <div class="relative w-full max-w-none overflow-hidden rounded-2xl border border-[#d9d1c3] bg-[#e9e2d6] shadow-[0_24px_55px_rgba(0,0,0,0.12)] transition-[box-shadow,transform] duration-500 ease-out hover:-translate-y-1 sm:rounded-[28px] lg:max-w-[520px]">
            <button
              type="button"
              class="group/photo relative block w-full overflow-hidden bg-[#1a1510] text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-heading focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1510]"
              data-master-lightbox-open
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-controls={lightboxId}
            >
              <Image
                src="/roasted-coffee-beans.webp"
                alt={`Premium ${item.cesit} coffee beans from Venezuela`}
                class="aspect-[4/3] w-full min-h-[200px] object-cover object-[center_38%] transition duration-[1.1s] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/photo:scale-[1.04] sm:min-h-[280px] lg:h-[360px] lg:min-h-[360px]"
                loading="eager"
                width="1400"
                height="1000"
              />
            </button>
            <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-black/10 to-transparent" aria-hidden="true"></div>
            <div class="absolute left-3 top-3 max-w-[calc(100%-6rem)] rounded-full border border-white/35 bg-black/35 px-3 py-1.5 text-[9px] font-semibold uppercase tracking-[0.16em] text-white backdrop-blur-sm sm:left-5 sm:top-5 sm:max-w-none sm:px-4 sm:py-2 sm:text-[10px] sm:tracking-[0.2em]">
              {item.segment}
            </div>
            <div class="absolute bottom-3 left-3 max-w-[min(100%-1.5rem,16rem)] rounded-xl border border-white/25 bg-black/40 px-3 py-3 backdrop-blur-sm sm:bottom-5 sm:left-5 sm:max-w-none sm:rounded-2xl sm:px-5 sm:py-4">
              <p class="text-[9px] font-semibold uppercase tracking-[0.16em] text-white/80 sm:text-[10px] sm:tracking-[0.2em]">
                {t(locale, 'products.masterDetailCuppingScoreLabel')}
              </p>
              <p class="mt-0.5 text-[22px] font-semibold leading-none text-white sm:mt-1 sm:text-[28px]">{item.cupping_score}</p>
            </div>
            <span class="pointer-events-none absolute bottom-3 right-3 max-w-[min(42vw,11rem)] rounded-full border border-white/35 bg-black/50 px-2 py-1.5 text-center text-[9px] font-semibold uppercase leading-snug tracking-[0.1em] text-white/95 backdrop-blur-md sm:bottom-4 sm:right-4 sm:max-w-none sm:px-3 sm:text-[10px] sm:leading-tight sm:tracking-[0.14em]">
              {t(locale, 'products.masterDetailZoomHint')}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <dialog
    id={lightboxId}
    class="master-lot-lightbox-dialog"
    aria-modal="true"
    aria-label={t(locale, 'products.masterDetailImageZoomAria')}
  >
    <div
      class="flex h-full min-h-0 w-full cursor-pointer items-center justify-center p-4 md:p-10"
      data-master-lightbox-pane
    >
      <button
        type="button"
        class="absolute right-3 top-3 z-20 flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-white/90 bg-white text-ink shadow-[0_4px_20px_rgba(0,0,0,0.45),0_0_0_1px_rgba(0,0,0,0.08)_inset] transition hover:border-heading hover:bg-heading hover:text-white hover:shadow-[0_6px_28px_rgba(0,0,0,0.35)] focus:outline-none focus-visible:ring-2 focus-visible:ring-heading focus-visible:ring-offset-2 focus-visible:ring-offset-transparent md:right-6 md:top-6"
        data-master-lightbox-close
        aria-label={t(locale, 'products.masterDetailImageCloseAria')}
      >
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
      <Image
        src="/roasted-coffee-beans.webp"
        alt={`Premium ${item.cesit} coffee beans from Venezuela`}
        class="h-auto max-h-[min(88dvh,900px)] w-auto max-w-full cursor-default rounded-md object-contain shadow-[0_25px_80px_rgba(0,0,0,0.55)] ring-1 ring-white/12 contrast-[1.02] saturate-[1.03] sm:max-w-[min(100%,1200px)]"
        loading="eager"
        width="1400"
        height="1000"
      />
    </div>
  </dialog>

  {keyRows.length > 0 && (
    <section id="lot-details" class="section-band-b border-y border-line py-12 sm:py-16 md:py-24">
      <div class="section-shell">
        <div class="mb-6 flex flex-col gap-3 sm:mb-8 md:mb-10 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="stage-eyebrow mb-2">{t(locale, 'products.masterDetailTechData')}</p>
            <h2 class="font-display text-[clamp(1.35rem,4.5vw,2rem)] font-semibold leading-tight text-heading sm:text-2xl md:text-3xl">
              {t(locale, 'products.masterDetailLotDetailsCta')}
            </h2>
          </div>
        </div>

        <article
          class="overflow-hidden rounded-2xl border border-[#ddd4c7] bg-[#fcfbf7] p-4 shadow-[0_10px_30px_rgba(0,0,0,0.04)] sm:rounded-[24px] sm:p-6 md:p-8"
        >
          <dl class="divide-y divide-[#e7dfd3]">
            {keyRows.map((row) => (
              <div
                class="grid grid-cols-1 gap-1.5 py-4 md:grid-cols-[minmax(0,12rem)_1fr] md:items-start md:gap-x-8 md:gap-y-0 md:py-5 lg:grid-cols-[minmax(0,13rem)_1fr]"
              >
                <dt class="min-w-0 shrink-0 text-[10px] font-semibold uppercase leading-snug tracking-[0.18em] text-[#8a847b] md:pt-0.5 md:tracking-[0.22em]">
                  {row.label}
                </dt>
                <dd class="min-w-0 text-left md:text-right">
                  {row.key === 'score' ? (
                    <span class="inline-flex max-w-full break-words rounded-full bg-[#1f1f1c] px-3 py-1.5 text-sm font-semibold text-white sm:px-4">
                      {row.value}
                    </span>
                  ) : row.key === 'segment' ? (
                    <span class="inline-flex max-w-full break-words rounded-full border border-[#cfd9c7] bg-[#eef4e8] px-3 py-1.5 text-sm font-semibold text-heading sm:px-4">
                      {row.value}
                    </span>
                  ) : (
                    <span class="break-words text-[16px] font-semibold leading-snug text-[#1f1f1c] sm:text-[17px] md:text-[18px]">{row.value}</span>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </article>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section-band-a border-t border-line/60 py-16 md:py-20">
      <div class="section-shell">
        <h2 class="font-display text-[clamp(1.5rem,2.8vw,2.2rem)] font-semibold text-heading">
          {t(locale, 'products.masterDetailRelatedTitle')}
        </h2>
        <p class="mt-3 text-[16px] leading-relaxed text-ink/72">
          {t(locale, 'products.masterDetailRelatedBody')}
        </p>
        <div class="mt-8 grid gap-8 md:grid-cols-2 xl:grid-cols-3">
          {related.map((relatedItem) => (
            <CoffeeMasterCard item={relatedItem} locale={locale} slug={relatedItem.slug} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style is:global>
  .master-lot-lightbox-dialog {
    margin: 0;
    max-height: 100dvh;
    max-width: 100%;
    width: 100%;
    height: 100%;
    border: none;
    padding: 0;
    background: transparent;
  }
  .master-lot-lightbox-dialog::backdrop {
    background: rgba(8, 12, 18, 0.92);
    backdrop-filter: blur(6px);
  }
</style>

<script>
  function initMasterLotLightbox() {
    const openBtn = document.querySelector('[data-master-lightbox-open]');
    const dialog = document.querySelector('.master-lot-lightbox-dialog');
    const closeBtn = dialog?.querySelector('[data-master-lightbox-close]');
    const pane = dialog?.querySelector('[data-master-lightbox-pane]');
    if (!openBtn || !dialog || !(dialog instanceof HTMLDialogElement)) return;

    const setExpanded = (open: boolean) => {
      openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    const closeLightbox = () => {
      dialog.close();
      setExpanded(false);
    };

    openBtn.addEventListener('click', () => {
      dialog.showModal();
      setExpanded(true);
    });

    closeBtn?.addEventListener('click', () => {
      closeLightbox();
    });

    pane?.addEventListener('click', (e) => {
      if (e.target === pane) closeLightbox();
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeLightbox();
    });

    dialog.addEventListener('close', () => setExpanded(false));
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initMasterLotLightbox)
    : initMasterLotLightbox();
</script>
