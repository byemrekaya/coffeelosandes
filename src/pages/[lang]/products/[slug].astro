---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CoffeeMasterCard from '../../../components/products/CoffeeMasterCard.astro';
import { locales } from '../../../i18n/types';
import type { Locale } from '../../../i18n/types';
import { venezuelaCoffeeMasterWithSlug } from '../../../data/venezuelaCoffeeMaster';
import { withLang } from '../../../i18n/paths';

export function getStaticPaths() {
  const paths: {
    params: { lang: string; slug: string };
    props: { item: (typeof venezuelaCoffeeMasterWithSlug)[number] };
  }[] = [];

  for (const lang of locales) {
    for (const item of venezuelaCoffeeMasterWithSlug) {
      paths.push({ params: { lang, slug: item.slug }, props: { item } });
    }
  }
  return paths;
}

interface Props {
  item: (typeof venezuelaCoffeeMasterWithSlug)[number];
}

const { item } = Astro.props;
const { lang } = Astro.params;
const locale = lang as Locale;
const isTR = locale === 'tr';

const related = venezuelaCoffeeMasterWithSlug
  .filter((candidate) => candidate.segment === item.segment && candidate.slug !== item.slug)
  .slice(0, 3);

const title = `${item.cesit} · ${item.bolge} · ${item.cupping_score} · Coffee Los Andes`;
const description = isTR
  ? `${item.cesit} için üretici, çiftlik, bölge ve cupping skoru dahil lot detayları.`
  : `Lot details for ${item.cesit} including producer, farm, region and cupping score.`;
const heroLabel = `${item.segment} SELECTION`;
const heroSubtitle = [item.bolge, item.ciftlik].filter(Boolean).join(' • ');
const heroBody = isTR
  ? `Üretici: ${item.uretici}${item.ticari_segment ? ` · Ticari Konum: ${item.ticari_segment}` : ''}`
  : `Producer: ${item.uretici}${item.ticari_segment ? ` · Commercial Positioning: ${item.ticari_segment}` : ''}`;
const lightboxId = `master-lot-lightbox-${item.slug}`;
const keyRows = [
  { key: 'score', label: isTR ? 'Cupping Skoru' : 'Cupping Score', value: item.cupping_score },
  { key: 'segment', label: isTR ? 'Segment' : 'Segment', value: item.segment },
  { key: 'region', label: isTR ? 'Bölge' : 'Region', value: item.bolge },
  { key: 'farm', label: isTR ? 'Çiftlik' : 'Farm', value: item.ciftlik },
  { key: 'producer', label: isTR ? 'Üretici' : 'Producer', value: item.uretici },
  { key: 'variety', label: isTR ? 'Çeşit' : 'Variety', value: item.cesit },
  { key: 'commercial', label: isTR ? 'Ticari Konumlandırma' : 'Commercial Positioning', value: item.ticari_segment },
].filter((row) => Boolean(row.value && row.value.trim()));
---

<BaseLayout locale={locale} title={title} description={description}>
  <section class="section-band-a relative overflow-hidden border-b border-line pb-12 pt-24 md:pb-16 md:pt-28 lg:pt-32">
    <div class="section-shell">
      <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
        <div class="space-y-8">
          <div>
            <p class="mb-5 inline-flex rounded-full border border-heading/30 bg-white/70 px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.26em] text-heading">
              {heroLabel}
            </p>
            <h1 class="m-0 p-0 font-display text-[clamp(2.5rem,7vw,4rem)] font-semibold leading-[1.02] tracking-[-0.03em] text-ink">
              {item.cesit}
            </h1>
            {heroSubtitle && (
              <p class="mt-4 text-[12px] font-semibold uppercase tracking-[0.16em] text-ink/72 md:text-[13px]">
                {heroSubtitle}
              </p>
            )}
            <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-ink/78 md:text-[16px]">
              {heroBody}
            </p>
          </div>

          <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href={withLang('/contact', locale)}
              class="inline-flex justify-center rounded-full bg-heading px-8 py-3.5 text-[13px] font-semibold uppercase tracking-[0.08em] text-white shadow-[0_10px_24px_rgba(40,96,63,0.28)] transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_16px_34px_rgba(40,96,63,0.35)]"
            >
              {isTR ? 'Toptan Teklif İste' : 'Request Wholesale Offer'}
            </a>
            <a
              href="#lot-details"
              class="inline-flex justify-center rounded-full border border-heading/35 bg-white/65 px-6 py-2.5 text-[11px] font-semibold uppercase tracking-[0.1em] text-heading transition-all duration-300 hover:border-heading/60 hover:bg-white"
            >
              {isTR ? 'Lot detayları' : 'Lot details'}
            </a>
          </div>
        </div>

        <div class="space-y-4 lg:justify-self-end">
          <div class="relative w-full max-w-none overflow-hidden rounded-[28px] border border-[#d9d1c3] bg-[#e9e2d6] shadow-[0_24px_55px_rgba(0,0,0,0.12)] transition-[box-shadow,transform] duration-500 ease-out hover:-translate-y-1 lg:max-w-[520px]">
            <button
              type="button"
              class="group/photo relative block w-full overflow-hidden bg-[#1a1510] text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-heading focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1510]"
              data-master-lightbox-open
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-controls={lightboxId}
            >
              <Image
                src="/cekirdek.jpg"
                alt={`${item.cesit} coffee beans`}
                class="aspect-[4/3] w-full object-cover object-[center_38%] min-h-[240px] sm:min-h-[300px] lg:h-[360px] lg:min-h-[360px] transition duration-[1.1s] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/photo:scale-[1.04]"
                loading="eager"
                width="1400"
                height="1000"
              />
            </button>
            <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-black/10 to-transparent" aria-hidden="true"></div>
            <div class="absolute left-5 top-5 rounded-full border border-white/35 bg-black/35 px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-white backdrop-blur-sm">
              {item.segment}
            </div>
            <div class="absolute bottom-5 left-5 rounded-2xl border border-white/25 bg-black/40 px-5 py-4 backdrop-blur-sm">
              <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-white/80">
                {isTR ? 'Cupping skoru' : 'Cupping score'}
              </p>
              <p class="mt-1 text-[28px] font-semibold leading-none text-white">{item.cupping_score}</p>
            </div>
            <span class="pointer-events-none absolute bottom-4 right-4 rounded-full border border-white/35 bg-black/50 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-white/95 backdrop-blur-md">
              {isTR ? 'Büyüt' : 'Zoom'}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <dialog
    id={lightboxId}
    class="master-lot-lightbox-dialog"
    aria-modal="true"
    aria-label={isTR ? 'Ürün görseli büyütme' : 'Product image zoom'}
  >
    <div
      class="flex h-full min-h-0 w-full cursor-pointer items-center justify-center p-4 md:p-10"
      data-master-lightbox-pane
    >
      <button
        type="button"
        class="absolute right-3 top-3 z-20 flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-white/90 bg-white text-ink shadow-[0_4px_20px_rgba(0,0,0,0.45),0_0_0_1px_rgba(0,0,0,0.08)_inset] transition hover:border-heading hover:bg-heading hover:text-white hover:shadow-[0_6px_28px_rgba(0,0,0,0.35)] focus:outline-none focus-visible:ring-2 focus-visible:ring-heading focus-visible:ring-offset-2 focus-visible:ring-offset-transparent md:right-6 md:top-6"
        data-master-lightbox-close
        aria-label={isTR ? 'Görseli kapat' : 'Close image'}
      >
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
      <Image
        src="/cekirdek.jpg"
        alt={`${item.cesit} coffee beans`}
        class="max-h-[min(88dvh,900px)] max-w-[min(96vw,1200px)] cursor-default rounded-md object-contain shadow-[0_25px_80px_rgba(0,0,0,0.55)] ring-1 ring-white/12 contrast-[1.02] saturate-[1.03]"
        loading="eager"
        width="1400"
        height="1000"
      />
    </div>
  </dialog>

  {keyRows.length > 0 && (
    <section id="lot-details" class="section-band-b border-y border-line py-20 md:py-24">
      <div class="section-shell">
        <div class="mb-10 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="stage-eyebrow mb-2">{isTR ? 'TEKNİK BİLGİLER' : 'TECHNICAL DATA'}</p>
            <h2 class="font-display text-2xl font-semibold text-heading md:text-3xl">{isTR ? 'Lot detayları' : 'Lot details'}</h2>
          </div>
        </div>

        <article class="rounded-[24px] border border-[#ddd4c7] bg-[#fcfbf7] p-8 shadow-[0_10px_30px_rgba(0,0,0,0.04)]">
          <dl class="divide-y divide-[#e7dfd3]">
            {keyRows.map((row) => (
              <div class="grid grid-cols-1 gap-3 py-5 sm:grid-cols-[minmax(0,220px)_1fr] sm:items-start sm:gap-6">
                <dt class="text-[10px] font-semibold uppercase tracking-[0.22em] text-[#8a847b]">{row.label}</dt>
                <dd class="sm:text-right">
                  {row.key === 'score' ? (
                    <span class="inline-flex rounded-full bg-[#1f1f1c] px-4 py-1.5 text-sm font-semibold text-white">
                      {row.value}
                    </span>
                  ) : row.key === 'segment' ? (
                    <span class="inline-flex rounded-full border border-[#cfd9c7] bg-[#eef4e8] px-4 py-1.5 text-sm font-semibold text-heading">
                      {row.value}
                    </span>
                  ) : (
                    <span class="text-[18px] font-semibold leading-snug text-[#1f1f1c]">{row.value}</span>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </article>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section-band-a border-t border-line/60 py-16 md:py-20">
      <div class="section-shell">
        <h2 class="font-display text-[clamp(1.5rem,2.8vw,2.2rem)] font-semibold text-heading">
          {isTR ? 'İlgili ürünler' : 'Related products'}
        </h2>
        <p class="mt-3 text-[16px] leading-relaxed text-ink/72">
          {isTR ? 'Aynı segmentteki diğer seçenekleri de inceleyin.' : 'Explore other options in the same segment.'}
        </p>
        <div class="mt-8 grid gap-8 md:grid-cols-2 xl:grid-cols-3">
          {related.map((relatedItem) => (
            <CoffeeMasterCard item={relatedItem} locale={locale} slug={relatedItem.slug} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style is:global>
  .master-lot-lightbox-dialog {
    margin: 0;
    max-height: 100dvh;
    max-width: 100vw;
    width: 100%;
    height: 100%;
    border: none;
    padding: 0;
    background: transparent;
  }
  .master-lot-lightbox-dialog::backdrop {
    background: rgba(8, 12, 18, 0.92);
    backdrop-filter: blur(6px);
  }
</style>

<script>
  function initMasterLotLightbox() {
    const openBtn = document.querySelector('[data-master-lightbox-open]');
    const dialog = document.querySelector('.master-lot-lightbox-dialog');
    const closeBtn = dialog?.querySelector('[data-master-lightbox-close]');
    const pane = dialog?.querySelector('[data-master-lightbox-pane]');
    if (!openBtn || !dialog || !(dialog instanceof HTMLDialogElement)) return;

    const setExpanded = (open: boolean) => {
      openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    const closeLightbox = () => {
      dialog.close();
      setExpanded(false);
    };

    openBtn.addEventListener('click', () => {
      dialog.showModal();
      setExpanded(true);
    });

    closeBtn?.addEventListener('click', () => {
      closeLightbox();
    });

    pane?.addEventListener('click', (e) => {
      if (e.target === pane) closeLightbox();
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeLightbox();
    });

    dialog.addEventListener('close', () => setExpanded(false));
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initMasterLotLightbox)
    : initMasterLotLightbox();
</script>
