---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangStaticPaths } from '../../../i18n/staticPaths';
import type { Locale } from '../../../i18n/types';
import SectionHeader from '../../../components/SectionHeader.astro';
import CoffeeLotCard from '../../../components/coffee/CoffeeLotCard.astro';
import { getLotsBySegment } from '../../../data/coffeeLots';
import { localizeCoffeeLots } from '../../../i18n/localizeLot';
import { t } from '../../../i18n/t';
import { dictionary } from '../../../i18n/dictionary';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params;
const locale = lang as Locale;

const productsDict = dictionary[locale].products as Record<string, unknown>;
const retailSpecLines = (productsDict.retailSpecLines ?? []) as string[];

const competition = localizeCoffeeLots(getLotsBySegment('competition-lots'), locale);
const microlot = localizeCoffeeLots(getLotsBySegment('premium-microlot'), locale);
const specialty = localizeCoffeeLots(getLotsBySegment('specialty-series'), locale);
const barista = localizeCoffeeLots(getLotsBySegment('barista-blend'), locale);
const commercial = localizeCoffeeLots(getLotsBySegment('commercial'), locale);
---

<BaseLayout locale={locale} title={t(locale, 'products.title')} description={t(locale, 'products.description')}>
  <section class="border-b border-line pb-16 pt-32 md:pb-20 md:pt-36">
    <div class="section-shell">
      <SectionHeader
        eyebrow={t(locale, 'products.eyebrow')}
        title={t(locale, 'products.heading')}
        description={t(locale, 'products.desc')}
        align="center"
      />
    </div>
  </section>

  <section class="pb-12 pt-8 md:pb-16">
    <div class="section-shell space-y-16 md:space-y-24">
      <div>
        <div class="mb-8 max-w-3xl">
          <h2 class="font-display text-xl font-semibold text-ink md:text-2xl">{t(locale, 'products.segmentCompetitionTitle')}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'products.segmentCompetitionDesc')}</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {competition.map((lot) => (
            <CoffeeLotCard lot={lot} locale={locale} />
          ))}
        </div>
      </div>

      <div>
        <div class="mb-8 max-w-3xl">
          <h2 class="font-display text-xl font-semibold text-ink md:text-2xl">{t(locale, 'products.segmentMicroTitle')}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'products.segmentMicroDesc')}</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {microlot.map((lot) => (
            <CoffeeLotCard lot={lot} locale={locale} />
          ))}
        </div>
      </div>

      <div>
        <div class="mb-8 max-w-3xl">
          <h2 class="font-display text-xl font-semibold text-ink md:text-2xl">{t(locale, 'products.segmentSpecialtyTitle')}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'products.segmentSpecialtyDesc')}</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {specialty.map((lot) => (
            <CoffeeLotCard lot={lot} locale={locale} />
          ))}
        </div>
      </div>

      <div>
        <div class="mb-8 max-w-3xl">
          <h2 class="font-display text-xl font-semibold text-ink md:text-2xl">{t(locale, 'products.segmentBaristaTitle')}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'products.segmentBaristaDesc')}</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {barista.map((lot) => (
            <CoffeeLotCard lot={lot} locale={locale} />
          ))}
        </div>
      </div>

      <div>
        <div class="mb-8 max-w-3xl">
          <h2 class="font-display text-xl font-semibold text-ink md:text-2xl">{t(locale, 'products.segmentCommercialTitle')}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'products.segmentCommercialDesc')}</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {commercial.map((lot) => (
            <CoffeeLotCard lot={lot} locale={locale} />
          ))}
        </div>
      </div>

      <div>
        <div class="mb-8 max-w-3xl">
          <h2 class="font-display text-xl font-semibold text-ink md:text-2xl">{t(locale, 'products.segmentRoastedTitle')}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t(locale, 'products.segmentRoastedDesc')}</p>
        </div>
        <article class="border border-line/80 bg-paper-deep/40 px-6 py-8 md:px-8">
          <h3 class="font-display text-lg font-semibold text-ink">{t(locale, 'products.retailProductTitle')}</h3>
          <p class="mt-4 max-w-3xl text-sm leading-relaxed text-ink-muted">{t(locale, 'products.retailProductStory')}</p>
          <ul class="mt-6 grid gap-2 text-sm text-ink-muted sm:grid-cols-2 lg:grid-cols-3">
            {retailSpecLines.map((line) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-gold" aria-hidden="true" />
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
