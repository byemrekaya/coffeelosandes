---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangStaticPaths } from '../../../i18n/staticPaths';
import { resolveLocale } from '../../../i18n/config';
import SectionHeader from '../../../components/SectionHeader.astro';
import CoffeeMasterCard from '../../../components/products/CoffeeMasterCard.astro';
import { getMasterItemsBySegment } from '../../../data/venezuelaCoffeeMaster';
import { t } from '../../../i18n/t';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params;
const locale = resolveLocale(lang);

const masterMicroLots = getMasterItemsBySegment('MICRO LOT');
const masterSpecialty = getMasterItemsBySegment('SPECIALTY');
const masterCommercial = getMasterItemsBySegment('COMMERCIAL');
---

<BaseLayout locale={locale} title={t(locale, 'products.title')} description={t(locale, 'products.description')}>
  <section class="border-b border-line pb-16 pt-32 md:pb-20 md:pt-36">
    <div class="section-shell">
      <SectionHeader
        eyebrow={t(locale, 'products.eyebrow')}
        title={t(locale, 'products.heading')}
        description={t(locale, 'products.desc')}
        align="center"
      />
    </div>
  </section>

  <section id="our-products" class="section-band-b border-t border-line/60 py-16 md:py-20">
    <div class="section-shell">
      <div class="mb-10 max-w-3xl">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#6f7f5f]">
          {t(locale, 'products.masterSectionLabel')}
        </p>
        <h2 class="mt-2 font-display text-[clamp(1.6rem,3vw,2.2rem)] font-semibold text-heading">
          {t(locale, 'products.masterPortfolioTitle')}
        </h2>
      </div>

      <div class="mb-8 max-w-3xl">
        <h3 class="font-display text-xl font-semibold text-heading md:text-2xl">Micro Lot</h3>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {masterMicroLots.map((item) => (
          <CoffeeMasterCard item={item} locale={locale} slug={item.slug} />
        ))}
      </div>

      <div class="mt-14 mb-8 max-w-3xl">
        <h3 class="font-display text-xl font-semibold text-heading md:text-2xl">Specialty</h3>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {masterSpecialty.map((item) => (
          <CoffeeMasterCard item={item} locale={locale} slug={item.slug} />
        ))}
      </div>

      <div class="mt-14 mb-8 max-w-3xl">
        <h3 class="font-display text-xl font-semibold text-heading md:text-2xl">Commercial</h3>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {masterCommercial.map((item) => (
          <CoffeeMasterCard item={item} locale={locale} slug={item.slug} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
