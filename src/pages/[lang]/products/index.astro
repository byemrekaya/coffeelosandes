---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangStaticPaths } from '../../../i18n/staticPaths';
import type { Locale } from '../../../i18n/types';
import SectionHeader from '../../../components/SectionHeader.astro';
import CoffeeLotCard from '../../../components/coffee/CoffeeLotCard.astro';
import { getLotsBySegment } from '../../../data/coffeeLots';
import { localizeCoffeeLots } from '../../../i18n/localizeLot';
import { t } from '../../../i18n/t';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params;
const locale = lang as Locale;

const ultra = localizeCoffeeLots(getLotsBySegment('ultra-premium'), locale);
const special = localizeCoffeeLots(getLotsBySegment('special-series'), locale);
const blend = localizeCoffeeLots(getLotsBySegment('blend-mixed'), locale);
---

<BaseLayout locale={locale} title={t(locale, 'products.title')} description={t(locale, 'products.description')}>
  <section class="border-b border-line pb-16 pt-32 md:pb-20 md:pt-36">
    <div class="section-shell">
      <SectionHeader
        eyebrow={t(locale, 'products.eyebrow')}
        title={t(locale, 'products.heading')}
        description={t(locale, 'products.desc')}
        align="center"
      />
    </div>
  </section>

  <section class="pb-12 pt-8 md:pb-16">
    <div class="section-shell space-y-16 md:space-y-24">
      <div>
        <div class="mb-8 max-w-3xl">
          <h2 class="font-display text-xl font-semibold text-cream md:text-2xl">{t(locale, 'products.segmentUltraTitle')}</h2>
          <p class="mt-3 text-sm leading-relaxed text-cream/60">{t(locale, 'products.segmentUltraDesc')}</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {ultra.map((lot) => (
            <CoffeeLotCard lot={lot} locale={locale} />
          ))}
        </div>
      </div>

      <div>
        <div class="mb-8 max-w-3xl">
          <h2 class="font-display text-xl font-semibold text-cream md:text-2xl">{t(locale, 'products.segmentSpecialTitle')}</h2>
          <p class="mt-3 text-sm leading-relaxed text-cream/60">{t(locale, 'products.segmentSpecialDesc')}</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {special.map((lot) => (
            <CoffeeLotCard lot={lot} locale={locale} />
          ))}
        </div>
      </div>

      <div>
        <div class="mb-8 max-w-3xl">
          <h2 class="font-display text-xl font-semibold text-cream md:text-2xl">{t(locale, 'products.segmentBlendTitle')}</h2>
          <p class="mt-3 text-sm leading-relaxed text-cream/60">{t(locale, 'products.segmentBlendDesc')}</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {blend.map((lot) => (
            <CoffeeLotCard lot={lot} locale={locale} />
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
