---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangStaticPaths } from '../../i18n/staticPaths';
import SectionHeader from '../../components/SectionHeader.astro';
import CTASection from '../../components/CTASection.astro';
import { dictionary } from '../../i18n/dictionary';
import { resolveLocale } from '../../i18n/config';
import { t } from '../../i18n/t';
import { withLang } from '../../i18n/paths';

export function getStaticPaths() {
  return getLangStaticPaths();
}

type AboutPart = { type: 'p'; text: string } | { type: 'ul'; items: string[] };

type AboutSectionBlock = {
  title: string;
  parts: AboutPart[];
};

const { lang } = Astro.params;
const locale = resolveLocale(lang);

const brandValues = (dictionary[locale].brandValues ?? []) as { title: string; body: string }[];
const aboutRaw = dictionary[locale].about as Record<string, unknown>;
const losAndesLead = (aboutRaw.losAndesLead as string[] | undefined) ?? [];
const losAndesSections = (aboutRaw.losAndesSections as AboutSectionBlock[] | undefined) ?? [];
const venezuelaParagraphs = (aboutRaw.venezuelaParagraphs as string[] | undefined) ?? [];
const losAndesTitle = (aboutRaw.losAndesTitle as string) ?? '';
const venezuelaTitle = (aboutRaw.venezuelaTitle as string) ?? '';
---

<BaseLayout locale={locale} title={t(locale, 'about.title')} description={t(locale, 'about.description')}>
  <section class="section-band-a w-full scroll-mt-28 pt-36 pb-16 md:pb-20">
    <div class="section-shell">
      <SectionHeader
        eyebrow={t(locale, 'about.heroEyebrow')}
        title={t(locale, 'about.heroTitle')}
        description={t(locale, 'about.heroDesc')}
        align="center"
      />
    </div>
  </section>

  <section id="los-andes" class="section-band-b w-full scroll-mt-28 py-16 md:py-20">
    <div class="section-shell max-w-3xl">
      <h2 class="stage-heading text-2xl md:text-3xl">{losAndesTitle}</h2>
      <div class="mt-8 space-y-5 text-sm leading-relaxed text-ink-muted md:text-[15px]">
        {losAndesLead.map((para) => (
          <p>{para}</p>
        ))}
      </div>

      <div class="mt-14 space-y-14">
        {losAndesSections.map((block) => (
          <div>
            <h3 class="font-display text-lg font-semibold tracking-header text-heading md:text-xl">{block.title}</h3>
            <div class="mt-5 space-y-4 text-sm leading-relaxed text-ink-muted md:text-[15px]">
              {block.parts.map((part) =>
                part.type === 'p' ? (
                  <p>{part.text}</p>
                ) : (
                  <ul class="list-disc space-y-2 pl-5">
                    {part.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="venezuela-herkunft" class="section-band-a w-full scroll-mt-28 py-16 md:py-20">
    <div class="section-shell max-w-3xl">
      <h2 class="stage-heading text-2xl md:text-3xl">{venezuelaTitle}</h2>
      <div class="mt-8 space-y-5 text-sm leading-relaxed text-ink-muted md:text-[15px]">
        {venezuelaParagraphs.map((para) => (
          <p>{para}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band-b w-full py-16 md:py-20">
    <div class="section-shell">
      <SectionHeader
        eyebrow={t(locale, 'about.valuesEyebrow')}
        title={t(locale, 'about.valuesTitle')}
        description={t(locale, 'about.valuesDesc')}
      />
      <div class="mt-12 max-w-2xl">
        {brandValues.map((value) => (
          <article class="border-l-[3px] border-heading/35 pl-6">
            <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-heading">{value.title}</h3>
            <p class="mt-4 text-sm leading-relaxed text-ink-muted">{value.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band-a w-full py-16 md:py-24">
    <div class="section-shell max-w-3xl">
      <h2 class="stage-heading text-2xl md:text-3xl">{t(locale, 'about.roastTitle')}</h2>
      <p class="stage-copy mt-8">{t(locale, 'about.roastBody')}</p>
    </div>
  </section>

  <CTASection
    eyebrow={t(locale, 'cta.eyebrow')}
    title={t(locale, 'cta.title')}
    body={t(locale, 'cta.body')}
    primaryLabel={t(locale, 'cta.primary')}
    primaryHref={withLang('/contact', locale)}
    secondaryLabel={t(locale, 'cta.secondary')}
    secondaryHref={withLang('/products', locale)}
  />
</BaseLayout>
