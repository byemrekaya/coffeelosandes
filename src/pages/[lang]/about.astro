---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangStaticPaths } from '../../i18n/staticPaths';
import SectionHeader from '../../components/SectionHeader.astro';
import CTASection from '../../components/CTASection.astro';
import VenezuelaStorySection from '../../components/about/VenezuelaStorySection.astro';
import { getLocalizedDictionary } from '../../i18n/localizedDictionary';
import { resolveLocale } from '../../i18n/config';
import { t } from '../../i18n/t';
import { withLang } from '../../i18n/paths';

export function getStaticPaths() {
  return getLangStaticPaths();
}

type AboutPart = { type: 'p'; text: string } | { type: 'ul'; items: string[] };

type AboutSectionBlock = {
  title: string;
  parts: AboutPart[];
};

const { lang } = Astro.params;
const locale = resolveLocale(lang);
const dict = getLocalizedDictionary(locale);

const aboutRaw = (dict.about ?? {}) as Record<string, unknown>;
const losAndesLead = (aboutRaw.losAndesLead as string[] | undefined) ?? [];
const losAndesSections = (aboutRaw.losAndesSections as AboutSectionBlock[] | undefined) ?? [];
const losAndesTitle = (aboutRaw.losAndesTitle as string) ?? '';
---

<BaseLayout locale={locale} title={t(locale, 'about.title')} description={t(locale, 'about.description')}>
  <section
    id="biz-kimiz"
    class="relative w-full overflow-hidden scroll-mt-28 border-b border-line/35 text-nav-cream"
  >
    <div class="absolute inset-0">
      <img
        src="/banner.webp"
        alt={t(locale, 'about.heroImageAlt')}
        class="h-full min-h-[280px] w-full scale-105 object-cover object-center sm:min-h-[320px]"
        loading="eager"
        fetchpriority="high"
      />
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div
          class="absolute inset-0 bg-gradient-to-br from-[#050c09] via-[#0d2218]/92 to-[#06140e]/88"
        />
        <div
          class="absolute inset-0 bg-gradient-to-r from-[#050c09]/97 via-[#0a1812]/75 to-transparent sm:via-[#0a1812]/55"
        />
        <div
          class="absolute inset-0 opacity-[0.12]"
          style="background-image: radial-gradient(ellipse 90% 70% at 70% 20%, rgba(232,212,184,0.45) 0%, transparent 55%), radial-gradient(circle at 15% 85%, rgba(52,120,90,0.35) 0%, transparent 45%);"
        />
      </div>
    </div>

    <div class="section-shell relative z-10 pb-16 pt-32 md:pb-20 md:pt-36">
      <SectionHeader
        eyebrow={t(locale, 'about.heroEyebrow')}
        title={t(locale, 'about.heroTitle')}
        description={t(locale, 'about.heroDesc')}
        align="center"
        variant="onDark"
      />
    </div>
  </section>

  <section id="los-andes" class="section-band-b w-full scroll-mt-28 py-16 md:py-20">
    <div class="section-shell max-w-3xl">
      <h2 class="stage-heading text-2xl md:text-3xl">{losAndesTitle}</h2>
      <div class="mt-8 space-y-5 text-sm leading-relaxed text-ink-muted md:text-[15px]">
        {losAndesLead.map((para) => (
          <p>{para}</p>
        ))}
      </div>

      <div class="mt-14 space-y-14">
        {losAndesSections.map((block) => (
          <div>
            <h3 class="font-display text-lg font-semibold tracking-header text-heading md:text-xl">{block.title}</h3>
            <div class="mt-5 space-y-4 text-sm leading-relaxed text-ink-muted md:text-[15px]">
              {block.parts.map((part) =>
                part.type === 'p' ? (
                  <p>{part.text}</p>
                ) : (
                  <ul class="list-disc space-y-2 pl-5">
                    {part.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <VenezuelaStorySection locale={locale} />

  <CTASection
    eyebrow={t(locale, 'cta.eyebrow')}
    title={t(locale, 'cta.title')}
    body={t(locale, 'cta.body')}
    primaryLabel={t(locale, 'cta.primary')}
    primaryHref={withLang('/contact', locale)}
    secondaryLabel={t(locale, 'cta.secondary')}
    secondaryHref={withLang('/products', locale)}
  />
</BaseLayout>
