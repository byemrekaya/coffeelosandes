---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangStaticPaths } from '../../i18n/staticPaths';
import type { Locale } from '../../i18n/types';
import AlturaFullPage from '../../components/AlturaFullPage.astro';
import HomePageSections from '../../components/home/HomePageSections.astro';
import { t } from '../../i18n/t';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params;
const locale = lang as Locale;
---

<BaseLayout
  locale={locale}
  title={t(locale, 'home.title')}
  description={t(locale, 'home.description')}
  hideFooter={false}
  fullpage={false}
>
  <AlturaFullPage locale={locale} />
  <HomePageSections locale={locale} />
</BaseLayout>
