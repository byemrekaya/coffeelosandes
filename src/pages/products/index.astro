---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import CoffeeLotCard from '../../components/coffee/CoffeeLotCard.astro';
import { coffeeLots } from '../../data/coffeeLots';

const sorted = [...coffeeLots].sort((a, b) => b.score - a.score);
---

<BaseLayout
  title="Kahve Portföyü · Coffee Los Andes"
  description="2025 Winning Lots — Venezuelan specialty coffees for wholesale buyers, roasters, and distributors."
>
  <section class="border-b border-cream/[0.06] pb-16 pt-32 md:pb-20 md:pt-36">
    <div class="section-shell">
      <SectionHeader
        eyebrow="2025 Winning Lots"
        title="Kahve portföyü"
        description="Yalnızca ödüllü koleksiyon lotlarımız. Toptan alıcılar için skor, menşe ve kupa profiliyle sunulur."
        align="center"
      />
    </div>
  </section>

  <section class="pb-24 pt-12 md:pb-32">
    <div class="section-shell">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {sorted.map((lot) => (
          <CoffeeLotCard lot={lot} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
