---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import SectionHeader from '../../components/SectionHeader.astro';
---

<BaseLayout
  title="Coffee Portfolio – Coffee Los Andes"
  description="Premium B2B coffee profiles from Venezuelan origin. Espresso blends, filter roasts, office solutions, and single-origin offerings for wholesale partners."
>
  <section class="pt-32 pb-16">
    <div class="section-shell space-y-10">
      <SectionHeader
        eyebrow="Kahve Portföyü"
        title="Premium B2B kahve profilleri"
        description="Venezüella menşeli, plantasyondan paketlemeye kadar izlenebilir. Her profil, kullanım senaryosuna göre optimize edilmiştir."
      />
    </div>
  </section>

  <ProductGrid
    featuredOnly={false}
  />
</BaseLayout>
