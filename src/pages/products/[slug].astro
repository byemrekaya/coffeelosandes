---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDetailHero from '../../components/ProductDetailHero.astro';
import ProductCard from '../../components/ProductCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { products } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const relatedProducts = products.filter((p) => p.slug !== product.slug).slice(0, 3);
---

<BaseLayout
  title={`${product.name} – Coffee Los Andes`}
  description={product.shortDescription}
>
  <div class="section-shell py-4">
    <a
      href="/products"
      class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-cream/60 transition hover:text-cream"
    >
      <span aria-hidden="true">←</span>
      Kahve Portföyüne Dön
    </a>
  </div>

  <ProductDetailHero product={product} />

  <section class="mt-24">
    <div class="section-shell grid gap-12 md:grid-cols-[1fr_minmax(0,1.2fr)]">
      <div class="space-y-8">
        <div>
          <h2 class="stage-eyebrow mb-2">Tadım Profili</h2>
          <ul class="flex flex-wrap gap-2">
            {product.tastingNotes.map((note) => (
              <li>
                <span class="rounded-full border border-cream/10 bg-espresso/60 px-4 py-2 text-sm text-cream/80">
                  {note}
                </span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="stage-eyebrow mb-2">İdeal Kullanım</h2>
          <ul class="space-y-1 text-sm text-cream/70">
            {product.idealFor.map((use) => (
              <li>• {use}</li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="stage-eyebrow mb-2">B2B Uygunluk</h2>
          <p class="text-sm text-cream/70">{product.b2bFit}</p>
        </div>
      </div>

      <div class="glass-panel px-6 py-8">
        <h3 class="stage-eyebrow mb-4">Ürün Özeti</h3>
        <dl class="space-y-4 text-sm">
          <div class="flex justify-between border-b border-cream/10 pb-2">
            <dt class="text-cream/60">Menşei</dt>
            <dd class="text-cream">{product.origin}</dd>
          </div>
          <div class="flex justify-between border-b border-cream/10 pb-2">
            <dt class="text-cream/60">Rakım</dt>
            <dd class="text-cream">{product.elevation}</dd>
          </div>
          <div class="flex justify-between border-b border-cream/10 pb-2">
            <dt class="text-cream/60">Kavurma</dt>
            <dd class="text-cream capitalize">{product.roast}</dd>
          </div>
          <div class="flex justify-between border-b border-cream/10 pb-2">
            <dt class="text-cream/60">İşleme</dt>
            <dd class="text-cream">{product.process}</dd>
          </div>
          <div class="flex justify-between pb-2">
            <dt class="text-cream/60">Paketleme</dt>
            <dd class="text-cream">{product.packaging}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {relatedProducts.length > 0 && (
    <section class="mt-24 pb-24">
      <div class="section-shell space-y-10">
        <SectionHeader
          eyebrow="Diğer Profiller"
          title="Keşfetmeye devam edin"
          description="Portföyümüzdeki diğer B2B kahve profilleri."
        />
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {relatedProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
