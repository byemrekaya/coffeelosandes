---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoffeeLotArticle from '../../components/coffee/CoffeeLotArticle.astro';
import { coffeeLots, getRelatedLots } from '../../data/coffeeLots';

export function getStaticPaths() {
  return coffeeLots.map((lot) => ({
    params: { slug: lot.slug },
    props: { lot },
  }));
}

interface Props {
  lot: (typeof coffeeLots)[number];
}

const { lot } = Astro.props;

const related = getRelatedLots(lot.slug, 3);

const title = `${lot.name} · ${lot.score.toFixed(2)} · Wholesale | Coffee Los Andes`;
const description = `${lot.story.slice(0, 155)}…`;
---

<BaseLayout title={title} description={description}>
  <CoffeeLotArticle lot={lot} relatedLots={related} />
</BaseLayout>
